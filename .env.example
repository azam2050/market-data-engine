# ==========================================
# QQQ Alpha — Environment Configuration
# انسخ هذا الملف إلى .env واملأ القيم
# ==========================================

# --- مزوّد البيانات (Massive / Polygon) ---
# باقة Starter للأسهم + Starter للخيارات تكفي لمرحلة الاختبار التاريخي
MASSIVE_API_KEY=
MASSIVE_REST_URL=https://api.polygon.io
MASSIVE_WS_STOCKS_URL=wss://socket.polygon.io/stocks
MASSIVE_WS_OPTIONS_URL=wss://socket.polygon.io/options
# real_time | delayed  — اضبطها delayed مع باقة Starter
MASSIVE_FEED_MODE=delayed

# --- محرك الذكاء (Anthropic) ---
ANTHROPIC_API_KEY=
# ضع هنا معرّف أحدث موديل Opus من Anthropic (لقرارات الدخول والخروج)
ANTHROPIC_MODEL=
# موديل أخف للمهام الروتينية (تلخيص، مراجعة) — اختياري
ANTHROPIC_FAST_MODEL=

# --- السوق ---
PRIMARY_SYMBOL=QQQ
LEADER_SYMBOLS=AAPL,MSFT,NVDA,AMZN,GOOGL,META,AVGO,TSLA,NFLX,AMD

# --- حدود التشغيل (كلها قابلة للتعديل — ليست جامدة) ---
MAX_TRADES_PER_DAY=2
MAX_OPEN_POSITIONS=1
DAILY_LOSS_CIRCUIT_BREAKER_PCT=25
MIN_TARGET_RETURN_PCT=50
# آخر وقت مسموح بفتح صفقة 0DTE (توقيت نيويورك)
LAST_ENTRY_TIME_ET=15:15
# أقصى عمر مقبول للبيانات قبل اعتبارها قديمة (ثانية)
MAX_DATA_AGE_SEC=120

# --- محرك الانتباه (متى نوقظ الـ AI — ليس فلترة قرارات) ---
ATTENTION_THRESHOLD=0.45
ATTENTION_COOLDOWN_SEC=180

# --- التوصيل (تلقرام) ---
# أنشئ بوتًا عبر @BotFather في تلقرام وخذ التوكن
TELEGRAM_BOT_TOKEN=
# معرّف المحادثة — أرسل رسالة للبوت ثم افتح:
# https://api.telegram.org/bot<TOKEN>/getUpdates وخذ chat.id
TELEGRAM_CHAT_ID=

# --- التخزين ---
DATA_DIR=./var/data
JOURNAL_DIR=./var/journal
PLAYBOOK_PATH=./src/qqq_alpha/brain/playbook.yaml

# --- عام ---
LOG_LEVEL=INFO
