//@version=5
// ============================================================================
//  مرصاد برو — الاستباقي | Mirsad Early
// ----------------------------------------------------------------------------
//  الفكرة بجملة واحدة: الحركة الكبيرة تولد من انضغاط — السعر يهدأ ويضيق
//  مداه بينما طرف (مشترون أو باعة) يجمع بصمت. هذا المؤشر يراقب الانضغاط،
//  يقرأ من يجمع من ضغط التدفق داخله، ويعلّم "يتجهز ▲/▼" قبل الانطلاق —
//  ثم يدخل على أول شمعة إفراج مع الطرف الأقوى. إضافة إلى صائد المصائد:
//  كسر كاذب لقاع/قمة الأمس والإغلاق عكسه = أبكر دخول انعكاسي موجود.
//
//  يشتغل على أي فريم (كل حساباته نسبية لفريم الشارت + فلتر فريم أعلى ×4
//  تلقائي) وعلى أي سوق (أسهم، صناديق، فوركس، عملات رقمية — لو الحجم غير
//  متوفر ينتقل تلقائياً لقراءة جسم الشمعة).
//
//  التنبيهات بنفس صيغ مرصاد: ⏳ استعداد · 🪤 مصيدة · 🎯 دخول · 🔺 هدف · ✅/🔴 خروج
// ============================================================================
indicator("مرصاد برو — الاستباقي", shorttitle="مرصاد برو", overlay=true,
     max_lines_count=100, max_labels_count=150)

// ---------------------------------------------------------------- المدخلات
grpS = "محرك الاستباق"
sqzMin   = input.int(6, "أقل شموع انضغاط قبل الجاهزية", minval=3, maxval=30, group=grpS)
sqzTight = input.float(1.5, "شدة الانضغاط (أصغر = أندر وأقوى)", minval=0.8, maxval=2.5, step=0.1, group=grpS)
relBody  = input.float(0.5, "أقل جسم لشمعة الإفراج (ATR)", minval=0.2, maxval=1.5, step=0.1, group=grpS)
useHTF   = input.bool(true, "فلتر الفريم الأعلى (×4) — لا دخول ضده", group=grpS)
useTraps = input.bool(true, "صائد المصائد (انعكاسات الكسر الكاذب)", group=grpS)
grpM = "إدارة الصفقة"
t1x    = input.float(1.0, "الهدف الأول (ATR)",  minval=0.5, maxval=3.0, step=0.1, group=grpM)
t2x    = input.float(2.0, "الهدف الثاني (ATR)", minval=1.0, maxval=5.0, step=0.1, group=grpM)
t3x    = input.float(3.5, "الهدف الممتد (ATR)", minval=1.5, maxval=8.0, step=0.1, group=grpM)
trailX = input.float(2.0, "الوقف المتحرك (ATR)", minval=1.0, maxval=4.0, step=0.1, group=grpM)
coolN  = input.int(6, "شموع انتظار بعد كل صفقة", minval=0, maxval=100, group=grpM)
grpD = "العرض"
showPrep  = input.bool(true, "علامة يتجهز ▲/▼ (الاستباق البصري)", group=grpD)
keepTrail = input.bool(true, "إبقاء آثار الصفقات الماضية (للمراجعة)", group=grpD)
dashPosS  = input.string("أعلى يمين", "مكان اللوحة", options=["أعلى يمين", "أعلى يسار", "أسفل يمين", "أسفل يسار"], group=grpD)

// ------------------------------------------------------------------ الألوان
cUp   = #26A69A
cDn   = #EF5350
cGold = #E3B34D
cCyan = #38C8E8
cTxt  = #D5D9E4
cMut  = #787B86
cPanl = color.new(#1B2130, 8)
cHead = color.new(#232B3D, 0)

// ----------------------------------------------------------- حسابات أساسية
atr   = ta.atr(14)
rngHL = math.max(high - low, syminfo.mintick)
// تدفق تقديري: يعمل بالحجم إن وُجد، وبجسم الشمعة وحده إن غاب (فوركس مثلاً)
hasVol = not na(volume) and ta.sma(volume, 20) > 0
flow   = hasVol ? volume * (close - open) / rngHL : (close - open) / rngHL

// الانضغاط: بولنجر داخل كيلتنر — التقلب ينكمش والحركة تُشحن
sd2   = 2.0 * ta.stdev(close, 20)
sqzOn = sd2 < sqzTight * atr
var int   sqzBars  = 0
var float sqzFlow  = 0.0
var float sqzHi    = na
var float sqzLo    = na
if sqzOn
    sqzBars  += 1
    sqzFlow  += flow
    sqzHi := na(sqzHi) ? high : math.max(sqzHi, high)
    sqzLo := na(sqzLo) ? low  : math.min(sqzLo, low)
ready    = sqzOn and sqzBars >= sqzMin
readyDir = sqzFlow > 0 ? 1 : sqzFlow < 0 ? -1 : 0

// الفريم الأعلى ×4 — اتجاه عام لا يُدخل ضده
f_h() =>
    eF = ta.ema(close, 9)
    eS = ta.ema(close, 21)
    eF > eS and close > eS ? 1 : eF < eS and close < eS ? -1 : 0
htfSec = timeframe.in_seconds(timeframe.period) * 4
htfMin = math.max(1, int(htfSec / 60))
htfStr = timeframe.isintraday ? (htfMin >= 1440 ? "D" : str.tostring(htfMin)) : timeframe.isdaily ? "W" : "M"
htfDir = request.security(syminfo.tickerid, htfStr, f_h(), lookahead=barmerge.lookahead_off)

// حواف الأمس — للمصايد (تعمل على كل الأسواق)
[pdH, pdL] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_off)
tol = 0.05 * atr
volOk = hasVol ? volume > 1.3 * ta.sma(volume, 20) : math.abs(close - open) > 0.6 * atr
bullTrap = useTraps and not na(pdL) and low < pdL - tol and close > pdL and close > open and volOk
bearTrap = useTraps and not na(pdH) and high > pdH + tol and close < pdH and close < open and volOk

// ------------------------------------------------------------- حالة الصفقة
var bool  inTrade = false
var int   tDir    = 0
var float entryP  = na
var float stopP   = na
var float stop0   = na
var float t1P     = na
var float t2P     = na
var float t3P     = na
var bool  t1Hit   = false
var bool  t2Hit   = false
var bool  t3Hit   = false
var int   entryBar = 0
var int   lastExit = -99999
var line  lnEntry = na
var line  lnStop  = na
var label lbStop  = na

var resArr = array.new_int()
var int   winsAll = 0
var int   lossAll = 0
var float sumR    = 0.0

f_side(d) => d > 0 ? "كول" : "بوت"

// -------------------------------------------------- علامة الاستباق: يتجهز
var int lastPrepBar = -999
if showPrep and barstate.isconfirmed and not inTrade and ready and readyDir != 0 and bar_index - lastPrepBar > 8
    okDir = not useHTF or htfDir == 0 or htfDir == readyDir
    if okDir
        lastPrepBar := bar_index
        label.new(bar_index, readyDir > 0 ? low : high, readyDir > 0 ? "يتجهز ▲" : "يتجهز ▼",
             style=readyDir > 0 ? label.style_label_up : label.style_label_down,
             color=color.new(cCyan, 15), textcolor=#04222B, size=size.small)
        alert("⏳ استعداد | " + syminfo.ticker + " — انضغاط " + str.tostring(sqzBars) +
             " شمعة والتدفق يرجح " + f_side(readyDir) + " قرب " + str.tostring(close, format.mintick), alert.freq_once_per_bar)

// ------------------------------------------------------------------- الدخول
canEnter = barstate.isconfirmed and not inTrade and (bar_index - lastExit) > coolN and bar_index > 50

// إفراج الانضغاط: أول شمعة تكسر الانكماش مع الطرف الذي كان يجمع
release   = not sqzOn and sqzOn[1] and sqzBars >= sqzMin
bodyOk    = math.abs(close - open) >= relBody * atr
relUp     = release and bodyOk and close > open and readyDir >= 0 and close > nz(sqzHi, high)
relDn     = release and bodyOk and close < open and readyDir <= 0 and close < nz(sqzLo, low)

longSig  = canEnter and ((relUp and (not useHTF or htfDir >= 0)) or (bullTrap and (not useHTF or htfDir >= 0)))
shortSig = canEnter and not longSig and ((relDn and (not useHTF or htfDir <= 0)) or (bearTrap and (not useHTF or htfDir <= 0)))
sigDir   = longSig ? 1 : shortSig ? -1 : 0
sigWhy   = longSig ? (bullTrap ? "مصيدة سيولة على قاع الأمس" : "إفراج انضغاط بتجميع شرائي") :
     shortSig ? (bearTrap ? "مصيدة سيولة على قمة الأمس" : "إفراج انضغاط بتصريف بيعي") : ""

if sigDir != 0
    inTrade := true
    entryBar := bar_index
    tDir   := sigDir
    entryP := close
    stopP  := sigDir > 0 ? (bullTrap ? low - 0.25 * atr : math.min(nz(sqzLo, low), low) - 0.25 * atr)
         : (bearTrap ? high + 0.25 * atr : math.max(nz(sqzHi, high), high) + 0.25 * atr)
    stop0  := stopP
    t1P := sigDir > 0 ? entryP + t1x * atr : entryP - t1x * atr
    t2P := sigDir > 0 ? entryP + t2x * atr : entryP - t2x * atr
    t3P := sigDir > 0 ? entryP + t3x * atr : entryP - t3x * atr
    t1Hit := false
    t2Hit := false
    t3Hit := false
    lnEntry := line.new(bar_index, entryP, bar_index + 1, entryP, extend=extend.right, color=color.new(cTxt, 35), style=line.style_dotted, width=1)
    lnStop  := line.new(bar_index, stopP, bar_index + 1, stopP, extend=extend.right, color=#FF9E45, width=2)
    lbStop  := label.new(bar_index + 3, stopP, "الوقف · " + str.tostring(stopP, format.mintick), style=label.style_label_left, textcolor=#1A0E02, color=#FF9E45, size=size.small)
    label.new(bar_index, sigDir > 0 ? low : high, "🎯 " + f_side(sigDir) + " " + str.tostring(entryP, format.mintick),
         style=sigDir > 0 ? label.style_label_up : label.style_label_down,
         color=sigDir > 0 ? cUp : cDn, textcolor=sigDir > 0 ? #04211D : #2B0606, size=size.normal)
    alert("🎯 دخول " + f_side(sigDir) + " | " + syminfo.ticker + " فريم " + timeframe.period +
         " | سعر " + str.tostring(entryP, format.mintick) + " | وقف " + str.tostring(stopP, format.mintick) +
         " | السبب: " + sigWhy, alert.freq_once_per_bar)

// ------------------------------------------------------------ إدارة الصفقة
if inTrade and barstate.isconfirmed and bar_index > entryBar
    if not t1Hit and (tDir > 0 ? high >= t1P : low <= t1P)
        t1Hit := true
        stopP := entryP
        alert("🔺 هدف 1 تحقق والصفقة مؤمّنة (الوقف = الدخول) | " + syminfo.ticker, alert.freq_once_per_bar)
    if t1Hit and not t2Hit and (tDir > 0 ? high >= t2P : low <= t2P)
        t2Hit := true
        stopP := t1P
        alert("🔺 هدف 2 تحقق — الوقف صعد إلى هدف 1 | " + syminfo.ticker, alert.freq_once_per_bar)
    if t2Hit and not t3Hit and (tDir > 0 ? high >= t3P : low <= t3P)
        t3Hit := true
        alert("🔺 الهدف الممتد تحقق | " + syminfo.ticker, alert.freq_once_per_bar)
    if t1Hit
        chand = tDir > 0 ? close - trailX * atr : close + trailX * atr
        stopP := tDir > 0 ? math.max(stopP, chand) : math.min(stopP, chand)
    line.set_y1(lnStop, stopP)
    line.set_y2(lnStop, stopP)
    label.set_y(lbStop, stopP)
    label.set_x(lbStop, bar_index + 3)
    label.set_text(lbStop, (stopP == entryP ? "مؤمّنة ✓ · " : "الوقف · ") + str.tostring(stopP, format.mintick))
    if tDir > 0 ? close < stopP : close > stopP
        risk  = math.abs(entryP - stop0)
        rMult = risk > 0 ? (tDir > 0 ? close - entryP : entryP - close) / risk : 0.0
        win   = t1Hit
        array.unshift(resArr, win ? 1 : 0)
        if array.size(resArr) > 20
            array.pop(resArr)
        winsAll += win ? 1 : 0
        lossAll += win ? 0 : 1
        sumR    += rMult
        if keepTrail
            line.set_extend(lnEntry, extend.none)
            line.set_x2(lnEntry, bar_index)
            line.new(entryBar, entryP, bar_index, close, color=win ? color.new(cUp, 35) : color.new(cDn, 30), width=2)
        else
            line.delete(lnEntry)
        line.delete(lnStop)
        label.delete(lbStop)
        label.new(bar_index, tDir > 0 ? low : high,
             win ? "✅ +" + str.tostring(rMult, "#.#") + "R" : "🔴 خروج",
             style=tDir > 0 ? label.style_label_up : label.style_label_down,
             color=win ? color.new(cUp, 20) : color.new(cDn, 10),
             textcolor=win ? #04211D : #2B0606, size=size.normal)
        alert((win ? "✅" : "🔴") + " خروج — كسر الوقف المتحرك | " + syminfo.ticker +
             " | النتيجة " + (win ? "+" : "") + str.tostring(rMult, "#.#") + "R", alert.freq_once_per_bar)
        inTrade := false
        lastExit := bar_index

// تصفير ذاكرة الانضغاط بعد أن استُخدمت في قرار الدخول والوقف
if release or (not sqzOn and not sqzOn[1] and sqzBars > 0)
    sqzBars := 0
    sqzFlow := 0.0
    sqzHi := na
    sqzLo := na

if barstate.isconfirmed and bullTrap and not inTrade
    label.new(bar_index, low, "🪤", style=label.style_label_up, color=cGold, textcolor=#161309, size=size.small)
    alert("🪤 مصيدة سيولة تحت الأرضية | " + syminfo.ticker + " — كسر كاذب وإغلاق فوق المستوى", alert.freq_once_per_bar)
if barstate.isconfirmed and bearTrap and not inTrade
    label.new(bar_index, high, "🪤", style=label.style_label_down, color=cGold, textcolor=#161309, size=size.small)
    alert("🪤 مصيدة سيولة فوق السقف | " + syminfo.ticker + " — اختراق كاذب وإغلاق تحت المستوى", alert.freq_once_per_bar)

// ------------------------------------------------------------------ اللوحة
f_pos(s) => s == "أعلى يمين" ? position.top_right : s == "أعلى يسار" ? position.top_left :
     s == "أسفل يمين" ? position.bottom_right : position.bottom_left
var table dash = table.new(f_pos(dashPosS), 2, 5, bgcolor=cPanl, border_width=1, border_color=color.new(#2A3245, 0))
if barstate.islast
    tot = winsAll + lossAll
    wr  = tot > 0 ? 100.0 * winsAll / tot : 0.0
    avR = tot > 0 ? sumR / tot : 0.0
    stTxt = inTrade ? "🎯 صفقة " + f_side(tDir) + " نشطة" : ready and readyDir != 0 ? (readyDir > 0 ? "🔵 يتجهز — الترجيح كول" : "🔵 يتجهز — الترجيح بوت") : sqzOn ? "انضغاط يتكوّن (" + str.tostring(sqzBars) + ")" : "مراقبة"
    stCol = inTrade ? (tDir > 0 ? cUp : cDn) : ready ? cCyan : cMut
    table.cell(dash, 0, 0, "مرصاد برو — الاستباقي", text_color=cTxt, bgcolor=cHead, text_size=size.small)
    table.cell(dash, 1, 0, syminfo.ticker, text_color=cTxt, bgcolor=cHead, text_size=size.small)
    table.cell(dash, 0, 1, "الحالة", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 1, stTxt, text_color=stCol, bgcolor=color.new(stCol, 85), text_size=size.small)
    table.cell(dash, 0, 2, "الفريم الأعلى (×4)", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 2, htfDir > 0 ? "صاعد" : htfDir < 0 ? "هابط" : "محايد", text_color=htfDir > 0 ? cUp : htfDir < 0 ? cDn : cMut, text_size=size.small)
    table.cell(dash, 0, 3, "تدفق الانضغاط", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 3, sqzOn ? (sqzFlow > 0 ? "تجميع شرائي" : sqzFlow < 0 ? "تصريف بيعي" : "متعادل") : "—", text_color=sqzFlow > 0 ? cUp : sqzFlow < 0 ? cDn : cMut, text_size=size.small)
    table.cell(dash, 0, 4, "السجل", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 4, tot > 0 ? str.tostring(tot) + " صفقة · نجاح " + str.tostring(wr, "#") + "% · متوسط " + (avR >= 0 ? "+" : "") + str.tostring(avR, "#.##") + "R" : "لا صفقات بعد", text_color=cMut, text_size=size.small)
