//@version=5
// ============================================================================
//  مرصاد VIP — نسخة الاختبار (استراتيجية)
// ----------------------------------------------------------------------------
//  هذا ليس مؤشراً للتداول، بل توأم المحرك نفسه مكتوباً كاستراتيجية، لغرض
//  واحد: أن يفتح لك TradingView تقرير الاختبار الكامل على سنة كاملة —
//  منحنى رأس المال، أقصى تراجع، عامل الربح، متوسط الصفقة، وكل صفقة بتاريخها.
//
//  القواعد هنا مطابقة للمؤشر حرفاً بحرف: نفس الشرارة، نفس الأمر المعلق،
//  نفس شخصية الفريم، نفس الوقف والأهداف، نفس مهلة الموت، نفس قاطع اليوم.
//  فإن اختلف رقمٌ هنا عن اللوحة فالسبب اختلاف نافذة الحساب لا اختلاف منطق.
//
//  العمولة هنا تمثل فرق سعر العقد ذهاباً وإياباً، وهي مضبوطة في الإعدادات
//  كنسبة من قيمة الصفقة — لأن اختباراً بلا تكلفة تنفيذ ليس اختباراً.
// ============================================================================
strategy("مرصاد VIP — اختبار", shorttitle="مرصاد اختبار", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     initial_capital=10000, commission_type=strategy.commission.percent,
     commission_value=0.03, slippage=1, calc_on_every_tick=false,
     process_orders_on_close=true, max_labels_count=100)

// ============================ المدخلات ======================================
gP = "شخصية الفريم"
profSel = input.string("تلقائي", "الشخصية", options=["تلقائي", "حارق", "سريع", "نصف يوم", "يوم", "أسبوع"], group=gP)

gQ = "عقل الجودة"
aggro   = input.string("متوازن", "حدة الدخول", options=["هادئ", "متوازن", "نشط"], group=gQ)
minQ    = input.int(60, "أدنى سكور جودة", minval=0, maxval=100, group=gQ)
h1Veto  = input.bool(true, "لا دخول ضد اتجاه الساعة", group=gQ)
volX    = input.float(1.2, "مضاعف الحجم المؤسسي", minval=1.0, maxval=3.0, step=0.1, group=gQ)
adxMin  = input.int(18, "أدنى قوة اتجاه ADX", minval=10, maxval=40, group=gQ)
qualityMode = input.bool(true, "امنع الدخول في سوق ميت", group=gQ)
maxLossDay  = input.int(3, "أوقف اليوم بعد خسائر متتالية", minval=0, maxval=10, group=gQ)

gE = "طريقة الدخول"
useBracket = input.bool(true, "أضف أمر اختراق عند الاندفاع القوي فقط", group=gE)
impMin     = input.float(3.4, "عتبة الاندفاع", minval=2.5, maxval=5.0, step=0.1, group=gE)
retrX      = input.float(0.5, "عمق الارتداد", minval=0.1, maxval=0.9, step=0.05, group=gE)
brkX       = input.float(0.10, "مسافة الاختراق (ATR)", minval=0.02, maxval=0.5, step=0.02, group=gE)
pExpire    = input.int(3, "صلاحية الأمرين (شموع)", minval=1, maxval=12, group=gE)
minRiskX   = input.float(0.5, "أدنى مسافة وقف (ATR)", minval=0.2, maxval=2.0, step=0.1, group=gE)

gO = "العقود اليومية"
dteCut   = input.int(90, "امنع عقد اليوم قبل الإغلاق بـ (دقيقة)", minval=0, maxval=240, group=gO)
flat0dte = input.bool(true, "أغلق صفقات عقد اليوم قبل الجرس", group=gO)

gT = "نافذة الاختبار"
useWin  = input.bool(true, "احصر الاختبار في مدة", group=gT)
winFrom = input.time(timestamp("01 Sep 2025 00:00 +0000"), "من", group=gT)
winTo   = input.time(timestamp("01 Jan 2100 00:00 +0000"), "إلى", group=gT)
inWin = not useWin or (time >= winFrom and time <= winTo)

// ==================== شخصية الفريم ==========================================
tfMin = timeframe.in_seconds(timeframe.period) / 60.0
autoProf = not timeframe.isintraday ? "أسبوع" : tfMin <= 1 ? "حارق" : tfMin <= 5 ? "سريع" :
     tfMin <= 30 ? "نصف يوم" : tfMin <= 60 ? "يوم" : "أسبوع"
prof = profSel == "تلقائي" ? autoProf : profSel
tp1x = prof == "حارق" ? 0.5 : prof == "سريع" ? 0.8 : prof == "نصف يوم" ? 1.2 : prof == "يوم" ? 1.8 : 2.5
tp2x = prof == "حارق" ? 0.9 : prof == "سريع" ? 1.5 : prof == "نصف يوم" ? 2.0 : prof == "يوم" ? 3.0 : 4.0
tp3x = prof == "حارق" ? 1.4 : prof == "سريع" ? 2.5 : prof == "نصف يوم" ? 3.2 : prof == "يوم" ? 4.5 : 6.0
tp4x = prof == "حارق" ? 2.0 : prof == "سريع" ? 3.5 : prof == "نصف يوم" ? 4.5 : prof == "يوم" ? 6.0 : 8.0
stopX  = prof == "حارق" ? 0.5 : prof == "سريع" ? 0.7 : prof == "نصف يوم" ? 1.0 : prof == "يوم" ? 1.3 : 1.8
// عشرون صفقة تحمل سبعة وستين بالمئة من الربح: هذا نظام يعيش على ذيله لا
// على متوسطه. فالمسافة هنا ليست حماية للربح، بل مساحة تسمح للموجة النادرة
// أن تكتمل — وثمنها أن نردّ جزءاً من كل رابحة عادية.
trailX = prof == "حارق" ? 1.5 : prof == "سريع" ? 2.5 : prof == "نصف يوم" ? 3.2 : prof == "يوم" ? 4.0 : 5.0
// الرابح لا يُقفل بعدد أهداف بل بالوقف المتحرك. الحارق وحده يخرج مبكراً
// لأن عقده يموت خلال ساعات.
maxT  = prof == "حارق" ? 2 : 4
coolN = prof == "حارق" ? 3 : prof == "سريع" ? 6 : prof == "نصف يوم" ? 6 : 8
// جُرّب تقصير هذه المهلة فقصّت الخاسرة بثُمنها والرابحة بربعها، فرُدّت.
// الصفقة الراكدة تكلّف، لكن قتل الرابحة الناشئة يكلّف أكثر.
timeStop = prof == "حارق" ? 6 : prof == "سريع" ? 10 : prof == "نصف يوم" ? 12 : prof == "يوم" ? 14 : 20

// ============================ الحسابات ======================================
atr   = ta.atr(14)
rngHL = math.max(high - low, syminfo.mintick)
body  = math.abs(close - open)
hasVol = not na(volume) and ta.sma(volume, 20) > 0
volMA  = hasVol ? ta.sma(volume, 20) : na
volSpike = hasVol ? volume > volX * volMA : body > 0.7 * atr
absorption = hasVol and volume > 1.5 * volMA and body < 0.5 * atr
rsi = ta.rsi(close, 14)
[diP, diM, adx] = ta.dmi(14, 14)
cloudFast = ta.hma(close, 21)
cloudSlow = ta.ema(close, 55)
ema9 = ta.ema(close, 9)
inCloud  = close <= math.max(cloudFast, cloudSlow) and close >= math.min(cloudFast, cloudSlow)
cloudDir = cloudFast > cloudSlow ? 1 : -1

pv3H = ta.pivothigh(high, 3, 3)
pv3L = ta.pivotlow(low, 3, 3)
var float sw3H = na
var float sw3L = na
if not na(pv3H)
    sw3H := pv3H
if not na(pv3L)
    sw3L := pv3L
pv10H = ta.pivothigh(high, 10, 10)
pv10L = ta.pivotlow(low, 10, 10)
var float majH = na
var float majL = na
var int   majHB = na
var int   majLB = na
if not na(pv10H)
    majH := pv10H
    majHB := bar_index - 10
if not na(pv10L)
    majL := pv10L
    majLB := bar_index - 10
var int structDir = 0
bosUp = not na(sw3H) and close > sw3H and close[1] <= sw3H
bosDn = not na(sw3L) and close < sw3L and close[1] >= sw3L
chochUp = bosUp and structDir == -1
chochDn = bosDn and structDir == 1
if bosUp
    structDir := 1
if bosDn
    structDir := -1

[pdH, pdL] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_off)
impUp = not na(majH) and not na(majL) and majHB > majLB and majH > majL
impDn = not na(majH) and not na(majL) and majLB > majHB and majH > majL
fzTop = impUp ? majH - (majH - majL) * 0.618 : impDn ? majL + (majH - majL) * 0.786 : na
fzBot = impUp ? majH - (majH - majL) * 0.786 : impDn ? majL + (majH - majL) * 0.618 : na
inFib = not na(fzTop) and close <= math.max(fzTop, fzBot) and close >= math.min(fzTop, fzBot)
nearSup = (not na(majL) and math.abs(close - majL) < 1.0 * atr) or (not na(pdL) and math.abs(close - pdL) < 1.0 * atr)
nearRes = (not na(majH) and math.abs(close - majH) < 1.0 * atr) or (not na(pdH) and math.abs(close - pdH) < 1.0 * atr)
atZoneUp = (inFib and impUp) or nearSup
atZoneDn = (inFib and impDn) or nearRes

tight = rngHL < 0.7 * atr
heavy = hasVol and volume > 1.3 * volMA
accBar = tight and heavy
var int   accRun = 0
var float accHi = na
var float accLo = na
var float zoneHi = na
var float zoneLo = na
var int   zoneDir = 0
var int   zoneBar = -999
accRun := accBar ? accRun + 1 : 0
if accBar
    if accRun == 1
        accHi := high
        accLo := low
    else
        accHi := math.max(accHi, high)
        accLo := math.min(accLo, low)
if accRun > 5
    zoneHi := accHi
    zoneLo := accLo
zoneUp = not na(zoneHi) and close > zoneHi and close[1] <= zoneHi and volSpike
zoneDn = not na(zoneLo) and close < zoneLo and close[1] >= zoneLo and volSpike
if zoneUp or zoneDn
    zoneDir := zoneUp ? 1 : -1
    zoneBar := bar_index
    zoneHi := na
    zoneLo := na
if bar_index - zoneBar > 10
    zoneDir := 0

tol = 0.05 * atr
supLvl = not na(majL) and not na(pdL) ? math.max(majL, pdL) : not na(majL) ? majL : pdL
resLvl = not na(majH) and not na(pdH) ? math.min(majH, pdH) : not na(majH) ? majH : pdH
spring   = not na(supLvl) and low < supLvl - tol and close > supLvl and close > open and (volSpike or absorption)
upthrust = not na(resLvl) and high > resLvl + tol and close < resLvl and close < open and (volSpike or absorption)
sweepUp  = not na(sw3L) and low < sw3L - tol and close > sw3L and close > open
sweepDn  = not na(sw3H) and high > sw3H + tol and close < sw3H and close < open

upWick = high - math.max(close, open)
dnWick = math.min(close, open) - low
bullPin = dnWick > 2.0 * body and upWick < body and close >= open
bearPin = upWick > 2.0 * body and dnWick < body and close <= open
bullEng = close > open and close[1] < open[1] and close >= open[1] and open <= close[1] and body > 0.4 * atr
bearEng = close < open and close[1] > open[1] and close <= open[1] and open >= close[1] and body > 0.4 * atr
thrustUp = close > open and close[1] > open[1] and close[2] > open[2] and body > body[1] and body[1] > body[2]
thrustDn = close < open and close[1] < open[1] and close[2] < open[2] and body > body[1] and body[1] > body[2]
insUp = high[1] <= high[2] and low[1] >= low[2] and close > high[1]
insDn = high[1] <= high[2] and low[1] >= low[2] and close < low[1]
paUp = bullPin or bullEng or thrustUp or insUp
paDn = bearPin or bearEng or thrustDn or insDn

divBull = not na(pv3L) and rsi < 45 and rsi > rsi[3]
divBear = not na(pv3H) and rsi > 55 and rsi < rsi[3]
momUp = (rsi > 50 and rsi > rsi[1]) or divBull or rsi < 32
momDn = (rsi < 50 and rsi < rsi[1]) or divBear or rsi > 68

f_dir() =>
    eF = ta.ema(close, 9)
    eS = ta.ema(close, 21)
    eF > eS and close > eS ? 1 : eF < eS and close < eS ? -1 : 0
d05 = request.security(syminfo.tickerid, "5",  f_dir(), lookahead=barmerge.lookahead_off)
d15 = request.security(syminfo.tickerid, "15", f_dir(), lookahead=barmerge.lookahead_off)
d60 = request.security(syminfo.tickerid, "60", f_dir(), lookahead=barmerge.lookahead_off)
biasSum = (d05 > 0 ? 1 : d05 < 0 ? -1 : 0) + (d15 > 0 ? 1 : d15 < 0 ? -1 : 0) +
     (d60 > 0 ? 1 : d60 < 0 ? -1 : 0) + cloudDir
bias = biasSum >= 2 ? 1 : biasSum <= -2 ? -1 : 0

pbUp = math.max(cloudFast, ema9)
pbDn = math.min(cloudFast, ema9)
var bool armUp = false
var bool armDn = false
if bias > 0 and low <= pbUp + 0.20 * atr
    armUp := true
    armDn := false
if bias < 0 and high >= pbDn - 0.20 * atr
    armDn := true
    armUp := false
if bias <= 0
    armUp := false
if bias >= 0
    armDn := false
contUp = armUp and close > open and close > high[1] and close > cloudFast and body > 0.25 * atr
contDn = armDn and close < open and close < low[1] and close < cloudFast and body > 0.25 * atr
if contUp
    armUp := false
if contDn
    armDn := false

f_q(sideUp) =>
    q = 0
    q := q + ((sideUp ? bias > 0 : bias < 0) ? 20 : 0)
    q := q + ((volSpike or absorption) ? 20 : 0)
    q := q + ((sideUp ? (paUp or contUp or spring or sweepUp) : (paDn or contDn or upthrust or sweepDn)) ? 20 : 0)
    q := q + ((sideUp ? (atZoneUp or cloudDir > 0) : (atZoneDn or cloudDir < 0)) ? 20 : 0)
    q := q + ((sideUp ? momUp : momDn) ? 20 : 0)
    q := q + ((sideUp ? zoneDir > 0 : zoneDir < 0) ? 10 : 0)
    math.min(100, q)
qUp = f_q(true)
qDn = f_q(false)

isFund = syminfo.ticker == "QQQ" or syminfo.ticker == "SPY" or syminfo.ticker == "SPX" or syminfo.ticker == "IWM"
sessEnd = timeframe.isintraday ? time_close("D") : na
minsLeft = na(sessEnd) ? na : (sessEnd - time) / 60000.0
lateSession = not na(minsLeft) and minsLeft <= dteCut
atBell = timeframe.isintraday and session.islastbar_regular

impulse = (body / math.max(atr, syminfo.mintick)) +
     (hasVol ? math.min(2.0, volume / math.max(volMA, 1)) : 1.0) +
     (adx >= 25 and adx > adx[1] ? 1.0 : 0.0)
strongImp = impulse >= impMin

// ============================ الحالة ========================================
var int   pDir = 0
var float pLimit = na
var float pBreak = na
var float pStop = na
var int   pBar = 0
var int   lastExit = -99999
var int   lossRunDay = 0
var bool  was0dte = false
var float entryP = na
var float stop0 = na
var float stopP = na
var float tp1 = na
var float tp2 = na
var float tp3 = na
var float tp4 = na
var int   hits = 0
var int   entryBar = 0
var int   tDir = 0
if ta.change(time("D")) != 0
    lossRunDay := 0

trigUp = contUp or spring or sweepUp or chochUp or zoneUp or (bosUp and (volSpike or bias > 0))
trigDn = contDn or upthrust or sweepDn or chochDn or zoneDn or (bosDn and (volSpike or bias < 0))
minQeff = math.max(0, math.min(100, minQ + (aggro == "هادئ" ? 20 : aggro == "نشط" ? -20 : 0)))
coolEff = aggro == "هادئ" ? coolN * 2 : aggro == "نشط" ? math.max(1, coolN / 2) : coolN
qGateUp = not qualityMode or contUp or atZoneUp or (adx >= adxMin and cloudDir >= 0)
qGateDn = not qualityMode or contDn or atZoneDn or (adx >= adxMin and cloudDir <= 0)
flat = strategy.position_size == 0
dayOpen = maxLossDay == 0 or lossRunDay < maxLossDay
canEnter = barstate.isconfirmed and inWin and flat and pDir == 0 and dayOpen and (bar_index - lastExit) > coolEff and bar_index > 60
longSig  = canEnter and trigUp and qUp >= minQeff and qGateUp and (not h1Veto or d60 >= 0)
shortSig = canEnter and not longSig and trigDn and qDn >= minQeff and qGateDn and (not h1Veto or d60 <= 0)
sigDir = longSig ? 1 : shortSig ? -1 : 0

if sigDir != 0
    pDir := sigDir
    pBar := bar_index
    dLim = strongImp ? retrX * 0.6 : retrX
    dBrk = strongImp ? brkX * 0.6 : brkX
    pLimit := sigDir > 0 ? high - dLim * rngHL : low + dLim * rngHL
    pBreak := strongImp and useBracket ? (sigDir > 0 ? high + dBrk * atr : low - dBrk * atr) : na
    base = sigDir > 0 ? math.min(low, pLimit) : math.max(high, pLimit)
    pStop := sigDir > 0 ? base - stopX * atr : base + stopX * atr

// ============================ التنفيذ =======================================
fillNow = false
float fillP = na
int   fDir = 0
if pDir != 0 and flat and barstate.isconfirmed and bar_index > pBar
    hitLim = pDir > 0 ? low <= pLimit : high >= pLimit
    hitBrk = not na(pBreak) and (pDir > 0 ? high >= pBreak : low <= pBreak)
    if hitLim or hitBrk
        fillNow := true
        fillP := hitBrk ? pBreak : (pDir > 0 ? math.min(open, pLimit) : math.max(open, pLimit))
        fDir := pDir
    else if bar_index - pBar >= pExpire or (pDir > 0 ? close < pStop : close > pStop)
        pDir := 0

if fillNow
    tDir := fDir
    entryP := fillP
    entryBar := bar_index
    stopP := fDir > 0 ? math.min(pStop, entryP - minRiskX * atr) : math.max(pStop, entryP + minRiskX * atr)
    stop0 := stopP
    tp1 := fDir > 0 ? entryP + tp1x * atr : entryP - tp1x * atr
    tp2 := fDir > 0 ? entryP + tp2x * atr : entryP - tp2x * atr
    tp3 := fDir > 0 ? entryP + tp3x * atr : entryP - tp3x * atr
    tp4 := fDir > 0 ? entryP + tp4x * atr : entryP - tp4x * atr
    hits := 0
    was0dte := isFund and not lateSession
    pDir := 0
    if fDir > 0
        strategy.entry("كول", strategy.long)
    else
        strategy.entry("بوت", strategy.short)

// ============================ الإدارة =======================================
if strategy.position_size != 0 and barstate.isconfirmed and bar_index > entryBar
    if hits < 1 and (tDir > 0 ? high >= tp1 : low <= tp1)
        hits := 1
    if hits < 2 and (tDir > 0 ? high >= tp2 : low <= tp2)
        hits := 2
    if hits < 3 and (tDir > 0 ? high >= tp3 : low <= tp3)
        hits := 3
    if hits < 4 and (tDir > 0 ? high >= tp4 : low <= tp4)
        hits := 4
    if hits >= 1
        be = tDir > 0 ? entryP + 0.15 * math.abs(entryP - stop0) : entryP - 0.15 * math.abs(entryP - stop0)
        stopP := tDir > 0 ? math.max(stopP, be) : math.min(stopP, be)
    if hits >= 2
        chand = tDir > 0 ? close - trailX * atr : close + trailX * atr
        stopP := tDir > 0 ? math.max(stopP, chand) : math.min(stopP, chand)

mustFlat = strategy.position_size != 0 and atBell and flat0dte and was0dte
if strategy.position_size != 0 and barstate.isconfirmed
    hardStop = hits < 1 and (tDir > 0 ? low <= stop0 : high >= stop0)
    softStop = hits >= 1 and (tDir > 0 ? close < stopP : close > stopP)
    doneT    = hits >= maxT
    deadTime = hits < 1 and (bar_index - entryBar) >= timeStop
    if hardStop or softStop or doneT or mustFlat or deadTime
        strategy.close_all(comment = hardStop ? "وقف" : doneT ? "هدف" : deadTime ? "مهلة" : mustFlat ? "جرس" : "متحرك")
        lastExit := bar_index
        won = tDir > 0 ? close > entryP : close < entryP
        lossRunDay := won ? 0 : lossRunDay + 1

// خطوط الصفقة القائمة، لتقرأ الاختبار بعينك لا بالأرقام وحدها
plot(strategy.position_size != 0 ? entryP : na, "الدخول", color=color.new(#D5D9E4, 40), style=plot.style_linebr)
plot(strategy.position_size != 0 ? stopP : na, "الوقف", color=color.new(#FF9E45, 20), style=plot.style_linebr)
plot(strategy.position_size != 0 ? tp1 : na, "هدف 1", color=color.new(#26A69A, 45), style=plot.style_linebr)
