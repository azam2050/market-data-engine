//@version=5
// ============================================================================
//  مرصاد | Mirsad — النسخة 1.9 (لوحة العقد + سطر الإجراء)
// ----------------------------------------------------------------------------
//  الفلسفة: شارت نظيف. على الشارت فقط: خط الدخول، الوقف المتحرك، الأهداف
//  (تضيء عند التحقق وتختفي بانتهاء الصفقة)، وعلامات المصيدة/الاستعداد.
//  كل شيء آخر يعيش في لوحتين: لوحة القيادة ولوحة الصدق.
//
//  لا إعادة رسم: كل الإشارات تصدر على إغلاق الشمعة فقط، وقراءات الفريمات
//  الأعلى بدون lookahead. "الإشارة الحالية" في اللوحة تعني إشارة تتكوّن على
//  شمعة لم تُغلق بعد — وتُعلَّم بـ ⌛ لتمييزها بصدق عن المؤكدة ✅.
//
//  تفعيل التنبيهات (مرة واحدة): زر التنبيه ⏰ في TradingView → Condition:
//  هذا المؤشر → "Any alert() function call" → حفظ. تصلك الحالات الخمس كلها:
//  ⏳ استعداد · 🪤 مصيدة · 🎯 دخول · 🔺 هدف · 🔴/✅ خروج
// ============================================================================
indicator("مرصاد | Mirsad", shorttitle="مرصاد", overlay=true,
     max_lines_count=100, max_labels_count=150, max_boxes_count=50)

// ---------------------------------------------------------------- المدخلات
grpTF = "فريمات العميل (٣ يختارها)"
tfMode = input.string("تلقائي حسب فريم الشارت", "وضع الفريمات",
     options=["تلقائي حسب فريم الشارت", "يدوي (الثلاثة أدناه)"], group=grpTF)
tf1 = input.timeframe("5",  "الفريم الأول (يدوي)",  group=grpTF)
tf2 = input.timeframe("15", "الفريم الثاني (يدوي)", group=grpTF)
tf3 = input.timeframe("60", "الفريم الثالث (يدوي)", group=grpTF)

// السلم التلقائي: فريم الشارت + درجتان فوقه
// السلم العلمي: الفريم الثاني = ضعف فريم الشارت، والثالث = أربعة أضعافه
// مثال: شارت ١٥ د → ١٥ / ٣٠ / ساعة — شارت ساعة → ساعة / ساعتان / ٤ س
f_autoTf() =>
    sec = timeframe.in_seconds(timeframe.period)
    string a2 = "W"
    string a3 = "M"
    if timeframe.isintraday
        m  = math.max(1, int(sec / 60))
        m2 = m * 2
        m3 = m * 4
        a2 := m2 >= 1440 ? "D" : str.tostring(m2)
        a3 := m3 >= 1440 ? (m2 >= 1440 ? "W" : "D") : str.tostring(m3)
    else
        a2 := timeframe.isdaily ? "W" : timeframe.isweekly ? "M" : "3M"
        a3 := timeframe.isdaily ? "M" : timeframe.isweekly ? "3M" : "12M"
    [timeframe.period, a2, a3]
[aT1, aT2, aT3] = f_autoTf()
useTf1 = tfMode == "يدوي (الثلاثة أدناه)" ? tf1 : aT1
useTf2 = tfMode == "يدوي (الثلاثة أدناه)" ? tf2 : aT2
useTf3 = tfMode == "يدوي (الثلاثة أدناه)" ? tf3 : aT3

grpSig = "الإشارة"
qMode = input.bool(true, "⭐ وضع الجودة السريع — 3/3 + قبل ٢ ظهراً + أهداف قريبة (مُثبت على ١٢ شهراً)", group=grpSig)
minScore  = input.int(65, "أدنى قوة للدخول (من 100)", minval=50, maxval=90,  group=grpSig)
needAlign = input.int(2,  "أقل عدد فريمات متوافقة",   minval=1,  maxval=3,   group=grpSig)
coolBars  = input.int(10, "شموع انتظار بعد كل صفقة",  minval=0,  maxval=200, group=grpSig)
trapVolX  = input.float(1.5, "مضاعف حجم المصيدة", minval=1.0, step=0.1, group=grpSig)
entryModeS = input.string("انتظار ارتداد — أدق سعراً", "وضع الدخول",
     options=["فوري عند إغلاق الشمعة", "انتظار ارتداد — أدق سعراً"], group=grpSig)
maxCndAtr = input.float(1.8, "أقصى حجم لشمعة الإشارة (ATR)", minval=1.0, maxval=3.0, step=0.1, group=grpSig)
waitBars  = input.int(5, "شموع انتظار الارتداد", minval=2, maxval=15, group=grpSig)
trailAtr  = input.float(2.5, "مسافة الوقف المتحرك (ATR)", minval=1.5, maxval=4.0, step=0.1, group=grpSig)
retraceMode = entryModeS != "فوري عند إغلاق الشمعة"
// وصفة الجودة السريعة (من تشريح ١٥٠ صفقة عبر ١٢ شهراً): توافق كامل 3/3،
// لا دخول بعد ٢ ظهراً بتوقيت السوق، بدون ارتداد الأرضية، وأهداف سكالب قريبة
needAlignEff = qMode ? 3 : needAlign
t1x = qMode ? 0.9 : 1.5
t2x = qMode ? 1.6 : 2.6
t3x = qMode ? 2.8 : 4.2
trailEff = qMode ? 1.8 : trailAtr

grpDisp = "العرض"
dashPosS = input.string("أعلى يمين", "مكان لوحة القيادة",
     options=["أعلى يمين", "أعلى يسار", "أسفل يمين", "أسفل يسار"], group=grpDisp)
showDash = input.bool(true, "لوحة القيادة",              group=grpDisp)
showHon  = input.bool(true, "لوحة الصدق (آخر الإشارات)",  group=grpDisp)
showPrep = input.bool(true, "علامة الاستعداد ⏳",         group=grpDisp)
showLvls = input.bool(true, "خطوط الحواف (خفيفة)", group=grpDisp)
sigSizeS = input.string("عادي", "حجم علامات الإشارة", options=["صغير", "عادي", "كبير"], group=grpDisp)
szMark = sigSizeS == "كبير" ? size.normal : sigSizeS == "صغير" ? size.tiny : size.small
szSig  = sigSizeS == "كبير" ? size.large  : sigSizeS == "صغير" ? size.small : size.normal

grpEnd = "نهاية الجلسة (حماية عقود اليوم)"
endGuard = input.bool(true, "تفعيل حارس نهاية الجلسة", group=grpEnd)
hardMin  = input.int(30,  "نافذة آخر الجلسة (دقيقة)", minval=5,  maxval=120, group=grpEnd)
endModeS = input.string("إشارات لعقد الغد 🌙", "وضع آخر الجلسة",
     options=["إشارات لعقد الغد 🌙", "منع الإشارات تماماً"], group=grpEnd)
warnMin  = input.int(120, "وسم ⚡ سكالب سريع آخر (دقيقة)", minval=30, maxval=240, group=grpEnd)
grpWL = "لوحة المراقبة (أسهم يختارها العميل)"
showWatch = input.bool(true, "إظهار لوحة المراقبة", group=grpWL)
watchPosS = input.string("أعلى يسار", "مكانها", options=["أعلى يمين", "أعلى يسار", "أسفل يمين", "أسفل يسار"], group=grpWL)
wl1 = input.symbol("NASDAQ:QQQ",  "السهم ١", group=grpWL)
wl2 = input.symbol("NASDAQ:TSLA", "السهم ٢", group=grpWL)
wl3 = input.symbol("NASDAQ:NVDA", "السهم ٣", group=grpWL)
wl4 = input.symbol("NASDAQ:AAPL", "السهم ٤", group=grpWL)
wl5 = input.symbol("NASDAQ:MSFT", "السهم ٥", group=grpWL)
wl6 = input.symbol("NASDAQ:MU",   "السهم ٦", group=grpWL)
wl7 = input.symbol("NASDAQ:GOOG", "السهم ٧", group=grpWL)
wl8 = input.symbol("NASDAQ:AMZN", "السهم ٨", group=grpWL)
wl9 = input.symbol("NASDAQ:META", "السهم ٩", group=grpWL)
wl10 = input.symbol("NASDAQ:AVGO", "السهم ١٠", group=grpWL)
wlN = input.int(10, "عدد الأسهم المعروضة", minval=1, maxval=10, group=grpWL)

grpOpt = "لوحة العقد (جديد 1.9)"
showOpt = input.bool(true, "إظهار لوحة العقد", group=grpOpt)
optPosS = input.string("أسفل يمين", "مكانها", options=["أعلى يمين", "أعلى يسار", "أسفل يمين", "أسفل يسار"], group=grpOpt)
optLev  = input.float(10.0, "الرافعة التقديرية للعقد (٪ العقد لكل ١٪ سهم)", minval=3, maxval=30, step=1, group=grpOpt)
optSym  = input.symbol("", "رمز العقد الحي (اختياري — يتطلب بيانات OPRA)", group=grpOpt)
optPrem = input.float(0.0, "سعر دخولك في العقد (لنسبة حية من دخولك)", minval=0.0, step=0.01, group=grpOpt)

// ------------------------------------------------------------------ الألوان
cUp   = #26A69A
cDn   = #EF5350
cGold = #E3B34D
cOrng = #FF9E45
cCyan = #38C8E8
cTxt  = #D5D9E4
cMut  = #787B86
cPanl = color.new(#1B2130, 8)
cHead = color.new(#232B3D, 0)

// ----------------------------------------------------------- حسابات أساسية
atr    = ta.atr(14)
volSma = ta.sma(volume, 20)
relVol = volSma > 0 ? volume / volSma : 1.0
rngHL  = math.max(high - low, syminfo.mintick)
// دلتا تقديرية: نصيب المشتري من حجم الشمعة بحسب موضع الإغلاق داخل مداها
deltaEst   = volume * (close - open) / rngHL
deltaEmaP  = ta.ema(math.abs(deltaEst), 20)
deltaEmaS  = ta.ema(deltaEst, 20)
deltaShare = deltaEmaP > 0 ? 100 * deltaEmaS / deltaEmaP : 0.0

emaF = ta.ema(close, 9)
emaS = ta.ema(close, 21)

// قيعان/قمم متأرجحة مؤكدة — للوقف البنيوي
pivL = ta.pivotlow(low, 2, 2)
pivH = ta.pivothigh(high, 2, 2)
var float lastPivL = na
var float lastPivH = na
var int   lastPivLBar = 0
var int   lastPivHBar = 0
if not na(pivL)
    lastPivL := pivL
    lastPivLBar := bar_index - 2
if not na(pivH)
    lastPivH := pivH
    lastPivHBar := bar_index - 2

// نص جهة الصفقة
f_side(d) => d > 0 ? "كول" : "بوت"

// ------------------- اتجاه الفريمات الثلاثة + نتيجة الإشارة السابقة لكل فريم
f_tfState() =>
    eF = ta.ema(close, 9)
    eS = ta.ema(close, 21)
    d  = eF > eS and close > eS ? 1 : eF < eS and close < eS ? -1 : 0
    var int   segDir   = 0
    var float segStart = na
    var int   prevDir  = 0
    var float prevPerf = na
    if d != segDir
        if segDir != 0 and not na(segStart) and segStart != 0
            prevDir  := segDir
            prevPerf := 100 * (close - segStart) / segStart * (segDir > 0 ? 1 : -1)
        segDir   := d
        segStart := close
    [d, prevDir, prevPerf]

[c1, pd1, pf1] = request.security(syminfo.tickerid, useTf1, f_tfState(), lookahead=barmerge.lookahead_off)
[c2, pd2, pf2] = request.security(syminfo.tickerid, useTf2, f_tfState(), lookahead=barmerge.lookahead_off)
[c3, pd3, pf3] = request.security(syminfo.tickerid, useTf3, f_tfState(), lookahead=barmerge.lookahead_off)

alignCall = (c1 > 0 ? 1 : 0) + (c2 > 0 ? 1 : 0) + (c3 > 0 ? 1 : 0)
alignPut  = (c1 < 0 ? 1 : 0) + (c2 < 0 ? 1 : 0) + (c3 < 0 ? 1 : 0)

// ------------------------------------------------- الحواف التلقائية حسب فريم الشارت
// ١د–٣٠د: الأمس + الأسبوع الماضي · ساعة–٤س: الأسبوع الماضي + الشهر الماضي · يوم فأكبر: الشهر + الربع الماضيان
edgeSec  = timeframe.in_seconds(timeframe.period)
edgeNear = not timeframe.isintraday ? "M" : edgeSec > 1800 ? "W" : "D"
edgeWide = not timeframe.isintraday ? "3M" : edgeSec > 1800 ? "M" : "W"
[pdH, pdL] = request.security(syminfo.tickerid, edgeNear, [high[1], low[1]], lookahead=barmerge.lookahead_off)
[pwH, pwL] = request.security(syminfo.tickerid, edgeWide, [high[1], low[1]], lookahead=barmerge.lookahead_off)
dOpen      = request.security(syminfo.tickerid, "D", open,              lookahead=barmerge.lookahead_off)

newDay = ta.change(time("D")) != 0
var float dayHi = na
var float dayLo = na
if newDay
    dayHi := high
    dayLo := low
else
    dayHi := math.max(nz(dayHi, high), high)
    dayLo := math.min(nz(dayLo, low), low)
var int barsToday = 0
barsToday := newDay ? 0 : barsToday + 1

// نوع اليوم — موقع السعر مقابل افتتاح اليوم
dayMovePct = dOpen > 0 ? 100 * (close - dOpen) / dOpen : 0.0
dayType    = dayMovePct > 0.6 ? "ترند صاعد" : dayMovePct < -0.6 ? "ترند هابط" : "نطاق"

// موقعنا داخل مدى اليوم — منتصف النطاق ممنوع الدخول منه (إلا مصيدة)
dayRng   = math.max(dayHi - dayLo, syminfo.mintick)
posInDay = (close - dayLo) / dayRng
midRange = posInDay > 0.40 and posInDay < 0.60

// ------------------------------------------------------------- صائد المصائد
// ذيل يكسر أرضية الأمس/الأسبوع ويغلق فوقها + حجم مضاعف + دلتا شرائية
tol = 0.05 * atr
sessSwpL = barsToday > 6 and low < dayLo[1] - tol and close > dayLo[1]
sessSwpH = barsToday > 6 and high > dayHi[1] + tol and close < dayHi[1]
bullTrap = ((low < pdL - tol and close > pdL) or (low < pwL - tol and close > pwL) or sessSwpL) and relVol > trapVolX and deltaEst > 0
bearTrap = ((high > pdH + tol and close < pdH) or (high > pwH + tol and close < pwH) or sessSwpH) and relVol > trapVolX and deltaEst < 0
trapRecUp = nz(ta.barssince(bullTrap), 99999) <= 6
trapRecDn = nz(ta.barssince(bearTrap), 99999) <= 6

// -------------------------------------------------------------- قوة الاتجاه
nearFloor = (close - math.max(pdL, pwL)) >= 0 and (close - math.max(pdL, pwL)) < 1.2 * atr
nearCeil  = (math.min(pdH, pwH) - close) >= 0 and (math.min(pdH, pwH) - close) < 1.2 * atr

// ارتداد مؤكد من الأرضية / رفض مؤكد من السقف — دخول من القاع نفسه بشمعة حاسمة
bodyRatio  = math.abs(close - open) / rngHL
bullBounce = nearFloor and close > open and bodyRatio > 0.55 and deltaEst > 0 and relVol > 1.2
bearBounce = nearCeil  and close < open and bodyRatio > 0.55 and deltaEst < 0 and relVol > 1.2

f_score(algn, dSideOk, nearMy, trapMy) =>
    sA = algn * 10
    sD = dSideOk ? math.min(25, math.round(math.abs(deltaShare) / 4)) : 0
    sL = trapMy ? 25 : nearMy ? 20 : midRange ? 0 : 10
    sV = math.min(15, math.round(relVol * 6))
    sT = trapMy ? 5 : 0
    math.min(100, sA + sD + sL + sV + sT)

callScore = f_score(alignCall, deltaShare > 0, nearFloor, trapRecUp)
putScore  = f_score(alignPut,  deltaShare < 0, nearCeil,  trapRecDn)

verdict = callScore >= minScore and callScore > putScore + 10 ? "كول" :
     putScore >= minScore and putScore > callScore + 10 ? "بوت" : "حياد"
confTxt = math.max(callScore, putScore) >= 80 ? "قوية" :
     math.max(callScore, putScore) >= minScore ? "جيدة" : "ضعيفة"

// ------------------------------------------------------------- حالة الصفقة
var bool  inTrade  = false
var int   tDir     = 0
var float entryP   = na
var float stopP    = na
var float stop0    = na
var float t1P      = na
var float t2P      = na
var float t3P      = na
var bool  t1Hit    = false
var bool  t2Hit    = false
var bool  t3Hit    = false
var int   lastExit = -99999
var int   entryBar = 0
var int    pendDir   = 0
var float  pendLvl   = na
var float  pendStp   = na
var string pendWhy   = ""
var int    pendUntil = 0
var int    pendSince = 0
var line   lnPend    = na
var label  lbPend    = na

var line  lnEntry = na
var line  lnStop  = na
var line  lnT1    = na
var line  lnT2    = na
var line  lnT3    = na
var label lbT1    = na
var label lbT2    = na
var label lbT3    = na
var label lbStop  = na

// لوحة الصدق — سجل النتائج
var resArr  = array.new_int()
var int   winsAll = 0
var int   lossAll = 0
var float sumR    = 0.0
var float bestR   = na
var float worstR  = na

// ------------------------------------------------------ علامات استعداد ومصيدة
prepZoneL = nearFloor and verdict != "بوت"
prepZoneS = nearCeil and verdict != "كول"
// تهدئة: علامة ⏳ لا تتكرر لنفس الجهة إلا بعد ٨ شموع — منعاً للتكدس في التذبذب
var int lastPrepLBar = -999
var int lastPrepHBar = -999
if showPrep and barstate.isconfirmed and not inTrade
    if prepZoneL and not prepZoneL[1] and bar_index - lastPrepLBar > 8
        lastPrepLBar := bar_index
        label.new(bar_index, low, "⏳", style=label.style_label_up, color=color.new(cCyan, 20), textcolor=#04222B, size=szMark)
        alert("⏳ استعداد | " + syminfo.ticker + " يقترب من أرضية قرار عند " + str.tostring(close, format.mintick), alert.freq_once_per_bar)
    if prepZoneS and not prepZoneS[1] and bar_index - lastPrepHBar > 8
        lastPrepHBar := bar_index
        label.new(bar_index, high, "⏳", style=label.style_label_down, color=color.new(cCyan, 20), textcolor=#04222B, size=szMark)
        alert("⏳ استعداد | " + syminfo.ticker + " يقترب من سقف قرار عند " + str.tostring(close, format.mintick), alert.freq_once_per_bar)

if barstate.isconfirmed and bullTrap
    label.new(bar_index, low, "🪤", style=label.style_label_up, color=cGold, textcolor=#161309, size=szMark)
    alert("🪤 مصيدة سيولة تحت الأرضية | " + syminfo.ticker + " — كسر كاذب وإغلاق فوق المستوى", alert.freq_once_per_bar)
if barstate.isconfirmed and bearTrap
    label.new(bar_index, high, "🪤", style=label.style_label_down, color=cGold, textcolor=#161309, size=szMark)
    alert("🪤 مصيدة سيولة فوق السقف | " + syminfo.ticker + " — اختراق كاذب وإغلاق تحت المستوى", alert.freq_once_per_bar)

// ------------------------------------------------------------------- الدخول
// حارس نهاية الجلسة: آخر hardMin دقيقة إما منع تام أو إشارات موسومة 🌙 لعقد الغد،
// وما قبلها (حتى warnMin) بوسم ⚡ سكالب سريع
minsLeft  = timeframe.isintraday ? math.max(0.0, (time_close("D") - time_close) / 60000.0) : na
lastWin   = endGuard and timeframe.isintraday and not na(minsLeft) and minsLeft <= hardMin
lateBlock = lastWin and endModeS == "منع الإشارات تماماً"
lateNext  = lastWin and not lateBlock
lateWarn  = endGuard and timeframe.isintraday and not na(minsLeft) and minsLeft <= warnMin and not lastWin

qBlock = qMode and timeframe.isintraday and not na(minsLeft) and minsLeft <= 120
canEnter = barstate.isconfirmed and not inTrade and pendDir == 0 and (bar_index - lastExit) > coolBars and (high - low) <= maxCndAtr * atr and not lateBlock and not qBlock

longTrap  = canEnter and bullTrap and callScore >= minScore and alignCall >= needAlignEff
shortTrap = canEnter and bearTrap and putScore >= minScore and alignPut >= needAlignEff
longBnc  = canEnter and not longTrap and not qMode and bullBounce and callScore >= minScore and alignCall >= needAlignEff
shortBnc = canEnter and not shortTrap and bearBounce and putScore >= minScore and alignPut >= needAlignEff
brkUp = canEnter and not longTrap and not longBnc and (ta.crossover(close, pdH) or ta.crossover(close, pwH)) and
     relVol > 1.3 and deltaEst > 0 and callScore >= minScore and alignCall >= needAlignEff and not midRange
brkDn = canEnter and not shortTrap and not shortBnc and (ta.crossunder(close, pdL) or ta.crossunder(close, pwL)) and
     relVol > 1.3 and deltaEst < 0 and putScore >= minScore and alignPut >= needAlignEff and not midRange

sigDir  = longTrap ? 1 : shortTrap ? -1 : longBnc ? 1 : shortBnc ? -1 : brkUp ? 1 : brkDn ? -1 : 0
sigWhy  = longTrap ? "انعكاس مصيدة على الأرضية" : shortTrap ? "انعكاس مصيدة على السقف" :
     longBnc ? "ارتداد مؤكد من الأرضية" : shortBnc ? "رفض مؤكد من السقف" :
     brkUp ? "اختراق حافة بحجم" : brkDn ? "كسر حافة بحجم" : ""
sigStop = longTrap ? low - 0.25 * atr : shortTrap ? high + 0.25 * atr :
     longBnc ? math.min(low, low[1]) - 0.25 * atr : shortBnc ? math.max(high, high[1]) + 0.25 * atr :
     brkUp ? math.min(low, low[1]) - 0.25 * atr : brkDn ? math.max(high, high[1]) + 0.25 * atr : na
lateTag = lateNext ? " · 🌙 لعقد الغد — سترايك قريب بنفس الاتجاه" : lateWarn ? " · ⚡ سكالب سريع (قرب الإغلاق)" : ""

openDir  = 0
openEntry = float(na)
openStop = float(na)
openWhy  = ""

if sigDir != 0
    if not retraceMode
        openDir  := sigDir
        openEntry := close
        openStop := sigStop
        openWhy  := sigWhy + lateTag
    else
        pendDir   := sigDir
        pendLvl   := math.round_to_mintick((high + low) / 2)
        pendStp   := sigStop
        pendWhy   := sigWhy + lateTag
        pendUntil := bar_index + waitBars
        pendSince := bar_index
        lnPend := line.new(bar_index, pendLvl, bar_index + 1, pendLvl, extend=extend.right, color=color.new(cCyan, 30), style=line.style_dashed, width=1)
        lbPend := label.new(bar_index + 3, pendLvl, (lateNext ? "🌙 " : lateWarn ? "⚡ " : "") + "منطقة دخول " + f_side(sigDir) + " · " + str.tostring(pendLvl, format.mintick), style=label.style_label_left, textcolor=#04222B, color=color.new(cCyan, 15), size=szSig)
        alert("🎯 إشارة " + f_side(sigDir) + " | " + syminfo.ticker + " — انتظر الارتداد لمنطقة الدخول " + str.tostring(pendLvl, format.mintick) + " | وقف " + str.tostring(sigStop, format.mintick) + lateTag, alert.freq_once_per_bar)

// معالجة إشارة الانتظار: دخول على الارتداد أو إلغاء
if pendDir != 0 and barstate.isconfirmed and not inTrade and bar_index > pendSince
    touched = pendDir > 0 ? low <= pendLvl : high >= pendLvl
    broken  = pendDir > 0 ? close < pendStp : close > pendStp
    expired = bar_index > pendUntil
    if touched and not broken
        openDir  := pendDir
        openEntry := pendLvl
        openStop := pendStp
        openWhy  := pendWhy + " — دخول محسّن على الارتداد"
        line.delete(lnPend)
        label.delete(lbPend)
        pendDir := 0
    else if broken or expired
        line.delete(lnPend)
        label.delete(lbPend)
        label.new(bar_index, pendDir > 0 ? high : low, "⨯", style=pendDir > 0 ? label.style_label_down : label.style_label_up, color=color.new(cMut, 40), textcolor=cTxt, size=szMark)
        alert("⨯ أُلغيت إشارة " + f_side(pendDir) + " | " + syminfo.ticker + (expired ? " — لم يرتد للسعر خلال المهلة" : " — كُسر مستوى الإبطال قبل الدخول"), alert.freq_once_per_bar)
        pendDir := 0

if openDir != 0
    inTrade := true
    entryBar := bar_index
    tDir    := openDir
    entryP  := openEntry
    stopP   := openStop
    stop0   := openStop
    t1P     := openDir > 0 ? openEntry + t1x * atr : openEntry - t1x * atr
    t2P     := openDir > 0 ? openEntry + t2x * atr : openEntry - t2x * atr
    t3P     := openDir > 0 ? openEntry + t3x * atr : openEntry - t3x * atr
    t1Hit   := false
    t2Hit   := false
    t3Hit   := false
    lnEntry := line.new(bar_index, entryP, bar_index + 1, entryP, extend=extend.right, color=color.new(cTxt, 35), style=line.style_dotted, width=1)
    lnStop  := line.new(bar_index, stopP, bar_index + 1, stopP, extend=extend.right, color=cOrng, width=2)
    lnT1    := line.new(bar_index, t1P, bar_index + 1, t1P, extend=extend.right, color=color.new(cUp, 65), style=line.style_dotted, width=1)
    lnT2    := line.new(bar_index, t2P, bar_index + 1, t2P, extend=extend.right, color=color.new(cUp, 65), style=line.style_dotted, width=1)
    lnT3    := line.new(bar_index, t3P, bar_index + 1, t3P, extend=extend.right, color=color.new(cGold, 55), style=line.style_dotted, width=1)
    lbT1    := label.new(bar_index + 3, t1P, "هدف 1 · " + str.tostring(t1P, format.mintick), style=label.style_label_left, textcolor=cTxt, color=color.new(#2A3245, 20), size=szMark)
    lbT2    := label.new(bar_index + 3, t2P, "هدف 2 · " + str.tostring(t2P, format.mintick), style=label.style_label_left, textcolor=cTxt, color=color.new(#2A3245, 20), size=szMark)
    lbT3    := label.new(bar_index + 3, t3P, "هدف 3 ↗ · " + str.tostring(t3P, format.mintick), style=label.style_label_left, textcolor=cGold, color=color.new(#2A3245, 20), size=szMark)
    lbStop  := label.new(bar_index + 3, stopP, "الوقف · " + str.tostring(stopP, format.mintick), style=label.style_label_left, textcolor=#1A0E02, color=cOrng, size=szMark)
    label.new(bar_index, openDir > 0 ? low : high, (str.contains(openWhy, "🌙") ? "🌙 " : str.contains(openWhy, "⚡") ? "⚡ " : "") + "🎯 دخول " + f_side(openDir) + " " + str.tostring(entryP, format.mintick),
         style=openDir > 0 ? label.style_label_up : label.style_label_down,
         color=openDir > 0 ? cUp : cDn, textcolor=openDir > 0 ? #04211D : #2B0606, size=szSig)
    alert("🎯 دخول " + f_side(openDir) + " | " + syminfo.ticker + " فريم " + timeframe.period +
         " | سعر " + str.tostring(entryP, format.mintick) + " | وقف " + str.tostring(stopP, format.mintick) +
         " | السبب: " + openWhy, alert.freq_once_per_bar)

// ------------------------------------------- إدارة الصفقة: أهداف تضيء ووقف يتسلق
if inTrade and barstate.isconfirmed and openDir == 0
    if not t1Hit and (tDir > 0 ? high >= t1P : low <= t1P)
        t1Hit := true
        stopP := entryP
        label.set_color(lbT1, cUp)
        label.set_textcolor(lbT1, #04211D)
        label.set_text(lbT1, "هدف 1 ✓ · " + str.tostring(t1P, format.mintick))
        alert("🔺 هدف 1 تحقق والصفقة مؤمّنة (الوقف = الدخول) | " + syminfo.ticker, alert.freq_once_per_bar)
    if t1Hit and not t2Hit and (tDir > 0 ? high >= t2P : low <= t2P)
        t2Hit := true
        stopP := t1P
        label.set_color(lbT2, cUp)
        label.set_textcolor(lbT2, #04211D)
        label.set_text(lbT2, "هدف 2 ✓ · " + str.tostring(t2P, format.mintick))
        alert("🔺 هدف 2 تحقق — الوقف صعد إلى هدف 1 | " + syminfo.ticker, alert.freq_once_per_bar)
    if t2Hit and not t3Hit and (tDir > 0 ? high >= t3P : low <= t3P)
        t3Hit := true
        label.set_color(lbT3, cGold)
        label.set_textcolor(lbT3, #161309)
        label.set_text(lbT3, "هدف 3 ✓ ممتد · " + str.tostring(t3P, format.mintick))
        alert("🔺 الهدف الممتد تحقق | " + syminfo.ticker, alert.freq_once_per_bar)
    if t1Hit
        chandS  = tDir > 0 ? close - trailEff * atr : close + trailEff * atr
        okPivL  = not na(lastPivL) and lastPivLBar > entryBar
        okPivH  = not na(lastPivH) and lastPivHBar > entryBar
        structS = tDir > 0 ? (okPivL ? lastPivL - 0.25 * atr : chandS) : (okPivH ? lastPivH + 0.25 * atr : chandS)
        trail   = tDir > 0 ? math.max(chandS, structS) : math.min(chandS, structS)
        stopP  := tDir > 0 ? math.max(stopP, trail) : math.min(stopP, trail)
    line.set_y1(lnStop, stopP)
    line.set_y2(lnStop, stopP)
    label.set_y(lbStop, stopP)
    label.set_text(lbStop, (stopP == entryP ? "مؤمّنة ✓ · " : "الوقف · ") + str.tostring(stopP, format.mintick))
    label.set_x(lbT1, bar_index + 3)
    label.set_x(lbT2, bar_index + 3)
    label.set_x(lbT3, bar_index + 3)
    label.set_x(lbStop, bar_index + 3)
    if tDir > 0 ? close < stopP : close > stopP
        risk  = math.abs(entryP - stop0)
        // R يُحسب على سعر الخروج الفعلي (إغلاق شمعة كسر الوقف) — لا على أفضل هدف ملموس
        rMult = risk > 0 ? (tDir > 0 ? close - entryP : entryP - close) / risk : 0.0
        win   = t1Hit
        array.unshift(resArr, win ? 1 : 0)
        if array.size(resArr) > 20
            array.pop(resArr)
        winsAll += win ? 1 : 0
        lossAll += win ? 0 : 1
        sumR    += rMult
        bestR   := na(bestR) ? rMult : math.max(bestR, rMult)
        worstR  := na(worstR) ? rMult : math.min(worstR, rMult)
        line.delete(lnEntry)
        line.delete(lnStop)
        line.delete(lnT1)
        line.delete(lnT2)
        line.delete(lnT3)
        label.delete(lbT1)
        label.delete(lbT2)
        label.delete(lbT3)
        label.delete(lbStop)
        label.new(bar_index, tDir > 0 ? low : high,
             win ? "✅ خروج +" + str.tostring(rMult, "#.#") + "R" : "🔴 خروج على الوقف",
             style=tDir > 0 ? label.style_label_up : label.style_label_down,
             color=win ? color.new(cUp, 20) : color.new(cDn, 10),
             textcolor=win ? #04211D : #2B0606, size=szSig)
        alert((win ? "✅" : "🔴") + " خروج — كسر الوقف المتحرك | " + syminfo.ticker +
             " | النتيجة " + (win ? "+" : "") + str.tostring(rMult, "#.#") + "R", alert.freq_once_per_bar)
        inTrade  := false
        lastExit := bar_index

// ------------------------------------------------ خطوط الحواف (تتبع فريم الشارت تلقائياً)
plot(showLvls ? pdH : na, "قمة الحافة القريبة", color=color.new(cMut, 55), style=plot.style_linebr, linewidth=1)
plot(showLvls ? pdL : na, "قاع الحافة القريبة", color=color.new(cMut, 55), style=plot.style_linebr, linewidth=1)
plot(showLvls ? pwH : na, "قمة الحافة الواسعة", color=color.new(#B8578A, 45), style=plot.style_linebr, linewidth=1)
plot(showLvls ? pwL : na, "قاع الحافة الواسعة", color=color.new(#B8578A, 45), style=plot.style_linebr, linewidth=1)

// ------------------------------------------------------------- لوحة القيادة
f_pos(s) => s == "أعلى يمين" ? position.top_right : s == "أعلى يسار" ? position.top_left :
     s == "أسفل يمين" ? position.bottom_right : position.bottom_left

f_dirCell(d, isPrev) =>
    t = d > 0 ? "كول" : d < 0 ? "بوت" : "حياد"
    ic = isPrev ? (d > 0 ? "✅ " : d < 0 ? "❌ " : "➖ ") : "⌛ "
    ic + t

// خلية الإشارة السابقة: جهتها + نتيجتها الفعلية ±%
f_prevCell(pd, pf) =>
    na(pf) ? "—" : (pf >= 0 ? "✅ " : "❌ ") + (pd > 0 ? "كول " : pd < 0 ? "بوت " : "") + (pf >= 0 ? "+" : "−") + str.tostring(math.abs(pf), "#.#") + "%"

f_prevCol(pf) => na(pf) ? cMut : pf >= 0 ? cUp : cDn

f_dirCol(d) => d > 0 ? cUp : d < 0 ? cDn : cMut

f_tfName(tf) =>
    tf == "60" ? "ساعة" : tf == "120" ? "ساعتان" : tf == "180" ? "٣ س" : tf == "240" ? "٤ س" :
     tf == "D" ? "يوم" : tf == "W" ? "أسبوع" : tf == "M" ? "شهر" : tf == "3M" ? "٣ أشهر" :
     tf == "12M" ? "سنة" : tf + " د"

f_bar10(n) =>
    k = math.round(n / 10)
    str.repeat("█", k) + str.repeat("░", 10 - k)

var table dash = table.new(f_pos(dashPosS), 3, 12, bgcolor=cPanl, border_width=1, border_color=color.new(#2A3245, 0))
if showDash and barstate.islast
    table.cell(dash, 0, 0, syminfo.ticker + " · " + f_tfName(timeframe.period), text_color=cTxt, bgcolor=cHead, text_size=size.small)
    table.cell(dash, 1, 0, "", bgcolor=cHead)
    table.cell(dash, 2, 0, "اليوم: " + dayType, text_color=dayMovePct > 0.6 ? cUp : dayMovePct < -0.6 ? cDn : cMut, bgcolor=cHead, text_size=size.small)
    table.cell(dash, 0, 1, "الفريم",  text_color=cMut, text_size=size.tiny)
    table.cell(dash, 1, 1, "السابقة", text_color=cMut, text_size=size.tiny)
    table.cell(dash, 2, 1, "الحالية", text_color=cMut, text_size=size.tiny)
    table.cell(dash, 0, 2, f_tfName(useTf1), text_color=cTxt, text_size=size.small)
    table.cell(dash, 1, 2, f_prevCell(pd1, pf1), text_color=f_prevCol(pf1), text_size=size.small)
    table.cell(dash, 2, 2, f_dirCell(c1, false), text_color=f_dirCol(c1), text_size=size.small)
    table.cell(dash, 0, 3, f_tfName(useTf2), text_color=cTxt, text_size=size.small)
    table.cell(dash, 1, 3, f_prevCell(pd2, pf2), text_color=f_prevCol(pf2), text_size=size.small)
    table.cell(dash, 2, 3, f_dirCell(c2, false), text_color=f_dirCol(c2), text_size=size.small)
    table.cell(dash, 0, 4, f_tfName(useTf3), text_color=cTxt, text_size=size.small)
    table.cell(dash, 1, 4, f_prevCell(pd3, pf3), text_color=f_prevCol(pf3), text_size=size.small)
    table.cell(dash, 2, 4, f_dirCell(c3, false), text_color=f_dirCol(c3), text_size=size.small)
    table.cell(dash, 0, 5, "قوة كول", text_color=cUp, text_size=size.small)
    table.cell(dash, 1, 5, f_bar10(callScore), text_color=cUp, text_size=size.small)
    table.cell(dash, 2, 5, str.tostring(callScore) + "/100", text_color=cUp, text_size=size.small)
    table.cell(dash, 0, 6, "قوة بوت", text_color=cDn, text_size=size.small)
    table.cell(dash, 1, 6, f_bar10(putScore), text_color=cDn, text_size=size.small)
    table.cell(dash, 2, 6, str.tostring(putScore) + "/100", text_color=cDn, text_size=size.small)
    table.cell(dash, 0, 7, "الدلتا", text_color=cCyan, text_size=size.small)
    table.cell(dash, 1, 7, (deltaShare >= 0 ? "شراء " : "بيع ") + str.tostring(math.abs(math.round(deltaShare))) + "%", text_color=deltaShare >= 0 ? cUp : cDn, text_size=size.small)
    table.cell(dash, 2, 7, "حجم ×" + str.tostring(relVol, "#.#"), text_color=cMut, text_size=size.small)
    vCol  = verdict == "كول" ? cUp : verdict == "بوت" ? cDn : cMut
    stTxt = inTrade ? (t2Hit ? "💰 الإجراء: احجز الربح — الوقف عند هدف ١" : t1Hit ? "🛡️ الإجراء: مؤمّنة — خلّ الوقف يتسلق" : "🎯 الإجراء: صفقة نشطة — التزم بالوقف") : lateBlock ? "⏸ قرب الإغلاق — لا إشارات جديدة" : lateNext ? "🌙 آخر الجلسة — الإشارات لعقد الغد" : "الحكم: " + verdict + " · الثقة " + confTxt + (lateWarn ? " · ⚡" : "")
    hitsN = (t1Hit ? 1 : 0) + (t2Hit ? 1 : 0) + (t3Hit ? 1 : 0)
    table.cell(dash, 0, 8, stTxt, text_color=vCol, bgcolor=color.new(vCol, 85), text_size=size.small)
    table.cell(dash, 1, 8, "", bgcolor=color.new(vCol, 85))
    table.cell(dash, 2, 8, inTrade ? "أهداف ✓" + str.tostring(hitsN) + "/3" : "جاهز للمراقبة", text_color=vCol, bgcolor=color.new(vCol, 85), text_size=size.small)
    // متابعة الصفقة الحية — تُطوى تلقائياً عند الانتهاء
    table.cell(dash, 0, 9,  inTrade ? "الدخول" : "", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 9,  "", text_size=size.small)
    table.cell(dash, 2, 9,  inTrade ? str.tostring(entryP, format.mintick) : "", text_color=cTxt, text_size=size.small)
    table.cell(dash, 0, 10, inTrade ? "الوقف" : "", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 10, inTrade ? (stopP >= entryP == (tDir > 0) ? "مؤمّنة ✓" : "") : "", text_color=cUp, text_size=size.small)
    table.cell(dash, 2, 10, inTrade ? str.tostring(stopP, format.mintick) : "", text_color=cOrng, text_size=size.small)
    table.cell(dash, 0, 11, inTrade ? "الأهداف" : "", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 11, inTrade and t2Hit and not t3Hit ? "الثالث ممتد ↗" : "", text_color=cGold, text_size=size.small)
    table.cell(dash, 2, 11, inTrade ? "✓" + str.tostring(hitsN) + " من 3" : "", text_color=cUp, text_size=size.small)

// ------------------------------------------------------------- لوحة المراقبة
// استدعاء واحد لكل سهم (بدل اثنين) — نسبة اليوم تُحسب من افتتاح اليوم داخل نفس الاستدعاء
f_wlDir() =>
    eF = ta.ema(close, 9)
    eS = ta.ema(close, 21)
    dd = eF > eS and close > eS ? 1 : eF < eS and close < eS ? -1 : 0
    var float dOp = na
    if ta.change(time("D")) != 0
        dOp := open
    wy = not na(dOp) and dOp > 0 ? 100 * (close - dOp) / dOp : 0.0
    [close, dd, wy]

f_wlFetch(sym) =>
    request.security(sym, timeframe.period, f_wlDir(), lookahead=barmerge.lookahead_off)

[w1c, w1d, w1y] = f_wlFetch(wl1)
[w2c, w2d, w2y] = f_wlFetch(wl2)
[w3c, w3d, w3y] = f_wlFetch(wl3)
[w4c, w4d, w4y] = f_wlFetch(wl4)
[w5c, w5d, w5y] = f_wlFetch(wl5)
[w6c, w6d, w6y] = f_wlFetch(wl6)
[w7c, w7d, w7y] = f_wlFetch(wl7)
[w8c, w8d, w8y] = f_wlFetch(wl8)
[w9c, w9d, w9y] = f_wlFetch(wl9)
[w10c, w10d, w10y] = f_wlFetch(wl10)

f_wlShort(sym) =>
    parts = str.split(sym, ":")
    array.size(parts) > 1 ? array.get(parts, array.size(parts) - 1) : sym

// في وضع إعادة التشغيل لا تتوفر بيانات بقية الأسهم — نعرض "—" بدل NaN
f_wlPx(c)  => na(c) ? "—" : str.tostring(c, format.mintick)
f_wlPct(y) => na(y) ? "—" : (y >= 0 ? "+" : "−") + str.tostring(math.abs(y), "#.#") + "%"

f_wlTrend(wd, wy) =>
    na(wy) ? "—" : wy > 0.6 and wd > 0 ? "صعود قوي" : wy > 0.15 ? "صعود" : wy < -0.6 and wd < 0 ? "هبوط قوي" : wy < -0.15 ? "هبوط" : "محايد"

f_wlCol(wy) => wy > 0.15 ? cUp : wy < -0.15 ? cDn : cMut

f_wlRow(t, r, sym, wc, wd, wy) =>
    table.cell(t, 0, r, f_wlShort(sym), text_color=cTxt, text_size=size.small)
    table.cell(t, 1, r, f_wlPx(wc), text_color=cTxt, text_size=size.small)
    table.cell(t, 2, r, f_wlPct(wy), text_color=f_wlCol(wy), text_size=size.small)
    table.cell(t, 3, r, f_wlTrend(wd, wy), text_color=f_wlCol(wy), text_size=size.small)

var table wtab = na
if showWatch and barstate.islast
    if not na(wtab)
        table.delete(wtab)
    wtab := table.new(f_pos(watchPosS), 4, wlN + 1, bgcolor=cPanl, border_width=1, border_color=color.new(#2A3245, 0))
    table.cell(wtab, 0, 0, "لوحة المراقبة", text_color=cTxt, bgcolor=cHead, text_size=size.small)
    table.cell(wtab, 1, 0, "السعر", text_color=cMut, bgcolor=cHead, text_size=size.tiny)
    table.cell(wtab, 2, 0, "اليوم", text_color=cMut, bgcolor=cHead, text_size=size.tiny)
    table.cell(wtab, 3, 0, "الاتجاه", text_color=cMut, bgcolor=cHead, text_size=size.tiny)
    f_wlRow(wtab, 1, wl1, w1c, w1d, w1y)
    if wlN >= 2
        f_wlRow(wtab, 2, wl2, w2c, w2d, w2y)
    if wlN >= 3
        f_wlRow(wtab, 3, wl3, w3c, w3d, w3y)
    if wlN >= 4
        f_wlRow(wtab, 4, wl4, w4c, w4d, w4y)
    if wlN >= 5
        f_wlRow(wtab, 5, wl5, w5c, w5d, w5y)
    if wlN >= 6
        f_wlRow(wtab, 6, wl6, w6c, w6d, w6y)
    if wlN >= 7
        f_wlRow(wtab, 7, wl7, w7c, w7d, w7y)
    if wlN >= 8
        f_wlRow(wtab, 8, wl8, w8c, w8d, w8y)
    if wlN >= 9
        f_wlRow(wtab, 9, wl9, w9c, w9d, w9y)
    if wlN >= 10
        f_wlRow(wtab, 10, wl10, w10c, w10d, w10y)

// --------------------------------------------------------------- لوحة الصدق
var table hon = table.new(dashPosS == "أسفل يمين" ? position.bottom_left : position.bottom_right, 1, 3, bgcolor=cPanl, border_width=1, border_color=color.new(#2A3245, 0))
if showHon and barstate.islast
    n20 = array.size(resArr)
    w20 = 0
    if n20 > 0
        for i = 0 to n20 - 1
            w20 += array.get(resArr, i)
    tot = winsAll + lossAll
    wr  = tot > 0 ? 100.0 * winsAll / tot : 0.0
    avR = tot > 0 ? sumR / tot : 0.0
    table.cell(hon, 0, 0, "لوحة الصدق — " + syminfo.ticker + " · " + f_tfName(timeframe.period), text_color=cTxt, bgcolor=cHead, text_size=size.small)
    table.cell(hon, 0, 1, "آخر " + str.tostring(n20) + ": " + str.tostring(w20) + "✓ " + str.tostring(n20 - w20) + "✗   |   الكل: " + str.tostring(tot) + " إشارة · نجاح " + str.tostring(wr, "#.#") + "% · متوسط " + (avR >= 0 ? "+" : "") + str.tostring(avR, "#.##") + "R", text_color=cMut, text_size=size.small)
    table.cell(hon, 0, 2, tot > 0 ? "أفضل صفقة +" + str.tostring(bestR, "#.#") + "R · أسوأ صفقة " + str.tostring(worstR, "#.#") + "R" : "لا صفقات بعد", text_color=cMut, text_size=size.small)

// --------------------------------------------------------------- لوحة العقد
// تتكلم بلغة العقد لا لغة السهم: العقد المقترح يُحسب آلياً (سترايك قريب
// خارج السعر + الانتهاء الصحيح: يومي للصناديق، جمعة الأسبوع للأسهم)،
// وأهداف الصفقة تُترجم إلى نسب أرباح تقريبية للعقد عبر رافعة تقديرية —
// وتُوسم "تقديري" بصدق. ولمن يملك بيانات OPRA: ضع رمز العقد وسعر دخولك
// في الإعدادات فتتحول اللوحة إلى سعر حي ونسبة حية من دخولك أنت.
f_step(p) => p < 50 ? 0.5 : p < 200 ? 1.0 : p < 500 ? 2.5 : 5.0
isFund  = syminfo.ticker == "QQQ" or syminfo.ticker == "SPY" or syminfo.ticker == "SPX"
expTxt  = isFund ? (lateNext ? "غداً (0DTE)" : "اليوم (0DTE)") : "جمعة الأسبوع"
optDir  = inTrade ? tDir : verdict == "كول" ? 1 : verdict == "بوت" ? -1 : 0
optBase = inTrade ? entryP : close
optStep = f_step(optBase)
optStrk = optDir > 0 ? math.ceil(optBase / optStep) * optStep : math.floor(optBase / optStep) * optStep
optCP   = optDir > 0 ? "C" : "P"

// نسبة العقد التقريبية لكل هدف: حركة الهدف كنسبة من السهم × الرافعة
f_optPct(tgt) =>
    optBase > 0 and not na(tgt) ? math.abs(tgt - optBase) / optBase * 100.0 * optLev : na
o1 = inTrade ? f_optPct(t1P) : f_optPct(optDir > 0 ? close + 0.9 * atr : close - 0.9 * atr)
o2 = inTrade ? f_optPct(t2P) : f_optPct(optDir > 0 ? close + 1.6 * atr : close - 1.6 * atr)
o3 = inTrade ? f_optPct(t3P) : f_optPct(optDir > 0 ? close + 2.8 * atr : close - 2.8 * atr)
f_pctTxt(p) => na(p) ? "—" : "+" + str.tostring(p, "#") + "%"

// السعر الحي للعقد إن وُجد اشتراك بيانات الأوبشن ورمز العقد
optSymEff = optSym == "" ? syminfo.tickerid : optSym
optLiveRaw = request.security(optSymEff, timeframe.period, close, lookahead=barmerge.lookahead_off)
optLive = optSym != "" ? optLiveRaw : na
optLivePct = not na(optLive) and optPrem > 0 ? 100.0 * (optLive - optPrem) / optPrem : na

var table optab = table.new(f_pos(optPosS), 2, 5, bgcolor=cPanl, border_width=1, border_color=color.new(#2A3245, 0))
if showOpt and barstate.islast
    hasDir = optDir != 0
    oCol = optDir > 0 ? cUp : optDir < 0 ? cDn : cMut
    table.cell(optab, 0, 0, "لوحة العقد" + (na(optLive) ? " — تقديري" : " — حي"), text_color=cTxt, bgcolor=cHead, text_size=size.small)
    table.cell(optab, 1, 0, inTrade ? "صفقة نشطة" : "ترقّب", text_color=oCol, bgcolor=cHead, text_size=size.small)
    table.cell(optab, 0, 1, "العقد المقترح", text_color=cMut, text_size=size.small)
    table.cell(optab, 1, 1, hasDir ? syminfo.ticker + " " + str.tostring(optStrk, format.mintick) + optCP + " · " + expTxt : "بانتظار حكم واضح", text_color=oCol, text_size=size.small)
    table.cell(optab, 0, 2, "أهداف العقد ≈", text_color=cMut, text_size=size.small)
    table.cell(optab, 1, 2, hasDir ? f_pctTxt(o1) + " · " + f_pctTxt(o2) + " · " + f_pctTxt(o3) : "—", text_color=hasDir ? cGold : cMut, text_size=size.small)
    table.cell(optab, 0, 3, na(optLive) ? "للسعر الحي" : "سعر العقد الحي", text_color=cMut, text_size=size.small)
    table.cell(optab, 1, 3, na(optLive) ? "ضع رمز العقد في الإعدادات" : str.tostring(optLive, format.mintick) + (na(optLivePct) ? "" : " · " + (optLivePct >= 0 ? "+" : "") + str.tostring(optLivePct, "#.#") + "% من دخولك"), text_color=na(optLive) ? cMut : optLivePct >= 0 ? cUp : cDn, text_size=size.small)
    table.cell(optab, 0, 4, "", text_size=size.tiny)
    table.cell(optab, 1, 4, "النسب تقديرية وتتأثر بالوقت والتذبذب", text_color=cMut, text_size=size.tiny)
