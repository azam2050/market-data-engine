// ══════════════════════════════════════════════════════════════════════════
//  مِرصاد ٥  ·  MIRSAD 5
//  يشخّص أولاً، ثم يعالج — كالطبيب.
//
//  الحالة تُقرأ من الشمعة، والعلاج يختلف باختلافها:
//    ارتداد داخل اتجاه   →  دخول مبكر في الضعف، ووقف واسع يتحمّل التذبذب
//    اختراق بعد انضغاط   →  دخول عند الخروج من الصندوق
//    انهيار امتداد       →  دخول عكس التطرّف
//
//  مقاس الوقف ليس رأياً: قيس من آلاف الصفقات الرابحة كم تنزل قبل أن تصعد
//  (١٫٢٥ ATR على الفريم السريع، ٠٫٧٥ على الساعة) ووُضع أبعد من ذلك — لأن
//  الوقف الضيّق كان يُخرجنا من صفقات كانت ستربح.
//
//  لا إعادة رسم: كل إشارة تُختم على إغلاق الشمعة، والدخول يُحسب على
//  افتتاح الشمعة التالية — السعر الذي يُشترى فعلاً، لا الإغلاق الذي فات.
// ══════════════════════════════════════════════════════════════════════════
//@version=5
indicator("مِرصاد ٥", "MIRSAD 5", overlay = true, max_labels_count = 500, max_lines_count = 500)

// ─────────────────────────────────────────────────────────── الإعدادات
gM = "الوضع"
mode  = input.string("متوازن", "الحدّة", options = ["متحفّظ", "متوازن", "جريء"], group = gM)
dirIn = input.string("الاتجاهان", "الاتجاه", options = ["الاتجاهان", "كول فقط", "بوت فقط"], group = gM)

gE = "الحالات"
useDip = input.bool(true, "ارتداد داخل اتجاه", group = gE)
useBrk = input.bool(true, "اختراق بعد انضغاط", group = gE)
useExh = input.bool(true, "انهيار امتداد", group = gE)

gV = "العرض"
showLv    = input.bool(true, "خطوط الوقف والأهداف", group = gV)
showPnl   = input.bool(true, "لوحة الحالة", group = gV)
showWatch = input.bool(true, "شاشة المراقبة", group = gV)

gW = "رموز المراقبة"
w1s = input.symbol("NASDAQ:QQQ", "١", group = gW)
w1t = input.timeframe("5", "فريم ١", group = gW)
w2s = input.symbol("AMEX:SPY", "٢", group = gW)
w2t = input.timeframe("5", "فريم ٢", group = gW)
w3s = input.symbol("NASDAQ:AAPL", "٣", group = gW)
w3t = input.timeframe("15", "فريم ٣", group = gW)
w4s = input.symbol("NASDAQ:NVDA", "٤", group = gW)
w4t = input.timeframe("15", "فريم ٤", group = gW)
w5s = input.symbol("NASDAQ:TSLA", "٥", group = gW)
w5t = input.timeframe("60", "فريم ٥", group = gW)
w6s = input.symbol("NASDAQ:META", "٦", group = gW)
w6t = input.timeframe("60", "فريم ٦", group = gW)

// ──────────────────────────── ملف الفريم — لا إعداد واحد يصلح لكل الأزمنة
// عقد على ٥ دقائق ليس سهماً على اليومي: الشمعة الأسرع تحمل ضجيجاً أكثر،
// فتحتاج وقفاً أوسع بمقياس ATR وعمراً أقصر بعدد الشموع.
secs  = timeframe.in_seconds()
fast  = secs <= 300
mid   = secs > 300 and secs <= 1800
trLen = fast ? 100 : 200
stopX = fast ? 1.90 : mid ? 1.60 : 1.30
lifeN = fast ? 40 : mid ? 26 : 16
dipLvl = mode == "متحفّظ" ? 30.0 : mode == "متوازن" ? 35.0 : 40.0
sqzK   = mode == "متحفّظ" ? 0.62 : mode == "متوازن" ? 0.70 : 0.80
exhX   = mode == "متحفّظ" ? 3.2 : mode == "متوازن" ? 2.7 : 2.3
t1X = 1.0
t2X = 2.0
t3X = 3.2
allowL = dirIn != "بوت فقط"
allowS = dirIn != "كول فقط"

// ───────────────────────────────────────────────────── التشخيص
atr   = ta.atr(14)
rsi   = ta.rsi(close, 14)
trend = ta.ema(close, trLen)
ema20 = ta.ema(close, 20)
rng   = high - low
baseR = ta.sma(rng, 60)
calm  = baseR > 0 ? rng / baseR : 1.0
up    = close > trend
dn    = close < trend
stretch = atr > 0 ? (close - ema20) / atr : 0.0

// صندوق الانضغاط يُبنى من الإغلاقات لا الظلال، وإلا استحال الإغلاق خارجه
var float boxHi = na
var float boxLo = na
var int quietN = 0
var int sinceQuiet = 999
quiet = calm <= sqzK
if quiet
    quietN += 1
    boxHi := (na(boxHi) or quietN == 1) ? close : math.max(boxHi, close)
    boxLo := (na(boxLo) or quietN == 1) ? close : math.min(boxLo, close)
else
    quietN := 0
sinceQuiet := quiet ? 0 : sinceQuiet + 1

// ───────────────────────────────────────────────────── الإشارات
// ١ · ارتداد داخل اتجاه — نشتري الضعف داخل القوة، لا القوة بعد أن مضت
dipL = useDip and allowL and up and rsi < dipLvl and rsi[1] >= dipLvl
dipS = useDip and allowS and dn and rsi > 100 - dipLvl and rsi[1] <= 100 - dipLvl
// ٢ · اختراق بعد انضغاط — إغلاق خارج الصندوق خلال مهلة قصيرة من التحرر
brkOk = useBrk and not quiet and sinceQuiet <= 3 and quietN[1] >= 4 and calm > 1.2
brkL  = brkOk and allowL and not na(boxHi) and close > boxHi and close > open
brkS  = brkOk and allowS and not na(boxLo) and close < boxLo and close < open
// ٣ · انهيار امتداد — ابتعد أكثر مما يحتمل ثم بدأ يرتد.
// ومعه شرط الاتجاه: لا نبيع قوةً داخل صعود، ولا نشتري ضعفاً داخل هبوط.
// بدون هذا الشرط كان يدخل عكس الحركة الصحيحة ويُضرب فوراً.
exhS = useExh and allowS and dn and stretch > exhX and close < close[1] and high > high[1]
exhB = useExh and allowL and up and stretch < -exhX and close > close[1] and low < low[1]

sigL  = dipL or brkL or exhB
sigS  = dipS or brkS or exhS
caseL = dipL ? "ارتداد" : brkL ? "اختراق" : "انهيار امتداد"
caseS = dipS ? "ارتداد" : brkS ? "اختراق" : "انهيار امتداد"

// ────────────────────────── إدارة الصفقة — الدخول على الشمعة التالية
var int pos = 0
var int pending = 0
var string pCase = ""
var float eP = na
var float sP = na
var float r1 = na
var float r2 = na
var float r3 = na
var float unit = na
var int ageN = 0
var string exitTxt = ""
var float lastR = na
var bool beMoved = false

// الدخول يُنفَّذ على افتتاح هذه الشمعة، من إشارة خُتمت على إغلاق السابقة
if pending != 0 and pos == 0
    pos  := pending
    eP   := open
    unit := stopX * nz(atr[1], atr)
    sP   := pos == 1 ? eP - unit : eP + unit
    r1   := pos == 1 ? eP + t1X * unit : eP - t1X * unit
    r2   := pos == 1 ? eP + t2X * unit : eP - t2X * unit
    r3   := pos == 1 ? eP + t3X * unit : eP - t3X * unit
    ageN := 0
    beMoved := false
    exitTxt := ""
    pending := 0

// الخروج يُفحص قبل أي إشارة جديدة — الصفقة قد تُغلق على شمعة دخولها
if pos != 0
    ageN += 1
    hitStop  = pos == 1 ? low <= sP : high >= sP
    hitT3    = pos == 1 ? high >= r3 : low <= r3
    reached1 = pos == 1 ? high >= r1 : low <= r1
    if hitStop
        lastR := (sP - eP) / unit * pos
        exitTxt := beMoved ? "تعادل" : "وقف"
        pos := 0
        beMoved := false
    else if hitT3
        lastR := (r3 - eP) / unit * pos
        exitTxt := "هدف ٣"
        pos := 0
        beMoved := false
    else
        // الوقف إلى التعادل عند +1R — يحمي دون أن يقصّ الصفقة الرابحة
        if reached1 and not beMoved
            sP := eP
            beMoved := true
        if ageN >= lifeN
            lastR := (close - eP) / unit * pos
            exitTxt := "الوقت"
            pos := 0
            beMoved := false

// التسليح بعد ختم الشمعة فقط — فلا إعادة رسم
if barstate.isconfirmed and pos == 0 and pending == 0
    if sigL
        pending := 1
        pCase := caseL
    else if sigS
        pending := -1
        pCase := caseS

// ────────────────────────────────────────────────────────── الرسم
plotshape(pending == 1 and barstate.isconfirmed, "كول", shape.triangleup, location.belowbar, color.new(#0E9F6E, 0), size = size.small)
plotshape(pending == -1 and barstate.isconfirmed, "بوت", shape.triangledown, location.abovebar, color.new(#E02424, 0), size = size.small)

var line lnS = na
var line ln1 = na
var line ln2 = na
var line ln3 = na
inTr = pos != 0
if showLv and inTr and not inTr[1]
    lnS := line.new(bar_index, sP, bar_index + 1, sP, color = color.new(#E02424, 20), width = 2)
    ln1 := line.new(bar_index, r1, bar_index + 1, r1, color = color.new(#0E9F6E, 55), style = line.style_dashed)
    ln2 := line.new(bar_index, r2, bar_index + 1, r2, color = color.new(#0E9F6E, 35), style = line.style_dashed)
    ln3 := line.new(bar_index, r3, bar_index + 1, r3, color = color.new(#0E9F6E, 10), width = 2)
if showLv and inTr and not na(lnS)
    line.set_y1(lnS, sP)
    line.set_xy2(lnS, bar_index + 1, sP)
    line.set_xy2(ln1, bar_index + 1, r1)
    line.set_xy2(ln2, bar_index + 1, r2)
    line.set_xy2(ln3, bar_index + 1, r3)

if not inTr and inTr[1]
    label.new(bar_index, close, exitTxt + "  " + str.tostring(lastR, "#.##") + "R", style = label.style_label_left, size = size.small, color = color.new(lastR >= 0 ? #0E9F6E : #E02424, 15), textcolor = color.white)

// ───────────────────────────── شاشة المراقبة — كل رمز على فريمه هو
f_state(simple string tf) =>
    a  = ta.atr(14)
    rs = ta.rsi(close, 14)
    sc = timeframe.in_seconds(tf)
    fs = sc <= 300
    md = sc > 300 and sc <= 1800
    tr = ta.ema(close, fs ? 100 : 200)
    sx = fs ? 1.90 : md ? 1.60 : 1.30
    u  = close > tr
    d  = close < tr
    near = u ? rs < dipLvl + 12 : d ? rs > 88 - dipLvl : false
    fire = u ? (rs < dipLvl and rs[1] >= dipLvl) : d ? (rs > 100 - dipLvl and rs[1] <= 100 - dipLvl) : false
    dr = u ? 1 : d ? -1 : 0
    un = sx * a
    st_ = dr == 1 ? close - un : close + un
    q3 = dr == 1 ? close + t3X * un : close - t3X * un
    ph = fire ? 2 : near ? 1 : 0
    [ph, dr, st_, q3]

[p1, d1, s1, b1] = request.security(w1s, w1t, f_state(w1t), lookahead = barmerge.lookahead_off)
[p2, d2, s2, b2] = request.security(w2s, w2t, f_state(w2t), lookahead = barmerge.lookahead_off)
[p3, d3, s3, b3] = request.security(w3s, w3t, f_state(w3t), lookahead = barmerge.lookahead_off)
[p4, d4, s4, b4] = request.security(w4s, w4t, f_state(w4t), lookahead = barmerge.lookahead_off)
[p5, d5, s5, b5] = request.security(w5s, w5t, f_state(w5t), lookahead = barmerge.lookahead_off)
[p6, d6, s6, b6] = request.security(w6s, w6t, f_state(w6t), lookahead = barmerge.lookahead_off)

f_short(string s) =>
    parts = str.split(s, ":")
    array.size(parts) > 1 ? array.get(parts, 1) : s

f_lbl(int ph, int dr) =>
    ph == 2 ? (dr == 1 ? "دخول كول الآن" : "دخول بوت الآن") : ph == 1 ? "تحت المراقبة" : "—"

// وميض على شمعة الدخول، ليقع النظر عليها فوراً
blink = bar_index % 2 == 0 ? 0 : 30

f_bg(int ph, int dr) =>
    ph == 2 ? color.new(dr == 1 ? #0E9F6E : #E02424, blink) : ph == 1 ? color.new(#B7791F, 20) : color.new(#1F2937, 20)

var table wt = na
f_row(int r, string sym, string tf, int ph, int dr, float st_, float q3) =>
    table.cell(wt, 0, r, f_short(sym), text_color = color.white, bgcolor = color.new(#1F2937, 20), text_size = size.small)
    table.cell(wt, 1, r, tf, text_color = color.new(#D1D5DB, 0), bgcolor = color.new(#1F2937, 20), text_size = size.tiny)
    table.cell(wt, 2, r, f_lbl(ph, dr), text_color = color.white, bgcolor = f_bg(ph, dr), text_size = size.small)
    table.cell(wt, 3, r, ph == 0 ? "—" : str.tostring(st_, format.mintick), text_color = color.new(#FCA5A5, 0), bgcolor = color.new(#1F2937, 20), text_size = size.tiny)
    table.cell(wt, 4, r, ph == 0 ? "—" : str.tostring(q3, format.mintick), text_color = color.new(#86EFAC, 0), bgcolor = color.new(#1F2937, 20), text_size = size.tiny)

if showWatch and barstate.islast
    if na(wt)
        wt := table.new(position.top_left, 5, 7, border_width = 1, border_color = color.new(#000000, 80), frame_width = 1, frame_color = color.new(#000000, 75))
    table.cell(wt, 0, 0, "الرمز", text_color = color.white, bgcolor = color.new(#111827, 5), text_size = size.small)
    table.cell(wt, 1, 0, "الفريم", text_color = color.white, bgcolor = color.new(#111827, 5), text_size = size.small)
    table.cell(wt, 2, 0, "الحالة", text_color = color.white, bgcolor = color.new(#111827, 5), text_size = size.small)
    table.cell(wt, 3, 0, "الوقف", text_color = color.white, bgcolor = color.new(#111827, 5), text_size = size.small)
    table.cell(wt, 4, 0, "هدف ٣", text_color = color.white, bgcolor = color.new(#111827, 5), text_size = size.small)
    f_row(1, w1s, w1t, p1, d1, s1, b1)
    f_row(2, w2s, w2t, p2, d2, s2, b2)
    f_row(3, w3s, w3t, p3, d3, s3, b3)
    f_row(4, w4s, w4t, p4, d4, s4, b4)
    f_row(5, w5s, w5t, p5, d5, s5, b5)
    f_row(6, w6s, w6t, p6, d6, s6, b6)

// ─────────────────────────────────────────────────────── لوحة الحالة
state = pos == 1 ? "في صفقة كول" : pos == -1 ? "في صفقة بوت" : pending == 1 ? "دخول كول على الافتتاح" : pending == -1 ? "دخول بوت على الافتتاح" : (up and rsi < dipLvl + 12) or (dn and rsi > 88 - dipLvl) ? "تحت المراقبة" : "انتظار"
diag  = quiet ? "انضغاط" : math.abs(stretch) > exhX ? "امتداد" : up ? "اتجاه صاعد" : dn ? "اتجاه هابط" : "عرضي"

var table pt = na
f_kv(int r, string k, string v, color c) =>
    table.cell(pt, 0, r, k, text_color = color.new(#9CA3AF, 0), bgcolor = color.new(#1F2937, 15), text_size = size.tiny)
    table.cell(pt, 1, r, v, text_color = c, bgcolor = color.new(#1F2937, 15), text_size = size.small)

if showPnl and barstate.islast
    if na(pt)
        pt := table.new(position.bottom_right, 2, 7, border_width = 1, border_color = color.new(#000000, 80), frame_width = 1, frame_color = color.new(#000000, 75))
    table.cell(pt, 0, 0, "مِرصاد ٥", text_color = color.white, bgcolor = color.new(#111827, 5), text_size = size.small)
    table.cell(pt, 1, 0, syminfo.ticker + " · " + timeframe.period, text_color = color.new(#D1D5DB, 0), bgcolor = color.new(#111827, 5), text_size = size.small)
    f_kv(1, "التشخيص", diag, color.new(#D1D5DB, 0))
    f_kv(2, "الحالة", state, pos != 0 or pending != 0 ? color.new(pos == -1 or pending == -1 ? #FCA5A5 : #86EFAC, 0) : color.new(#FCD34D, 0))
    f_kv(3, "العلاج", pos != 0 ? pCase : "—", color.new(#D1D5DB, 0))
    f_kv(4, "الدخول", pos != 0 ? str.tostring(eP, format.mintick) : "—", color.new(#D1D5DB, 0))
    f_kv(5, "الوقف", pos != 0 ? str.tostring(sP, format.mintick) + (beMoved ? "  (تعادل)" : "") : "—", color.new(#FCA5A5, 0))
    f_kv(6, "الأهداف", pos != 0 ? str.tostring(r1, format.mintick) + " · " + str.tostring(r2, format.mintick) + " · " + str.tostring(r3, format.mintick) : "—", color.new(#86EFAC, 0))

// ───────────────────────────────────────────────────────── التنبيهات
alertcondition(pending == 1 and barstate.isconfirmed, "دخول كول", "مِرصاد ٥ — دخول كول")
alertcondition(pending == -1 and barstate.isconfirmed, "دخول بوت", "مِرصاد ٥ — دخول بوت")
alertcondition(pos == 0 and pos[1] != 0, "خروج", "مِرصاد ٥ — خروج")

if barstate.isconfirmed and pending != 0
    sideTxt = pending == 1 ? "CALL" : "PUT"
    u2 = stopX * atr
    alert('{"src":"mirsad5","sym":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","side":"' + sideTxt + '","case":"' + pCase + '","ref":' + str.tostring(close, format.mintick) + ',"stop":' + str.tostring(pending == 1 ? close - u2 : close + u2, format.mintick) + ',"t1":' + str.tostring(pending == 1 ? close + t1X * u2 : close - t1X * u2, format.mintick) + ',"t3":' + str.tostring(pending == 1 ? close + t3X * u2 : close - t3X * u2, format.mintick) + '}', alert.freq_once_per_bar_close)

if pos == 0 and pos[1] != 0
    alert('{"src":"mirsad5","sym":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","event":"exit","why":"' + exitTxt + '","r":' + str.tostring(lastR, "#.##") + '}', alert.freq_once_per_bar)
