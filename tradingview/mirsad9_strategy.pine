// ══════════════════════════════════════════════════════════════════════════
//  مِرصاد ٩ — نسخة الاختبار  ·  MIRSAD 9 TEST
//  نفس المؤشر حرفياً، وأوامره تُمرَّر إلى Strategy Tester ليحسب النتائج.
//
//  محرك واحد: شمعة اندفاع تُغلق قوية وتكسر قمة (أو قاع) الشموع التي قبلها.
//  وفوقه أربعة أشياء رأيناها ناقصة في غيره:
//
//    الصدق في السعر     سعر العلامة هو سعر الدخول الذي تحصل عليه فعلاً:
//                       افتتاح الشمعة التالية أو مستوى المنطقة. لا سعر شمعة فاتت.
//    الوقف يُحترم       الصفقة تموت عند الوقف، ولا ● على هدف بعده.
//    فلتر العرضي        لا كول ثم بوت ثم كول في ساعة واحدة: ADX + صندوق آخر
//                       ٣٠ شمعة + فترة راحة بعد كل إشارة.
//    الجودة             درجة من ١٠٠ على كل إشارة: قوة الشمعة، حجم الكسر،
//                       توافق الفريم الأكبر، قوة الاتجاه، الحجم.
//
//  المنطقة: خط برتقالي متقطع عند متوسط ٩. الدخول الأول عند لمسه، والدخول
//  الثاني حين يرتد السعر إليه بعد صفقة لم تُوقف. التأمين: تنبيه «بع النصف»
//  عند نسبة من الطريق إلى الهدف الثالث، ويُنقل الوقف إلى الدخول.
//  لا إعادة رسم: الإشارة تُختم على الإغلاق، والدخول على افتتاح التالية.
// ══════════════════════════════════════════════════════════════════════════
//@version=5
strategy("مِرصاد ٩ — اختبار", "MIRSAD 9 TEST", overlay = true, max_labels_count = 500, max_lines_count = 500, initial_capital = 100000, default_qty_type = strategy.fixed, default_qty_value = 100, commission_type = strategy.commission.percent, commission_value = 0.02, slippage = 1)

// ─────────────────────────────────────────────────────────── الإعدادات
gM = "الوضع"
dirIn   = input.string("الاتجاهان", "الاتجاه", options = ["الاتجاهان", "كول فقط", "بوت فقط"], group = gM)
entryIn = input.string("منطقة ثم تأكيد: لا تفوت", "الدخول", options = ["منطقة ثم تأكيد: لا تفوت", "منطقة دخول: انتظار الرجوع لمتوسط ٩", "فوري: افتتاح الشمعة التالية"], group = gM, tooltip = "منطقة ثم تأكيد: يُرسم خط عند متوسط ٩، فإن رجع السعر إليه دخلت عنده، وإن لم يرجع وأغلقت شمعة فوق قمة شمعة الإشارة دخلت على افتتاح التالية. لا تفوت إشارة. في الاختبار على ٣ دقائق: ٥٥٪ حركة أولى معك. منطقة فقط: ٦٥٪ لكن ثلاثة أرباع الإشارات تفوت. فوري: ٥٠٪ ولا تفوت")
lifeN   = input.int(5, "صلاحية الدخول الأول في المنطقة (شموع)", minval = 1, maxval = 10, group = gM)
chaseN  = input.int(8, "التأكيد: إغلاق فوق قمة شمعة الإشارة خلال N شموع", minval = 2, maxval = 20, group = gM)
maxChase = input.float(1.5, "لا تأكيد إن ابتعد السعر عن المنطقة أكثر من × ATR", minval = 0.5, maxval = 4.0, step = 0.25, group = gM, tooltip = "يمنع مطاردة السعر في قمة الحركة: إن كان إغلاق شمعة التأكيد أبعد من هذا عن خط المنطقة تُترك الإشارة. في الاختبار: ٥٨٪ حركة أولى معك مقابل ٥٥٪ بلا الحد، مع ثلثي الإشارات")
reEntry = input.bool(true, "دخول ثانٍ حين يرتد السعر إلى المنطقة", group = gM, tooltip = "بعد صفقة أولى لم تُوقف، إن رجع السعر إلى خط المنطقة خلال مدة بقائها يُفتح دخول ثانٍ. لا دخول ثانٍ بعد وقف: السعر اخترق المنطقة")
reLife  = input.int(40, "المنطقة تبقى للدخول الثاني (شموع)", minval = 5, maxval = 120, group = gM)
minQ    = input.int(0, "أدنى جودة مقبولة (٠ = الكل)", minval = 0, maxval = 90, step = 5, group = gM)
fmX     = input.float(1.0, "مقياس الحركة الأولى (× ATR)", minval = 0.25, maxval = 3.0, step = 0.25, group = gM)

gE = "محرك الاندفاع"
bodyK   = input.float(0.8, "جسم الشمعة ≥ × ATR", minval = 0.3, maxval = 2.0, step = 0.1, group = gE)
closeP  = input.float(0.65, "الإغلاق في أعلى/أدنى هذا الجزء من الشمعة", minval = 0.5, maxval = 0.9, step = 0.05, group = gE)
brkN    = input.int(6, "تكسر قمة/قاع آخر N شمعة", minval = 3, maxval = 20, group = gE)
orbN    = input.int(20, "كسر مدى الافتتاح: خلال أول N شمعة (٠ = إيقاف)", minval = 0, maxval = 60, group = gE, tooltip = "أول إغلاق قوي فوق قمة شمعة الافتتاح (أو تحت قاعها) في أول N شمعة من الجلسة يُقبل إشارة، حتى لو لم يتجاوز قمم أمس. في الاختبار لم يغيّر النسبة وأضاف إشارات الصباح")
revK    = input.float(1.5, "شمعة انعكاس ضخمة: جسمها ≥ × ATR تكفي بكسر الشمعة السابقة فقط (٠ = إيقاف)", minval = 0, maxval = 4.0, step = 0.25, group = gE, tooltip = "في القاع أو القمة الحادة تأتي شمعة ضخمة تُغلق فوق قمة الشمعة السابقة لكنها لا تتجاوز قمة الشموع الست لأن الافتتاح كان أعلى. هذه تُقبل إشارة. في الاختبار لم تغيّر النسبة وزادت الإشارات قليلاً")

gF = "فلتر العرضي والانقلاب"
adxOn   = input.bool(true, "حجب الإشارة في العرضي (ADX داخل الصندوق)", group = gF)
adxLvl  = input.float(18, "ADX تحته عرضي", minval = 10, maxval = 30, group = gF)
boxN    = input.int(30, "صندوق العرضي: آخر N شمعة", minval = 10, maxval = 60, group = gF)
coolN   = input.int(8, "راحة بعد كل إشارة (شموع) — لا انقلاب قبلها", minval = 0, maxval = 30, group = gF)
htfOn   = input.bool(false, "حجب الإشارة ضد الفريم الأكبر (متوسط ٩ و٢١ على ٣× الفريم)", group = gF, tooltip = "مطفأ: اتجاه الفريم الأكبر يدخل في درجة الجودة فقط ولا يحجب. مشتغل: يحجب كل إشارة ضده — يقطع نصف الإشارات ويتأخر عن الانعكاسات، ورفع النسبة قليلاً في الاختبار")
skipOpen = input.int(1, "تجاهل أول N شمعة في الجلسة", minval = 0, maxval = 6, group = gF)

gS = "الوقف والأهداف والتأمين"
stopX  = input.float(1.5, "الوقف = × ATR من الدخول", minval = 0.5, maxval = 3.0, step = 0.25, group = gS)
tgtMode = input.string("× ATR", "الأهداف تُحسب", options = ["× ATR", "بالدولار"], group = gS)
x1 = input.float(1.0, "هدف ١ = × ATR", minval = 0.25, step = 0.25, group = gS)
x2 = input.float(2.0, "هدف ٢ = × ATR", minval = 0.5, step = 0.25, group = gS)
x3 = input.float(3.0, "هدف ٣ = × ATR", minval = 1.0, step = 0.25, group = gS)
usd1 = input.float(1.5, "هدف ١ بالدولار", minval = 0.1, step = 0.5, group = gS)
usd2 = input.float(2.5, "هدف ٢ بالدولار", minval = 0.1, step = 0.5, group = gS)
usd3 = input.float(4.0, "هدف ٣ بالدولار", minval = 0.1, step = 0.5, group = gS)
secPct = input.float(35, "تنبيه التأمين «بع النصف» عند ٪ من الطريق إلى هدف ٣", minval = 10, maxval = 90, step = 5, group = gS, tooltip = "حين يقطع السعر هذه النسبة من المسافة بين الدخول والهدف الثالث: تنبيه على الشارت والجوال ببيع نصف الكمية، ويُنقل الوقف إلى سعر الدخول فتصير الصفقة مؤمَّنة")
trailN = input.int(3, "بعد هدف ٢: الوقف يتبع قاع/قمة آخر N شمعة", minval = 2, maxval = 15, group = gS)
eodOut = input.bool(true, "إغلاق الصفقة آخر الجلسة (لا مبيت)", group = gS)

gV = "العرض"
showLv = input.bool(true, "الوقف والأهداف", group = gV)
showPnl = input.bool(true, "لوحة الصفقة", group = gV)
showTf = input.bool(true, "صفّا الفريمين ٣ و٥", group = gV)
watchPos = input.string("يسار الوسط", "مكان شاشة المراقبة", options = ["يسار الوسط", "أعلى اليسار", "أسفل اليسار", "أعلى الوسط"], group = gV)


allowL = dirIn != "بوت فقط"
allowS = dirIn != "كول فقط"
chaseOn = entryIn == "منطقة ثم تأكيد: لا تفوت"
waitZone = chaseOn or entryIn == "منطقة دخول: انتظار الرجوع لمتوسط ٩"

// ═══════════════════════════ المطبخ ═══════════════════════════════════
// كل شيء في دالة واحدة كي تعمل على الشارت وعلى رموز المراقبة بالمنطق نفسه.
f_core() =>
    a = ta.atr(14)
    e9 = ta.ema(close, 9)
    // الفريم الأكبر (٣×) بمتوسطي ٩ و٢١ يعادل على هذا الفريم متوسطي ٢٧ و٦٣
    eH1 = ta.ema(close, 27)
    eH2 = ta.ema(close, 63)
    [dip, dim, adx] = ta.dmi(14, 14)
    vAvg = ta.sma(volume, 20)
    boxH = ta.highest(high, boxN)[1]
    boxL = ta.lowest(low, boxN)[1]
    rng = high - low
    body = close - open
    // موضع الشمعة في الجلسة
    barDay = (hour(time, "America/New_York") * 60 + minute(time, "America/New_York") - 570) / math.max(timeframe.in_seconds() / 60, 1)
    barsToday = int(math.max(barDay, 0))
    // قمة/قاع الشموع السابقة داخل الجلسة فقط: لا تُقارن شمعة الصباح بشموع الأمس
    hiN = high[1]
    loN = low[1]
    for k = 2 to brkN
        if k <= barsToday
            hiN := math.max(hiN, high[k])
            loN := math.min(loN, low[k])
    // مدى شمعة الافتتاح
    var float orHi = na
    var float orLo = na
    if session.isfirstbar_regular
        orHi := high
        orLo := low
    // شمعة الاندفاع
    impL = rng > 0 and body >= bodyK * a and (close - low) / rng >= closeP and close > hiN
    impS = rng > 0 and -body >= bodyK * a and (high - close) / rng >= closeP and close < loN
    // شمعة الانعكاس الضخمة في القاع/القمة الحادة: تكسر الشمعة السابقة فقط
    revL = revK > 0 and rng > 0 and body >= revK * a and (close - low) / rng >= closeP and close > high[1]
    revS = revK > 0 and rng > 0 and -body >= revK * a and (high - close) / rng >= closeP and close < low[1]
    // كسر مدى الافتتاح: أول إغلاق قوي فوق قمة شمعة الافتتاح (أو تحت قاعها) في أول N شمعة
    orbL = orbN > 0 and barsToday >= 1 and barsToday <= orbN and not na(orHi) and rng > 0 and body >= bodyK * a and (close - low) / rng >= closeP and close > orHi and close[1] <= orHi
    orbS = orbN > 0 and barsToday >= 1 and barsToday <= orbN and not na(orLo) and rng > 0 and -body >= bodyK * a and (high - close) / rng >= closeP and close < orLo and close[1] >= orLo
    side0 = impL or revL or orbL ? 1 : impS or revS or orbS ? -1 : 0
    // الجودة من ١٠٠
    margin = side0 == 1 ? close - hiN : side0 == -1 ? loN - close : 0.0
    htfOk = side0 == 1 ? eH1 > eH2 : side0 == -1 ? eH1 < eH2 : false
    q = 30.0 * math.min(math.abs(body) / a, 2.0) / 2.0 + 20.0 * math.min(math.max(margin, 0.0) / a, 1.0) + (htfOk ? 20.0 : 0.0) + 15.0 * math.min(adx / 40.0, 1.0) + (vAvg > 0 ? 15.0 * math.min(volume / vAvg, 2.0) / 2.0 : 0.0)
    // الفلاتر
    boxW = boxH - boxL
    insideBox = close > boxL + 0.25 * boxW and close < boxH - 0.25 * boxW
    sideways = adxOn and adx < adxLvl and insideBox
    // الجلسة: لا أول شمعة (فجوة لا حركة) ولا آخر ربع ساعة
    lateBar = hour(time, "America/New_York") == 15 and minute(time, "America/New_York") >= 45
    // الراحة: لا إشارة (بأي اتجاه) خلال N شموع بعد إشارة مقبولة
    var int lastBar = -100000
    var int lastSide = 0
    ready = bar_index >= 120 and not na(a) and not na(eH2) and not na(adx)
    inCool = bar_index - lastBar <= coolN
    okL = ready and allowL and side0 == 1 and not sideways and (not htfOn or htfOk) and q >= minQ and not inCool and barDay >= skipOpen and not lateBar
    okS = ready and allowS and side0 == -1 and not sideways and (not htfOn or htfOk) and q >= minQ and not inCool and barDay >= skipOpen and not lateBar
    if barstate.isconfirmed and (okL or okS)
        lastBar := bar_index
        lastSide := okL ? 1 : -1
    // لماذا حُجبت: للوحة فقط
    blockTxt = side0 == 0 ? "" : inCool ? "راحة" : sideways ? "عرضي" : (htfOn and not htfOk) ? "ضد الفريم الأكبر" : q < minQ ? "جودة منخفضة" : ""
    state = sideways ? 9 : eH1 > eH2 ? 1 : -1
    [okL, okS, q, a, e9, state, blockTxt, side0]

// ═══════════════════════════ إدارة الصفقة ═════════════════════════════
// الدخول على افتتاح الشمعة التالية أو عند لمس المنطقة. الوقف ثابت × ATR.
// التأمين: عند نسبة من الطريق إلى هدف ٣ يُباع النصف ويُنقل الوقف إلى الدخول.
// هدف ٢ يرفع الوقف إلى هدف ١ ويتبع الهيكل، هدف ٣ يُقفل. الوقف يُحترم دائماً.
f_trade(bool sigL, bool sigS, float q0, float a, float e9) =>
    var int pSide = 0
    var float pLvl = na
    var int pExp = 0
    var int pBorn = 0
    var float pHi = na
    var float pLo = na
    var float pAtr = na
    var float pQ = na
    var int eMode = 0
    // المنطقة الحية: للدخول الأول ثم الدخول الثاني عند الارتداد
    var int zSide = 0
    var float zLvl = na
    var int zBorn = 0
    var int zUses = 0
    var bool zStopped = false
    var bool fmOn = false
    var float fmUp = na
    var float fmDn = na
    var int fmBars = 0
    var int fmWin = 0
    var int fmTot = 0
    var int pos = 0
    var int pend = 0
    var bool viaZone = false
    var float fillLvl = na
    var float eP = na
    var float sP = na
    var float t1 = na
    var float t2 = na
    var float t3 = na
    var float qT = na
    var int hit = 0
    var bool secured = false
    var bool half = false
    var float halfLvl = na
    var int nth = 0
    var int barsIn = 0
    var string exitTxt = ""
    var float lastR = na
    var float unit = na
    closed = false
    secNow = false
    trailLo = ta.lowest(low, trailN)
    trailHi = ta.highest(high, trailN)
    lastBar = eodOut and hour(time, "America/New_York") == 15 and minute(time, "America/New_York") >= 55
    // الدخول الأول: لمس المنطقة خلال صلاحيتها
    touched = barstate.isconfirmed and pos == 0 and pend == 0 and pSide != 0 and bar_index <= pExp and (pSide == 1 ? low <= pLvl : high >= pLvl)
    // الدخول الثاني: ارتداد إلى المنطقة بعد صفقة أولى لم تُوقف
    reTouch = reEntry and barstate.isconfirmed and pos == 0 and pend == 0 and pSide == 0 and zSide != 0 and zUses == 1 and not zStopped and bar_index <= zBorn + reLife and (zSide == 1 ? low <= zLvl : high >= zLvl)
    // التأكيد: لم يرجع السعر، وأغلقت شمعة فوق قمة شمعة الإشارة (أو تحت قاعها) — الدخول على افتتاح التالية
    chased = chaseOn and barstate.isconfirmed and pos == 0 and pend == 0 and pSide != 0 and not touched and bar_index <= pBorn + chaseN and (pSide == 1 ? close > pHi : close < pLo) and math.abs(close - pLvl) <= maxChase * pAtr
    if touched
        pend := pSide
        pSide := 0
        viaZone := true
        fillLvl := pLvl
        zUses := 1
        eMode := 1
    else if chased
        pend := pSide
        pSide := 0
        viaZone := false
        zUses := 1
        eMode := 2
    else if reTouch
        pend := zSide
        viaZone := true
        fillLvl := zLvl
        zUses := 2
        eMode := 3
    if pend != 0 and pos == 0 and not na(a[1])
        pos := pend
        nth := zUses
        // السعر الصادق: افتتاح هذه الشمعة، أو مستوى المنطقة إن لُمست
        eP := viaZone ? (pos == 1 ? math.min(open, fillLvl) : math.max(open, fillLvl)) : open
        aRef = touched ? pAtr : a[1]
        qT := touched ? pQ : q0[1]
        unit := stopX * aRef
        sP := pos == 1 ? eP - unit : eP + unit
        fmOn := true
        fmBars := 0
        fmUp := pos == 1 ? eP + fmX * aRef : eP - fmX * aRef
        fmDn := pos == 1 ? eP - fmX * aRef : eP + fmX * aRef
        m1 = tgtMode == "بالدولار" ? usd1 : x1 * aRef
        m2 = tgtMode == "بالدولار" ? usd2 : x2 * aRef
        m3 = tgtMode == "بالدولار" ? usd3 : x3 * aRef
        t1 := pos == 1 ? eP + m1 : eP - m1
        t2 := pos == 1 ? eP + m2 : eP - m2
        t3 := pos == 1 ? eP + m3 : eP - m3
        halfLvl := pos == 1 ? eP + secPct / 100.0 * m3 : eP - secPct / 100.0 * m3
        hit := 0
        secured := false
        half := false
        barsIn := 0
        exitTxt := ""
        pend := 0
        viaZone := false
    else if pend != 0 and pos == 0
        pend := 0
        viaZone := false
    if fmOn
        fmBars += 1
        side_ = fmUp > fmDn ? 1 : -1
        agn = side_ == 1 ? low <= fmDn : high >= fmDn
        wth = side_ == 1 ? high >= fmUp : low <= fmUp
        if agn or wth or fmBars > 20
            fmTot += 1
            if wth and not agn
                fmWin += 1
            fmOn := false
    if pos != 0
        barsIn += 1
        hitStop = pos == 1 ? low <= sP : high >= sP
        if hitStop
            // الوقف يُحترم: الصفقة تموت هنا ولا ● بعدها
            lastR := (sP - eP) / unit * pos
            exitTxt := (sP - eP) * pos > 0 ? "خروج بربح" : (sP - eP) * pos == 0 ? "خروج على التعادل" : "وقف"
            if (sP - eP) * pos < 0
                zStopped := true
            pos := 0
            closed := true
        else
            if pos == 1
                hit := high >= t3 ? 3 : high >= t2 ? 2 : high >= t1 ? 1 : hit
            else
                hit := low <= t3 ? 3 : low <= t2 ? 2 : low <= t1 ? 1 : hit
            // التأمين: بع النصف وانقل الوقف إلى الدخول
            if not half and (pos == 1 ? high >= halfLvl : low <= halfLvl)
                half := true
                secNow := true
            if hit >= 3
                lastR := (t3 - eP) / unit * pos
                exitTxt := "هدف ٣"
                pos := 0
                closed := true
            else if lastBar and barstate.isconfirmed
                lastR := (close - eP) / unit * pos
                exitTxt := "إغلاق الجلسة"
                pos := 0
                closed := true
            else
                if half or hit >= 1
                    sP := pos == 1 ? math.max(sP, eP) : math.min(sP, eP)
                if hit >= 2
                    sP := pos == 1 ? math.max(sP, t1, trailLo) : math.min(sP, t1, trailHi)
                secured := pos == 1 ? sP >= eP : sP <= eP
    if barstate.isconfirmed and pos == 0 and pend == 0 and not closed
        side0 = sigL ? 1 : sigS ? -1 : 0
        if side0 != 0
            lvl = side0 == 1 ? math.min(e9, close) : math.max(e9, close)
            zSide := side0
            zLvl := lvl
            zBorn := bar_index
            zStopped := false
            if waitZone
                pSide := side0
                pLvl := lvl
                pExp := bar_index + lifeN
                pBorn := bar_index
                pHi := high
                pLo := low
                pAtr := a
                pQ := q0
                zUses := 0
            else
                pend := side0
                zUses := 1
                eMode := 0
    if pSide != 0 and (bar_index > (chaseOn ? math.max(pExp, pBorn + chaseN) : pExp) or pos != 0)
        pSide := 0
    // المنطقة تموت: انتهت مدتها، أو استُعملت مرتين، أو أُوقفت الصفقة، أو فاتت بلا دخول
    if zSide != 0 and pos == 0 and pend == 0 and (bar_index > zBorn + reLife or zUses >= 2 or zStopped or (zUses == 0 and pSide == 0))
        zSide := 0
    [pos, pend, eP, sP, t1, t2, t3, hit, secured, barsIn, closed, exitTxt, lastR, pSide, pLvl, fmWin, fmTot, qT, zSide, zLvl, zBorn, zUses, zStopped, half, halfLvl, secNow, nth, eMode]

// ═══════════════════════════ الشارت ═══════════════════════════════════
[sigL, sigS, qv, atrv, e9v, state, blockTxt, rawSide] = f_core()
[pos, pend, eP, sP, t1, t2, t3, hit, secured, barsIn, closed, exitTxt, lastR, pSide, pLvl, fmWin, fmTot, qT, zSide, zLvl, zBorn, zUses, zStopped, half, halfLvl, secNow, nth, eMode] = f_trade(sigL, sigS, qv, atrv, e9v)
eWord = eMode == 1 ? "دخول من المنطقة " : eMode == 2 ? "دخول تأكيد " : eMode == 3 ? "دخول ثاني " : "دخول "
newZone = barstate.isconfirmed and zSide != 0 and (zSide[1] == 0 or zBorn != zBorn[1])
zoneGone = zSide == 0 and zSide[1] != 0
entered = pos != 0 and pos[1] == 0
missed  = barstate.isconfirmed and pSide == 0 and pSide[1] != 0 and pos == 0 and pend == 0
reArm = reEntry and barstate.isconfirmed and zSide != 0 and zUses == 1 and not zStopped and pos == 0 and pos[1] != 0

cUp = #0E9F6E
cDn = #E02424
cZone = #F59E0B

// الأوامر — تطابق إدارة المؤشر تماماً:
//   الإشارة تُختم على الإغلاق، فيدخل الاختبار على افتتاح الشمعة التالية
//   الوقف والهدف الثالث يُحدَّثان كل شمعة كما يتحرّكان في المؤشر
if barstate.isconfirmed and pend == 1
    strategy.entry("كول", strategy.long)
if barstate.isconfirmed and pend == -1
    strategy.entry("بوت", strategy.short)
if newZone
    strategy.cancel("كول")
    strategy.cancel("بوت")
    if pSide == 1
        strategy.entry("كول", strategy.long, limit = pLvl)
    else
        strategy.entry("بوت", strategy.short, limit = pLvl)
if reArm
    if zSide == 1
        strategy.entry("كول", strategy.long, limit = zLvl)
    else
        strategy.entry("بوت", strategy.short, limit = zLvl)
if missed or zoneGone
    strategy.cancel("كول")
    strategy.cancel("بوت")
if pos != 0 and strategy.position_size != 0
    strategy.exit("خروج", from_entry = pos == 1 ? "كول" : "بوت", stop = sP, limit = t3)
if pos == 0 and strategy.position_size != 0 and closed
    strategy.close_all()

// كول / بوت مع الجودة — تُختم على إغلاق شمعة الإشارة
if barstate.isconfirmed and pend == 1
    label.new(bar_index, low, "كول " + str.tostring(qv, "#"), style = label.style_label_up, color = color.new(cUp, 0), textcolor = color.white, size = size.small)
if barstate.isconfirmed and pend == -1
    label.new(bar_index, high, "بوت " + str.tostring(qv, "#"), style = label.style_label_down, color = color.new(cDn, 0), textcolor = color.white, size = size.small)
if barstate.isconfirmed and pSide != 0 and pSide[1] == 0
    label.new(bar_index, pSide == 1 ? low : high, (pSide == 1 ? "كول " : "بوت ") + str.tostring(qv, "#"), style = pSide == 1 ? label.style_label_up : label.style_label_down, color = color.new(pSide == 1 ? cUp : cDn, 0), textcolor = color.white, size = size.small)
// سعر الدخول الصادق يُكتب على شمعة الدخول نفسها — والدخول الثاني باسمه
if entered
    label.new(bar_index, eP, eWord + str.tostring(eP, format.mintick), style = pos == 1 ? label.style_label_up : label.style_label_down, color = color.new(#111827, 15), textcolor = pos == 1 ? color.new(#86EFAC, 0) : color.new(#FCA5A5, 0), size = size.tiny)

// المنطقة: خط برتقالي متقطع يعيش لمدة الدخول الثاني، ويُقصّ حين تموت
var line zl = na
var label zlab = na
if newZone
    zl := line.new(bar_index, zLvl, bar_index + reLife, zLvl, color = color.new(cZone, 0), style = line.style_dashed, width = 2)
    zlab := label.new(bar_index + reLife, zLvl, zSide == 1 ? "منطقة كول" : "منطقة بوت", style = label.style_label_left, color = color.new(cZone, 15), textcolor = color.black, size = size.small)
if zoneGone and not na(zl)
    line.set_x2(zl, bar_index)
    label.set_x(zlab, bar_index)
    label.set_text(zlab, label.get_text(zlab) + (zUses[1] == 0 ? " · فاتت" : zStopped[1] ? " · انتهت" : zUses[1] >= 2 ? " · دخولان" : " · انتهت"))
    label.set_color(zlab, color.new(#374151, 30))
    label.set_textcolor(zlab, color.new(#D1D5DB, 0))

// الوقف والأهداف
var line lnS = na
var line ln1 = na
var line ln2 = na
var line ln3 = na
var line lnH = na
inTr = pos != 0
if showLv and inTr and not inTr[1]
    lnS := line.new(bar_index, sP, bar_index + 1, sP, color = color.new(cDn, 10), width = 2)
    ln1 := line.new(bar_index, t1, bar_index + 1, t1, color = color.new(cUp, 55), style = line.style_dashed)
    ln2 := line.new(bar_index, t2, bar_index + 1, t2, color = color.new(cUp, 35), style = line.style_dashed)
    ln3 := line.new(bar_index, t3, bar_index + 1, t3, color = color.new(cUp, 10), width = 2)
    lnH := line.new(bar_index, halfLvl, bar_index + 1, halfLvl, color = color.new(cZone, 40), style = line.style_dotted)
if showLv and inTr and not na(lnS)
    line.set_y1(lnS, sP)
    line.set_xy2(lnS, bar_index + 1, sP)
    line.set_xy2(ln1, bar_index + 1, t1)
    line.set_xy2(ln2, bar_index + 1, t2)
    line.set_xy2(ln3, bar_index + 1, t3)
    line.set_xy2(lnH, bar_index + 1, halfLvl)
// ● على الهدف لحظة تحققه — ولا ● بعد الوقف لأن الصفقة تكون قد ماتت
if inTr and hit >= 1 and hit[1] < 1
    label.new(bar_index, t1, "● هدف ١", style = label.style_label_left, color = color.new(cUp, 30), textcolor = color.white, size = size.tiny)
if inTr and hit >= 2 and hit[1] < 2
    label.new(bar_index, t2, "● هدف ٢", style = label.style_label_left, color = color.new(cUp, 20), textcolor = color.white, size = size.tiny)
// التأمين: تنبيه على الشارت ببيع النصف
if secNow
    label.new(bar_index, halfLvl, "🔔 أمّن الصفقة — بع النصف · الوقف عند الدخول", style = pos == 1 ? label.style_label_down : label.style_label_up, color = color.new(cZone, 0), textcolor = color.black, size = size.small)
if closed
    label.new(bar_index, close, exitTxt + "  " + str.tostring(lastR, "#.##") + "R", style = label.style_label_left, size = size.small, color = color.new(lastR >= 0 ? cUp : cDn, 15), textcolor = color.white)

// ═══════════════════════════ اللوحة ════════════════════════════════════
f_dur(int bars, simple string tf) =>
    m = bars * timeframe.in_seconds(tf) / 60
    m < 60 ? str.tostring(m) + " د" : m < 1440 ? str.tostring(math.round(m / 60.0, 1)) + " س" : str.tostring(math.round(m / 1440.0, 1)) + " ي"

// الأهداف كأيقونات: ● تنوّر حين يتحقق الهدف، ○ مطفأة
f_hits(int h) =>
    (h >= 1 ? "●" : "○") + " " + (h >= 2 ? "●" : "○") + " " + (h >= 3 ? "●" : "○")

f_stateTxt(int p, int pd, bool sec, int st, int raw, string blk) =>
    p == 1 ? (sec ? "كول · مؤمَّنة" : "كول قائمة") : p == -1 ? (sec ? "بوت · مؤمَّنة" : "بوت قائمة") : pd == 1 ? "كول على الافتتاح" : pd == -1 ? "بوت على الافتتاح" : pd == 2 ? "منطقة كول جاهزة" : pd == -2 ? "منطقة بوت جاهزة" : pd == 3 ? "منطقة كول للدخول الثاني" : pd == -3 ? "منطقة بوت للدخول الثاني" : raw != 0 and blk != "" ? (raw == 1 ? "كول محجوبة: " : "بوت محجوبة: ") + blk : st == 9 ? "عرضي — انتظار" : st == 1 ? "ميل صاعد" : "ميل هابط"

// الفريمان ٣ و٥ على الرمز نفسه — المنطق نفسه
f_tf() =>
    [sL, sS, qq, av, e9w, stt, blk, raw] = f_core()
    [p, pd, e, s, q1, q2, q3, h, sec, bi, cl, ex, lr, ps, pl, fw, ft, qt, zs, zlv, zb, zu, zst, hf, hl, sn, nt, em] = f_trade(sL, sS, qq, av, e9w)
    pdx = pd != 0 ? pd : ps != 0 ? ps * 2 : (zs != 0 and zu == 1 and not zst) ? zs * 3 : 0
    [p, pdx, sec ? 1 : 0, stt, raw, blk, ft > 0 ? 10.0 * fw / ft : na]

[tp3, td3, tc3, ts3, tr3, tb3, tf3] = request.security(syminfo.tickerid, "3", f_tf(), lookahead = barmerge.lookahead_off)
[tp5, td5, tc5, ts5, tr5, tb5, tf5] = request.security(syminfo.tickerid, "5", f_tf(), lookahead = barmerge.lookahead_off)

// ═══════════════════════════ لوحة الصدق — بالـR لا بالدولار ═══════════════
var int nT = 0
var int nW = 0
var float sumR = 0.0
var float sumWin = 0.0
var float sumLoss = 0.0
if closed and not na(lastR)
    nT += 1
    sumR += lastR
    if lastR > 0
        nW += 1
        sumWin += lastR
    else
        sumLoss += -lastR
pf = sumLoss > 0 ? sumWin / sumLoss : (sumWin > 0 ? 99.0 : 0.0)
avgR = nT > 0 ? sumR / nT : 0.0
wr = nT > 0 ? 100.0 * nW / nT : 0.0

var table pt = na
f_kv(int r, string k, string v, color c) =>
    table.cell(pt, 0, r, k, text_color = color.new(#9CA3AF, 0), bgcolor = color.new(#1F2937, 10), text_size = size.tiny)
    table.cell(pt, 1, r, v, text_color = c, bgcolor = color.new(#1F2937, 10), text_size = size.small)

if showPnl and barstate.islast
    if na(pt)
        pt := table.new(position.bottom_right, 2, 13, border_width = 1, border_color = color.new(#000000, 80), frame_width = 1, frame_color = color.new(#000000, 70))
    table.cell(pt, 0, 0, "مِرصاد ٩ — اختبار", text_color = color.white, bgcolor = color.new(#111827, 0), text_size = size.small)
    table.cell(pt, 1, 0, syminfo.ticker + " · " + timeframe.period, text_color = color.new(#D1D5DB, 0), bgcolor = color.new(#111827, 0), text_size = size.small)
    pdx = pend != 0 ? pend : pSide != 0 ? pSide * 2 : (zSide != 0 and zUses == 1 and not zStopped and pos == 0) ? zSide * 3 : 0
    st = f_stateTxt(pos, pdx, secured, state, rawSide, blockTxt)
    f_kv(1, "الحالة", st, pos != 0 or pdx != 0 ? color.new(pos == -1 or pdx < 0 ? #FCA5A5 : #86EFAC, 0) : color.new(#FCD34D, 0))
    f_kv(2, "الجودة", pos != 0 ? str.tostring(qT, "#") + " من ١٠٠" + (nth >= 2 ? " · دخول ثانٍ" : "") : "—", color.new(#D1D5DB, 0))
    f_kv(3, "الدخول", pos != 0 ? str.tostring(eP, format.mintick) + "  (" + f_dur(barsIn, timeframe.period) + ")" : "—", color.new(#D1D5DB, 0))
    f_kv(4, "الوقف", pos != 0 ? str.tostring(sP, format.mintick) + (secured ? "  (مؤمَّن)" : "") : "—", color.new(#FCA5A5, 0))
    f_kv(5, "الأهداف", pos != 0 ? f_hits(hit) + "   " + str.tostring(t1, format.mintick) + " · " + str.tostring(t2, format.mintick) + " · " + str.tostring(t3, format.mintick) : "—", color.new(#86EFAC, 0))
    f_kv(6, "التأمين", pos != 0 ? (half ? "½ بيع النصف ✓ · الوقف عند الدخول" : "عند " + str.tostring(halfLvl, format.mintick) + " (" + str.tostring(secPct, "#") + "٪ من الطريق)") : "—", half ? color.new(#FCD34D, 0) : color.new(#D1D5DB, 0))
    f_kv(7, "أول حركة معك", fmTot > 0 ? str.tostring(math.round(10.0 * fmWin / fmTot, 1), "#.#") + " من ١٠  (" + str.tostring(fmWin) + " من " + str.tostring(fmTot) + ")" : "—", fmTot > 0 and fmWin * 2 >= fmTot ? color.new(#86EFAC, 0) : color.new(#FCD34D, 0))
    if showTf
        f_kv(8, "فريم ٣", na(tp3) ? "غير متاح" : f_stateTxt(tp3, td3, tc3 == 1, ts3, tr3, tb3) + (na(tf3) ? "" : "  · " + str.tostring(tf3, "#.#") + "/١٠"), na(tp3) ? color.new(#9CA3AF, 0) : tp3 == 1 or td3 == 1 ? color.new(#86EFAC, 0) : tp3 == -1 or td3 == -1 ? color.new(#FCA5A5, 0) : color.new(#D1D5DB, 0))
        f_kv(9, "فريم ٥", na(tp5) ? "غير متاح" : f_stateTxt(tp5, td5, tc5 == 1, ts5, tr5, tb5) + (na(tf5) ? "" : "  · " + str.tostring(tf5, "#.#") + "/١٠"), na(tp5) ? color.new(#9CA3AF, 0) : tp5 == 1 or td5 == 1 ? color.new(#86EFAC, 0) : tp5 == -1 or td5 == -1 ? color.new(#FCA5A5, 0) : color.new(#D1D5DB, 0))
        agree = (tp3 == 1 or td3 == 1) and (tp5 == 1 or td5 == 1) ? "كول على الفريمين" : (tp3 == -1 or td3 == -1) and (tp5 == -1 or td5 == -1) ? "بوت على الفريمين" : "لا توافق"
        f_kv(10, "التوافق", agree, agree == "لا توافق" ? color.new(#FCD34D, 0) : color.white)
    f_kv(11, "الصدق", nT > 0 ? str.tostring(nT) + " صفقة · " + str.tostring(wr, "#") + "% · متوسط " + str.tostring(avgR, "#.##") + "R · ربح/خسارة " + str.tostring(pf, "#.##") : "—", avgR > 0 ? color.new(#86EFAC, 0) : color.new(#FCA5A5, 0))

// ═══════════════════════════ التنبيهات ════════════════════════════════
alertcondition(pend == 1 and barstate.isconfirmed, "كول", "مِرصاد ٩ — كول")
alertcondition(pend == -1 and barstate.isconfirmed, "بوت", "مِرصاد ٩ — بوت")
alertcondition(secNow, "تأمين", "مِرصاد ٩ — أمّن الصفقة: بع النصف")
alertcondition(closed, "خروج", "مِرصاد ٩ — خروج")

if barstate.isconfirmed and (pend != 0 or (pSide != 0 and pSide[1] == 0))
    sd = pend != 0 ? pend : pSide
    sideTxt = sd == 1 ? "CALL" : "PUT"
    d0 = stopX * atrv
    a1 = tgtMode == "بالدولار" ? usd1 : x1 * atrv
    a2 = tgtMode == "بالدولار" ? usd2 : x2 * atrv
    a3 = tgtMode == "بالدولار" ? usd3 : x3 * atrv
    ref = pend != 0 ? close : pLvl
    alert('{"src":"mirsad9","sym":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","event":"' + (pend != 0 ? "" : "zone") + '","side":"' + sideTxt + '","why":"اندفاع · جودة ' + str.tostring(qv, "#") + '","q":' + str.tostring(qv, "#") + ',"level":' + str.tostring(ref, format.mintick) + ',"ref":' + str.tostring(ref, format.mintick) + ',"stop":' + str.tostring(sd == 1 ? ref - d0 : ref + d0, format.mintick) + ',"t1":' + str.tostring(sd == 1 ? ref + a1 : ref - a1, format.mintick) + ',"t2":' + str.tostring(sd == 1 ? ref + a2 : ref - a2, format.mintick) + ',"t3":' + str.tostring(sd == 1 ? ref + a3 : ref - a3, format.mintick) + '}', alert.freq_once_per_bar_close)
if entered
    alert('{"src":"mirsad9","sym":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","event":"entry","side":"' + (pos == 1 ? "CALL" : "PUT") + '","why":"' + eWord + '· جودة ' + str.tostring(qT, "#") + '","price":' + str.tostring(eP, format.mintick) + ',"stop":' + str.tostring(sP, format.mintick) + ',"t1":' + str.tostring(t1, format.mintick) + ',"t2":' + str.tostring(t2, format.mintick) + ',"t3":' + str.tostring(t3, format.mintick) + '}', alert.freq_once_per_bar)
if secNow
    alert('{"src":"mirsad9","sym":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","event":"secure","side":"' + (pos == 1 ? "CALL" : "PUT") + '","price":' + str.tostring(halfLvl, format.mintick) + '}', alert.freq_once_per_bar)
if closed
    alert('{"src":"mirsad9","sym":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","event":"exit","why":"' + exitTxt + '","r":' + str.tostring(lastR, "#.##") + '}', alert.freq_once_per_bar)
