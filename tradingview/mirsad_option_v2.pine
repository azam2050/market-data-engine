scanPos = input.string("أسفل اليمين", "مكان الباحث", options = ["أعلى اليمين", "أعلى اليسار", "أسفل اليمين", "أسفل اليسار"], group = gV)
cardSz = input.string("كبير", "حجم الخط", options = ["صغير", "عادي", "كبير"], group = gV)
showLines = input.bool(true, "خطوط الدخول والوقف والأهداف", group = gV)
nTg = input.int(3, "عدد أهداف السهم على الشارت", minval = 1, maxval = 5, group = gV)

// ═══════════════════════════════════════════════════════════ الألوان
cUp = color.new(#16c784, 0)
cDn = color.new(#ea3943, 0)
cGold = color.new(#e8b339, 0)
cTxt = color.new(#e6edf3, 0)
cMut = color.new(#8b949e, 0)
cBg = color.new(#0d1117, 10)
cHd = color.new(#161b22, 5)
cSel = color.new(#e8b339, 70)

strict = mode == "متشدد"
quick = mode == "سريع"
adxTr = strict ? 28.0 : quick ? 20.0 : 25.0
adxRg = strict ? 16.0 : quick ? 20.0 : 18.0
edgeP = strict ? 0.12 : quick ? 0.25 : 0.18
TZ = "America/New_York"

// ═══════════════════════════════════════════════════════════ الدوال
f_pos(string p) =>
    p == "أعلى اليمين" ? position.top_right : p == "أعلى اليسار" ? position.top_left :
     p == "أسفل اليمين" ? position.bottom_right : position.bottom_left

f_sz() =>
    cardSz == "صغير" ? size.tiny : cardSz == "كبير" ? size.normal : size.small

f_2(int x) =>
    x < 10 ? "0" + str.tostring(x) : str.tostring(x)

f_strike(float k) =>
    whole = math.abs(k - math.round(k)) < 0.000001
    whole ? (strikeFmt == "745" ? str.tostring(k, "#") : str.tostring(k, "#.0")) : str.tostring(k, "#.0##")

f_occ(string root, int expT, int cp, float k) =>
    conPrefix + root + f_2(year(expT, TZ) % 100) + f_2(month(expT, TZ)) + f_2(dayofmonth(expT, TZ)) +
     (cp == 1 ? "C" : "P") + f_strike(k)

f_inc(float px) =>
    idx = syminfo.ticker == "SPY" or syminfo.ticker == "QQQ" or syminfo.ticker == "IWM"
    incIn > 0 ? incIn : idx ? 1.0 : px < 25 ? 0.5 : px < 150 ? 1.0 : px < 500 ? 2.5 : 5.0

// التاريخ المرشَّح رقم n: تلقائي/اليوم = اليوم ثم الجمعة
f_expN(int n) =>
    dw = dayofweek(time, TZ)
    toFri = (6 - dw + 7) % 7
    fri = time + toFri * 86400000
    int r = na
    if expMode == "يدوي"
        r := n == 0 ? expManual : na
    else if expMode == "تلقائي" or expMode == "اليوم"
        r := n == 0 ? time : toFri > 0 ? fri : na
    else if expMode == "الجمعة القادمة"
        r := n == 0 ? fri : na
    else
        r := n == 0 ? fri + 7 * 86400000 : na
    r

f_exp() =>
    dw = dayofweek(time, TZ)
    root = syminfo.ticker
    daily = root == "SPY" or root == "QQQ" or root == "IWM"
    toFri = (6 - dw + 7) % 7
    d = expMode == "اليوم" ? 0 : expMode == "الجمعة القادمة" ? toFri :
         expMode == "الجمعة بعد القادمة" ? toFri + 7 : daily ? 0 : toFri
    expMode == "يدوي" ? expManual : time + d * 86400000

LRM = "‎"
RLM = "‏"
SEP = RLM + "  ·  " + RLM

f_sg(float x, string fmt) =>
    LRM + (x >= 0 ? "+" : "") + str.tostring(x, fmt) + LRM

f_n(float x, string fmt) =>
    LRM + str.tostring(x, fmt) + LRM

f_m(float x) =>
    LRM + str.tostring(x, "0.00") + "$" + LRM

f_x(float x) =>
    LRM + "×" + str.tostring(x, "0.0") + LRM

f_ar(string x) =>
    t = str.replace_all(x, "0", "٠")
    t := str.replace_all(t, "1", "١")
    t := str.replace_all(t, "2", "٢")
    t := str.replace_all(t, "3", "٣")
    t := str.replace_all(t, "4", "٤")
    t := str.replace_all(t, "5", "٥")
    t := str.replace_all(t, "6", "٦")
    t := str.replace_all(t, "7", "٧")
    t := str.replace_all(t, "8", "٨")
    str.replace_all(t, "9", "٩")

f_tf(string p) =>
    f_ar(p) + " دقائق"

f_why(int w) =>
    w == 1 ? "ارتداد الاتجاه" : w == 2 ? "حدّ الصندوق" : w == 3 ? "انعكاس" : w == 4 ? "تبادل الأدوار" : w == 5 ? "ارتداد من منطقة" : w == 6 ? "الكسر مع الاتجاه" : "—"

f_sigName(int w) =>
    showWhy ? f_why(w) : "إشارة مِرصاد"

f_tk(string sym) =>
    parts = str.split(sym, ":")
    array.get(parts, array.size(parts) - 1)

f_state(int s) =>
    s == 1 ? "مندفع صاعد" : s == -1 ? "مندفع هابط" : s == 0 ? "عرضي" : "متحوّل"

// المحرّك نفسه — يعمل على الشارت وعلى كل رمز في الباحث
f_engine() =>
    a_ = ta.atr(14)
    f_ = ta.ema(close, fastN)
    s_ = ta.ema(close, slowN)
    ct_ = math.max(f_, s_)
    cb_ = math.min(f_, s_)
    [dp_, dm_, ax_] = ta.dmi(14, 14)
    bh_ = ta.highest(high, 30)[1]
    bl_ = ta.lowest(low, 30)[1]
    bw_ = bh_ - bl_
    ib_ = bw_ > 0 and close > bl_ + 0.2 * bw_ and close < bh_ - 0.2 * bw_
    pu_ = ax_ >= adxTr and close > ct_ and f_ > s_
    pd_ = ax_ >= adxTr and close < cb_ and f_ < s_
    sw_ = ax_ < adxRg and ib_
    st_ = pu_ ? 1 : pd_ ? -1 : sw_ ? 0 : 2
    rg_ = high - low
    bd_ = close - open
    l1 = useTrend and st_ == 1 and low <= ct_ and close > ct_ and close > open and (not strict or close > high[1])
    s1 = useTrend and st_ == -1 and high >= cb_ and close < cb_ and close < open and (not strict or close < low[1])
    l2 = useRange and st_ == 0 and low <= bl_ + edgeP * bw_ and close > open and close > low + 0.5 * rg_
    s2 = useRange and st_ == 0 and high >= bh_ - edgeP * bw_ and close < open and close < high - 0.5 * rg_
    l3 = useRev and st_ == 2 and rg_ > 0 and bd_ >= revK * a_ and close > ct_ and open < ct_
    s3 = useRev and st_ == 2 and rg_ > 0 and -bd_ >= revK * a_ and close < cb_ and open > cb_
    hiN_ = ta.highest(high, brkN)[1]
    loN_ = ta.lowest(low, brkN)[1]
    rvE_ = volume / math.max(nz(ta.sma(volume, 20)[1]), 1)
    // تبادل الأدوار: الكسر يحفظ المستوى، والدخول عند اختباره من الجهة الأخرى
    var float rrU = na
    var int rrUBar = na
    var float rrD = na
    var int rrDBar = na
    brkU_ = rg_ > 0 and close > hiN_ and bd_ >= 0.5 * a_ and rvE_ >= brkVol
    brkD_ = rg_ > 0 and close < loN_ and -bd_ >= 0.5 * a_ and rvE_ >= brkVol
    l4 = useBrk and not na(rrU) and bar_index > rrUBar and low <= rrU + rrTol * a_ and close > rrU and close > open
    s4 = useBrk and not na(rrD) and bar_index > rrDBar and high >= rrD - rrTol * a_ and close < rrD and close < open
    // بعد الفحص: استهلاك المستوى أو إلغاؤه أو تسجيل كسر جديد
    if l4 or (not na(rrU) and (bar_index - rrUBar > rrWait or close < rrU - 0.5 * a_))
        rrU := na
    if s4 or (not na(rrD) and (bar_index - rrDBar > rrWait or close > rrD + 0.5 * a_))
        rrD := na
    if brkU_
        rrU := hiN_
        rrUBar := bar_index
    if brkD_
        rrD := loN_
        rrDBar := bar_index
    hi10_ = ta.highest(high, 10)[1]
    lo10_ = ta.lowest(low, 10)[1]
    l6 = useCont and st_ == 1 and close > hi10_ and close > open and close - f_ <= 1.0 * a_
    s6 = useCont and st_ == -1 and close < lo10_ and close < open and f_ - close <= 1.0 * a_
    sd_ = l1 or l2 or l3 or l4 or l6 ? 1 : s1 or s2 or s3 or s4 or s6 ? -1 : 0
    wh_ = l1 or s1 ? 1 : l2 or s2 ? 2 : l3 or s3 ? 3 : l4 or s4 ? 4 : l6 or s6 ? 6 : 0
    [sd_, st_, wh_, ct_, cb_, a_, ax_]

f_chg() =>
    so = ta.valuewhen(session.isfirstbar_regular, open, 0)
    na(so) or so == 0 ? 0.0 : (close / so - 1) * 100

f_scan() =>
    [sd_, st_, wh_, ct_, cb_, a_, ax_] = f_engine()
    rv_ = ta.sma(volume, 3) / math.max(nz(ta.sma(volume, 60)[3]), 1)
    last_ = ta.valuewhen(sd_ != 0, sd_, 0)
    ago_ = ta.barssince(sd_ != 0)
    px_ = ta.valuewhen(sd_ != 0, close, 0)
    inv_ = nz(last_) == 1 ? cb_ : nz(last_) == -1 ? ct_ : na
    since_ = na(px_) or px_ == 0 ? na : (close / px_ - 1) * 100 * nz(last_)
    [nz(last_), nz(ago_, 999), st_, f_chg(), rv_, inv_, since_]

f_st1() =>
    [sd_, st_, wh_, ct_, cb_, a_, ax_] = f_engine()
    st_[1]

// ═════════════════════════════════════════════════════════════ الحساب
[rawSide, state, rawWhy, cTop, cBot, atr, adx] = f_engine()
eF = ta.ema(close, fastN)
eS = ta.ema(close, slowN)
eT = ta.ema(close, trendN)

intraday = timeframe.isintraday
usEq = syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "dr"
mkt24 = mktIn == "٢٤ ساعة" or (mktIn == "تلقائي" and not usEq)
minsNY = hour(time, TZ) * 60 + minute(time, TZ)
newDay = mkt24 ? timeframe.change("D") : session.isfirstbar_regular
lateBar = intraday and not mkt24 and lateMin > 0 and minsNY >= 960 - lateMin
bellBar = eodOut and intraday and not mkt24 and minsNY >= 955

var int barsToday = 0
var int sigToday = 0
var float dayHi = na
var float dayLo = na
if newDay or na(dayHi)
    barsToday := 0
    sigToday := 0
    dayHi := high
    dayLo := low
else
    barsToday += 1
    dayHi := math.max(dayHi, high)
    dayLo := math.min(dayLo, low)

allowL = dirIn != "بوت فقط"
allowS = dirIn != "كول فقط"
trendUp = eT > eT[10]
trendDn = eT < eT[10]
budget = maxSig == 0 or sigToday < maxSig
gateOk = barsToday >= 1 and not lateBar and budget and not (avoidSide and (state == 0 or adx < sideADX))
// ــ مناطق العرض والطلب: من القمم والقيعان المؤكّدة فقط (تظهر بعد pivN شمعة — لا نظر للمستقبل)
var array<float> supTop = array.new<float>()
var array<float> supBot = array.new<float>()
var array<box> supBox = array.new<box>()
var array<float> demTop = array.new<float>()
var array<float> demBot = array.new<float>()
var array<box> demBox = array.new<box>()
ph = ta.pivothigh(high, pivN, pivN)
pl = ta.pivotlow(low, pivN, pivN)
if not na(ph)
    array.unshift(supTop, ph)
    array.unshift(supBot, ph - 0.35 * atr)
    array.unshift(supBox, showZones ? box.new(bar_index - pivN, ph, bar_index, ph - 0.35 * atr, border_color = color.new(cDn, 60),
         bgcolor = color.new(cDn, 85), extend = extend.right) : box(na))
    if array.size(supTop) > 4
        array.pop(supTop)
        array.pop(supBot)
        box.delete(array.pop(supBox))
if not na(pl)
    array.unshift(demBot, pl)
    array.unshift(demTop, pl + 0.35 * atr)
    array.unshift(demBox, showZones ? box.new(bar_index - pivN, pl + 0.35 * atr, bar_index, pl, border_color = color.new(cUp, 60),
         bgcolor = color.new(cUp, 85), extend = extend.right) : box(na))
    if array.size(demBot) > 4
        array.pop(demTop)
        array.pop(demBot)
        box.delete(array.pop(demBox))
// منطقة يخترقها السعر بإغلاق تُحذف
if array.size(supTop) > 0
    for i = array.size(supTop) - 1 to 0
        if close > array.get(supTop, i) + 0.1 * atr
            array.remove(supTop, i)
            array.remove(supBot, i)
            box.delete(array.remove(supBox, i))
if array.size(demBot) > 0
    for i = array.size(demBot) - 1 to 0
        if close < array.get(demBot, i) - 0.1 * atr
            array.remove(demTop, i)
            array.remove(demBot, i)
            box.delete(array.remove(demBox, i))
nearSup = false
if array.size(supBot) > 0
    for i = 0 to array.size(supBot) - 1
        b_ = array.get(supBot, i)
        if b_ >= close and b_ - close <= zoneDist * atr
            nearSup := true
nearDem = false
if array.size(demTop) > 0
    for i = 0 to array.size(demTop) - 1
        t_ = array.get(demTop, i)
        if t_ <= close and close - t_ <= zoneDist * atr
            nearDem := true

// الارتداد من المناطق: يلمس السعر المنطقة ويغلق راجعاً منها
zoneL = false
if useZoneB and state != -1 and array.size(demTop) > 0
    for i = 0 to array.size(demTop) - 1
        t_ = array.get(demTop, i)
        if low <= t_ and close > t_ and close > open
            zoneL := true
zoneS = false
if useZoneB and state != 1 and array.size(supBot) > 0
    for i = 0 to array.size(supBot) - 1
        b_ = array.get(supBot, i)
        if high >= b_ and close < b_ and close < open
            zoneS := true
sideM = rawSide != 0 ? rawSide : zoneL ? 1 : zoneS ? -1 : 0
whyM = rawSide != 0 ? rawWhy : zoneL or zoneS ? 5 : 0
extL = (close - eF) / math.max(atr, 0.000001) <= maxExt
extS = (eF - close) / math.max(atr, 0.000001) <= maxExt

rawL0 = sideM == 1 and allowL and (not needTrend or trendUp) and gateOk and extL and not (avoidZone and nearSup) and not scanOnly
rawS0 = sideM == -1 and allowS and (not needTrend or trendDn) and gateOk and extS and not (avoidZone and nearDem) and not scanOnly

// عدّاد الحركة والقوة مقابل السوق
dAtr = request.security(syminfo.tickerid, "D", ta.atr(14)[1], lookahead = barmerge.lookahead_off)
dRng = request.security(syminfo.tickerid, "D", ta.sma(high - low, 20)[1], lookahead = barmerge.lookahead_off)
spyChg = request.security("SPY", timeframe.period, f_chg(), ignore_invalid_symbol = true)
myChg = f_chg()
rsVsMkt = nz(myChg) - nz(spyChg)
usedPct = na(dAtr) or dAtr <= 0 ? na : (dayHi - dayLo) / dAtr * 100
tgtShare = na(dRng) or dRng <= 0 ? na : dollarTgt / dRng
qqqChg = request.security("QQQ", timeframe.period, f_chg(), ignore_invalid_symbol = true)
rvNow = ta.sma(volume, 3) / math.max(nz(ta.sma(volume, 60)[3]), 1)
otherTf = timeframe.period == "3" ? "5" : timeframe.period == "5" ? "15" : "5"
stOther = request.security(syminfo.tickerid, otherTf, f_st1(), lookahead = barmerge.lookahead_on)
tfMs = timeframe.in_seconds() * 1000
stockLive = barstate.isrealtime and timenow - time < 2 * tfMs

// جودة الإعداد من ١٠٠ — وصفٌ للظروف، لا احتمال نجاح
stK = ta.sma(ta.stoch(close, high, low, 14), 3)
stD = ta.sma(stK, 3)
f_qual(int sd) =>
    q1 = math.min(nz(adx), 40) / 40 * 20
    q2 = math.min(nz(rvNow), 3) / 3 * 20
    q3 = math.max(math.min(rsVsMkt * sd, 1.5), 0) / 1.5 * 20
    q4 = na(usedPct) ? 10.0 : usedPct < 60 ? 20.0 : usedPct < 100 ? 10.0 : 0.0
    rg = high - low
    q5 = rg > 0 ? math.max((sd == 1 ? close - low : high - close) / rg, 0) * 20 : 0.0
    q6 = sd == 1 ? (stK > stD and stK < 80 ? 20.0 : stK > stD ? 10.0 : 0.0) :
         (stK < stD and stK > 20 ? 20.0 : stK < stD ? 10.0 : 0.0)
    q7 = sd == 1 ? (trendUp and close > eT ? 20.0 : trendUp or close > eT ? 10.0 : 0.0) :
         (trendDn and close < eT ? 20.0 : trendDn or close < eT ? 10.0 : 0.0)
    int(math.round((q1 + q2 + q3 + q4 + q5 + q6 + q7) * 100 / 140))

qL = f_qual(1)
qS = f_qual(-1)
rawL = rawL0 and qL >= minQual
rawS = rawS0 and qS >= minQual

// ═════════════════════════════════════════════════════ الصفقة على السهم
var int pos = 0
var float eP = na
var float sP = na
var float unit = na
var float peakR = 0.0
var int eBar = na
var int eWhy = 0
var int eQual = 0
var string exitTxt = ""
var int exitAt = na

// العقد
var string conSym = ""
var float conEntry = na
var float conNow = na
var float conHiNow = na
var float conLo = na
var float conT = na
var float conMax = na
var float conPeak = 0.0
var bool conLock = false
var float conLockPx = na
var string conMsg = ""
var string conName = ""
var int tgHit = 0

// السجلّ الصادق
var int nTr = 0
var int nWin = 0
var float sumR = 0.0
var float sumPeakR = 0.0
var float sumD = 0.0
var float sumPeakD = 0.0
var int nCon = 0
var float sumCon = 0.0
var float sumConPeak = 0.0
var array<string> logSym = array.new<string>()
var array<string> logTxt = array.new<string>()
var array<float> logRes = array.new<float>()

// إشارة الغيمة والانعكاس تنتظر شمعة تأكيد · تبادل الأدوار تأكيده فيه
var int pendSd = 0
var float pendLvl = na
var int pendBar = na
var int pendWhy = 0
candL = rawL and barstate.isconfirmed and pos == 0
candS = rawS and barstate.isconfirmed and pos == 0
confL = pendSd == 1 and barstate.isconfirmed and pos == 0 and bar_index > pendBar and close > pendLvl and gateOk
confS = pendSd == -1 and barstate.isconfirmed and pos == 0 and bar_index > pendBar and close < pendLvl and gateOk
instant = whyM == 4 or whyM == 6
sigL = confirmNext ? (confL or (candL and instant)) : candL
sigS = confirmNext ? (confS or (candS and instant)) : candS
entWhy = confL or confS ? pendWhy : whyM
if sigL or sigS
    pendSd := 0
else if confirmNext and candL and not instant
    pendSd := 1
    pendLvl := high
    pendBar := bar_index
    pendWhy := whyM
else if confirmNext and candS and not instant
    pendSd := -1
    pendLvl := low
    pendBar := bar_index
    pendWhy := whyM
else if pendSd != 0 and barstate.isconfirmed and bar_index >= pendBar + 3
    pendSd := 0
preL = rawL and barstate.isrealtime and not barstate.isconfirmed and pos == 0
preS = rawS and barstate.isrealtime and not barstate.isconfirmed and pos == 0
conWindow = time >= last_bar_time - conDays * 86400000

// ــ ١) الخروج أولاً
exitNow = false
exitReason = ""
exitPx = close
conExitPx = float(na)
if pos != 0 and bar_index > eBar
    favR = ((pos == 1 ? high : low) - eP) * pos / unit
    stopHit = pos == 1 ? low <= sP : high >= sP
    curR = (close - eP) * pos / unit
    conOk = conSym != "" and not na(conEntry) and conEntry > 0
    if conOk
        [cc_, ch_, cl_, ct_] = request.security(conSym, timeframe.period, [close, high, low, time], ignore_invalid_symbol = true)
        conNow := cc_
        conHiNow := ch_
        conLo := cl_
        conT := ct_
    // مستوى القفل من القمة **قبل** هذه الشمعة، ثم يُفحص قاعها — الأسوأ أولاً
    conLockPx := conOk and exitMode == "قفل الربح" and conPeak >= lockAfter ?
         conEntry * (1 + math.max(5.0, conPeak * (1 - giveback / 100.0)) / 100) : na
    conStopPx = conOk and conStopPct > 0 ? conEntry * (1 - conStopPct / 100.0) : na
    lockHitC = not na(conLockPx) and not na(conLo) and conLo <= conLockPx
    cStopHit = not na(conStopPx) and not na(conLo) and conLo <= conStopPx
    lockLvlR = math.max(0.1, peakR * (1 - giveback / 100.0))
    lockHitR = exitMode == "قفل الربح" and (not conOk or na(conNow)) and peakR >= 1.0 and curR <= lockLvlR
    cloudHit = exitMode == "إغلاق خلف الغيمة" and (pos == 1 ? close < cBot : close > cTop)
    oppHit = pos == 1 ? rawS and barstate.isconfirmed : rawL and barstate.isconfirmed
    if stopHit
        exitNow := true
        exitReason := (sP - eP) * pos > syminfo.mintick ? "وقف متحرّك" :
             math.abs(sP - eP) <= syminfo.mintick ? "وقف على الدخول" : "وقف السهم"
        exitPx := sP
    else if cStopHit
        exitNow := true
        exitReason := "وقف العقد"
        conExitPx := conStopPx
    else if lockHitC
        exitNow := true
        exitReason := "قفل الربح"
        conExitPx := conLockPx
    else if barstate.isconfirmed and lockHitR
        exitNow := true
        exitReason := "قفل الربح"
    else if barstate.isconfirmed and cloudHit
        exitNow := true
        exitReason := "إغلاق خلف الغيمة"
    else if barstate.isconfirmed and oppHit
        exitNow := true
        exitReason := "إشارة معاكسة"
    else if barstate.isconfirmed and bellBar
        exitNow := true
        exitReason := "جرس الجلسة"
    // بعد الفحص فقط: تحديث القمم
    peakR := math.max(peakR, favR)
    if exitMode == "تمديد الأهداف" and peakR >= 1.0 and not exitNow
        kHit = math.floor(peakR)
        trail = eP + pos * (kHit - 1) * unit
        sP := pos == 1 ? math.max(sP, trail) : math.min(sP, trail)
    if conOk and not na(conHiNow)
        conPeak := math.max(conPeak, (conHiNow / conEntry - 1) * 100)
        conMax := na(conMax) ? conHiNow : math.max(conMax, conHiNow)
    conLock := conPeak >= lockAfter
    // تنبيه عند كل هدف جديد للعقد
    hits = (conPeak >= tg1 ? 1 : 0) + (conPeak >= tg2 ? 1 : 0) + (conPeak >= tg3 ? 1 : 0) +
         (conPeak >= tg4 ? 1 : 0) + (conPeak >= tg5 ? 1 : 0)
    if hits > tgHit and not exitNow
        alert("مِرصاد أوبشن: " + syminfo.ticker + " · العقد حقق الهدف " + str.tostring(hits) +
             " (+" + str.tostring(conPeak, "#") + "٪) — ارفع وقف العقد", alert.freq_once_per_bar)
        tgHit := hits

if exitNow
    rR = (exitPx - eP) * pos / unit
    nTr += 1
    nWin += rR > 0 ? 1 : 0
    sumR += rR
    sumPeakR += peakR
    sumD += (exitPx - eP) * pos
    sumPeakD += peakR * unit
    cOut = not na(conExitPx) ? conExitPx : conNow
    conRes = conSym != "" and not na(conEntry) and not na(cOut) ? (cOut / conEntry - 1) * 100 : na
    if not na(conRes)
        nCon += 1
        sumCon += conRes
        sumConPeak += conPeak
        array.unshift(logSym, conName)
        array.unshift(logTxt, "دخول " + f_m(conEntry) + SEP + "أعلى " + (na(conMax) ? "—" : f_m(conMax)) +
             SEP + "خروج " + f_m(cOut) + SEP + f_sg(conRes, "#") + "٪" + SEP + exitReason)
        array.unshift(logRes, conRes)
        if array.size(logSym) > 5
            array.pop(logSym)
            array.pop(logTxt)
            array.pop(logRes)
    exitTxt := exitReason + SEP + (na(conRes) ? "السهم " + f_sg((exitPx - eP) * pos, "0.00") + "$" :
         "العقد " + f_sg(conRes, "#") + "٪" + SEP + "القمة " + f_sg(conPeak, "#") + "٪")
    exitAt := bar_index
    label.new(bar_index, pos == 1 ? high : low, "خروج" + SEP + exitTxt,
         style = pos == 1 ? label.style_label_down : label.style_label_up,
         color = color.new(#161b22, 0), textcolor = (na(conRes) ? rR : conRes) > 0 ? cUp : cMut, size = size.small)
    alert("مِرصاد أوبشن: خروج " + syminfo.ticker + " · " + exitTxt, alert.freq_once_per_bar)
    pos := 0
    conSym := ""
    conName := ""
    conEntry := na
    conNow := na
    conHiNow := na
    conLo := na
    conMax := na
    conPeak := 0.0
    conLock := false
    conLockPx := na
    tgHit := 0

// ــ ٢) الدخول
if sigL or sigS
    side = sigL ? 1 : -1
    pos := side
    eP := close
    unit := stopX * atr
    sP := close - side * unit
    peakR := 0.0
    eBar := bar_index
    eWhy := entWhy
    eQual := side == 1 ? qL : qS
    sigToday += 1
    conMsg := ""
    conEntry := na
    conNow := na
    conMax := na
    conPeak := 0.0
    tgHit := 0
    cTxtL = conSym == "" ? "" : "\n" + conName +
         (na(conEntry) ? "" : "  ·  " + str.tostring(conEntry * 100, "#") + "$")
    label.new(bar_index, side == 1 ? low : high,
         (side == 1 ? "كول" : "بوت") + " · " + f_sigName(entWhy) + " · جودة " + str.tostring(eQual) + cTxtL,
         style = side == 1 ? label.style_label_up : label.style_label_down,
         color = side == 1 ? cUp : cDn, textcolor = color.white, size = size.small)
    alert("مِرصاد أوبشن: " + (side == 1 ? "كول " : "بوت ") + syminfo.ticker + " عند " +
         str.tostring(close, format.mintick) + " · " + f_sigName(entWhy) + " · جودة " + str.tostring(eQual) +
         (conName == "" ? "" : " · العقد " + conName), alert.freq_once_per_bar_close)

// ــ اختيار العقد: على شمعة الدخول، ويُعاد حتى ٣ شموع بعدها — في السوق المباشر
//    أوّل طلب لرمز عقد جديد قد يعود فارغاً قبل أن تُحمَّل بياناته
//    والتاريخ: عقد اليوم أولاً، فإن لم يوجد فعقد الجمعة
if pos != 0 and conOn and conSym == "" and not na(eBar) and bar_index - eBar <= 3
    sd = pos
    if manualSym != ""
        px0 = request.security(manualSym, timeframe.period, close, ignore_invalid_symbol = true)
        if not na(px0)
            conSym := manualSym
            conName := str.replace_all(manualSym, conPrefix, "")
            conEntry := px0
            conNow := px0
            conMax := px0
    else if intraday and usEq and conWindow
        inc = f_inc(eP)
        kAtm = math.round(eP / inc) * inc
        root = syminfo.ticker
        rngMode = strikeMode == "حسب نطاق السعر"
        fixOff = strikeMode == "داخل المال بدرجة" ? -1.0 : strikeMode == "خارج المال بدرجة" and allowOtm ? 1.0 : 0.0
        pick = ""
        pickPx = float(na)
        pickK = float(na)
        pickT = int(na)
        fbSym = ""
        fbPx = float(na)
        fbK = float(na)
        fbT = int(na)
        for e = 0 to 1
            expT = f_expN(e)
            if pick == "" and not na(expT)
                for j = 0 to 2
                    off = j == 0 ? 0.0 : j == 1 ? 1.0 : -1.0
                    okOff = rngMode ? (allowOtm or off <= 0) : off == fixOff
                    if pick == "" and okOff
                        k_ = kAtm + sd * off * inc
                        sym_ = f_occ(root, expT, sd, k_)
                        px_ = request.security(sym_, timeframe.period, close, ignore_invalid_symbol = true)
                        if not na(px_) and fbSym == ""
                            fbSym := sym_
                            fbPx := px_
                            fbK := k_
                            fbT := expT
                        if not na(px_) and (not rngMode or (px_ * 100 >= priceMin and px_ * 100 <= priceMax))
                            pick := sym_
                            pickPx := px_
                            pickK := k_
                            pickT := expT
        outRange = pick == "" and fbSym != ""
        if outRange
            pick := fbSym
            pickPx := fbPx
            pickK := fbK
            pickT := fbT
        if pick != ""
            conSym := pick
            conName := f_n(pickK, "#.##") + (sd == 1 ? " كول" : " بوت") + SEP +
                 f_2(dayofmonth(pickT, TZ)) + "/" + f_2(month(pickT, TZ)) + (outRange ? SEP + "خارج نطاقك" : "")
            conEntry := pickPx
            conNow := pickPx
            conMax := pickPx
            conPeak := 0.0
            conMsg := ""
            label.new(bar_index, sd == 1 ? low : high, "العقد " + conName + "  ·  " + str.tostring(pickPx * 100, "#") + "$",
                 style = sd == 1 ? label.style_label_up : label.style_label_down,
                 color = color.new(#161b22, 0), textcolor = cGold, size = size.small)
            alert("مِرصاد أوبشن: " + syminfo.ticker + " · العقد " + conName + " · " + str.tostring(pickPx, "0.00") + "$",
                 alert.freq_once_per_bar)
        else if bar_index - eBar >= 3
            conMsg := "لا عقد مطابق — راجع مسافة السترايك أو نطاق السعر"

if preL or preS
    alert("مِرصاد أوبشن: استعداد " + (preL ? "كول " : "بوت ") + syminfo.ticker +
         " — الإشارة تتأكد بإغلاق الشمعة", alert.freq_once_per_bar)

// ═══════════════════════════════════════════════════════════════ الرسم
pF = plot(showCloud and not scanOnly ? eF : na, "المتوسط السريع", color.new(cUp, 100))
pS = plot(showCloud and not scanOnly ? eS : na, "المتوسط البطيء", color.new(cDn, 100))
fill(pF, pS, eF > eS ? color.new(cUp, cloudT) : color.new(cDn, cloudT), "الغيمة")
inTr = pos != 0 and showLines
plot(inTr ? eP : na, "الدخول", cGold, 2, plot.style_linebr)
plot(inTr ? sP : na, "الوقف", cDn, 1, plot.style_linebr)
plot(inTr ? eP + pos * unit : na, "هدف ١", cUp, 1, plot.style_linebr)
plot(inTr and nTg >= 2 ? eP + pos * 2 * unit : na, "هدف ٢", cUp, 1, plot.style_linebr)
plot(inTr and nTg >= 3 ? eP + pos * 3 * unit : na, "هدف ٣", cUp, 1, plot.style_linebr)
plot(inTr and nTg >= 4 ? eP + pos * 4 * unit : na, "هدف ٤", cUp, 1, plot.style_linebr)
plot(inTr and nTg >= 5 ? eP + pos * 5 * unit : na, "هدف ٥", cUp, 1, plot.style_linebr)
plotshape(preL, "استعداد كول", shape.circle, location.belowbar, color.new(cUp, 40), size = size.tiny)
plotshape(preS, "استعداد بوت", shape.circle, location.abovebar, color.new(cDn, 40), size = size.tiny)

alertcondition(sigL, "مِرصاد — كول", "مِرصاد أوبشن: إشارة كول")
alertcondition(sigS, "مِرصاد — بوت", "مِرصاد أوبشن: إشارة بوت")
alertcondition(exitNow, "مِرصاد — خروج", "مِرصاد أوبشن: خروج من الصفقة")

// ═══════════════════════════════════════════════════════════════ البطاقة
// أربعة أعمدة من اليمين: العنوان ثم ثلاث خانات — كل رقم في خانته فلا ينقلب الترتيب
var table cd = table.new(f_pos(cardPos), 4, 22, border_width = 1, border_color = color.new(#30363d, 30))
f_c(int c, int r, string t, color tc, color bg) =>
    table.cell(cd, c, r, t, text_color = tc, text_size = f_sz(), text_halign = text.align_center, bgcolor = bg)
f_row(int r, string lab, string v1, string v2, string v3, color tc) =>
    table.cell(cd, 3, r, lab, text_color = cMut, text_size = f_sz(), text_halign = text.align_right, bgcolor = cHd)
    f_c(2, r, v1, tc, cBg)
    f_c(1, r, v2, tc, cBg)
    f_c(0, r, v3, tc, cBg)
f_wide(int r, string lab, string v, color tc) =>
    table.cell(cd, 3, r, lab, text_color = cMut, text_size = f_sz(), text_halign = text.align_right, bgcolor = cHd)
    f_c(0, r, v, tc, cBg)
    table.merge_cells(cd, 0, r, 2, r)

f_tgt(float peak) =>
    (peak >= tg5 ? "✓" : "○") + f_n(tg5, "#") + "٪   " + (peak >= tg4 ? "✓" : "○") + f_n(tg4, "#") + "٪   " +
     (peak >= tg3 ? "✓" : "○") + f_n(tg3, "#") + "٪   " + (peak >= tg2 ? "✓" : "○") + f_n(tg2, "#") + "٪   " +
     (peak >= tg1 ? "✓" : "○") + f_n(tg1, "#") + "٪"

if barstate.islast and not scanOnly
    table.clear(cd, 0, 0, 3, 21)
    table.cell(cd, 3, 0, "مِرصاد أوبشن", text_color = cGold, text_size = f_sz(), text_halign = text.align_right, bgcolor = cHd)
    f_c(2, 0, LRM + syminfo.ticker + LRM, cTxt, cHd)
    f_c(1, 0, f_tf(timeframe.period) + SEP + mode, cTxt, cHd)
    f_c(0, 0, exitMode + (mkt24 ? SEP + "٢٤ ساعة" : ""), cTxt, cHd)
    conFresh = not na(conT) and timenow - conT < 3 * tfMs
    f_row(1, "البيانات", "السهم " + (stockLive ? "● مباشرة" : "○ غير مؤكدة"),
         "العقد " + (conSym == "" ? "—" : conFresh ? "● مباشرة" : "○ غير مؤكدة"), "", stockLive ? cUp : cMut)
    stCol = state == 1 ? cUp : state == -1 ? cDn : state == 0 ? cMut : cGold
    f_row(2, "حالة السوق", f_state(state), "قوة الاتجاه " + f_n(adx, "#"),
         mobile ? "" : f_tf(otherTf) + " " + (na(stOther) ? "—" : f_state(int(stOther))), stCol)
    sd1 = pos == 1 ? "كول" : pos == -1 ? "بوت" : pendSd == 1 ? "انتظار تأكيد كول" : pendSd == -1 ? "انتظار تأكيد بوت" :
         preL ? "استعداد كول" : preS ? "استعداد بوت" : "لا صفقة"
    sd2 = pos != 0 ? f_sigName(eWhy) : pendSd != 0 ? (pendSd == 1 ? "إغلاق فوق " : "إغلاق تحت ") + f_n(pendLvl, "#.##") :
         preL or preS ? "تتأكد بإغلاق الشمعة" : ""
    sd3 = pos != 0 ? "دخول " + f_n(eP, "#.##") + SEP + "جودة " + f_n(eQual, "#") :
         preL ? "جودة " + f_n(qL, "#") : preS ? "جودة " + f_n(qS, "#") : ""
    f_row(3, "الإشارة", sd1, sd2, sd3, pos == 1 or preL or pendSd == 1 ? cUp : pos == -1 or preS or pendSd == -1 ? cDn : cMut)
    gNow = conSym != "" and not na(conNow) and not na(conEntry) and conEntry > 0 ? (conNow / conEntry - 1) * 100 : na
    if conSym != ""
        f_row(4, "العقد", LRM + syminfo.ticker + LRM + "  " + conName, "مثبّت",
             showSar and not na(conNow) ? f_n(conNow * 100 * sarRate, "#") + " ر.س" : "", cTxt)
    else
        f_wide(4, "العقد", conMsg != "" ? conMsg : pos != 0 ? "بلا عقد — خارج نافذة الجلب أو ليس سهماً" : "—", cMut)
    if not mobile
        f_row(5, "سعر العقد", "دخول " + (na(conEntry) ? "—" : f_m(conEntry)),
             "الآن " + (na(conNow) ? "—" : f_m(conNow)) + (na(gNow) ? "" : SEP + f_sg(gNow, "#") + "٪"),
             "أعلى " + f_sg(conPeak, "#") + "٪", na(gNow) ? cMut : gNow >= 0 ? cUp : cDn)
        f_wide(6, "أهداف العقد", conSym == "" ? "—" : f_tgt(conPeak), cTxt)
    stopA = pos == 0 ? "—" : not na(conLockPx) ? "ضع الوقف عند " + f_m(conLockPx) :
         conSym != "" and conStopPct > 0 ? "ضع الوقف عند " + f_m(conEntry * (1 - conStopPct / 100.0)) :
         "وقف السهم " + f_n(sP, "#.##")
    stopB = pos == 0 ? "" : exitMode == "تمديد الأهداف" ? "يمشي مع الأهداف" +
         (peakR >= 1.0 ? SEP + "بعد هدف " + f_n(math.floor(peakR), "#") : "") : not na(conLockPx) ? "قفل ربح " + f_sg((conLockPx / conEntry - 1) * 100, "#") + "٪" :
         conSym != "" and exitMode == "قفل الربح" ? "القفل بعد " + f_sg(lockAfter, "#") + "٪" : ""
    f_row(7, "وقف العقد", stopA, stopB, "", not na(conLockPx) ? cGold : cTxt)
    showExit = exitTxt != "" and not na(exitAt) and bar_index - exitAt <= 30
    f_wide(8, "آخر خروج", showExit ? exitTxt : "—", showExit ? cTxt : cMut)
    if not mobile
        f_row(9, "حركة اليوم", na(usedPct) ? "—" : "قطع " + f_n(usedPct, "#") + "٪ من مداه",
             na(usedPct) ? "" : usedPct < 60 ? "مجال واسع" : usedPct < 100 ? "مجال متوسط" : "استنفد مداه", "",
             na(usedPct) ? cMut : usedPct < 60 ? cUp : usedPct < 100 ? cGold : cDn)
        f_row(10, "هدف الدولار", f_m(dollarTgt), na(tgtShare) ? "—" : f_n(tgtShare * 100, "#") + "٪ من مداه اليومي",
             na(tgtShare) ? "" : tgtShare < 0.2 ? "قريب" : tgtShare < 0.4 ? "متوسط" : tgtShare < 0.8 ? "بعيد" : "بعيد جداً",
             na(tgtShare) ? cMut : tgtShare < 0.4 ? cUp : cDn)
        f_row(11, "مقابل السوق", (rsVsMkt >= 0 ? "أقوى من " : "أضعف من ") + LRM + "SPY" + LRM,
             f_n(math.abs(rsVsMkt), "0.00") + "٪", "السيولة " + f_x(rvNow), rsVsMkt >= 0 ? cUp : cDn)
    f_row(12, "سجلّ الشارت", nTr == 0 ? "لا صفقات بعد" : f_n(nTr, "#") + " صفقة",
         nTr == 0 ? "" : "رابحة " + f_n(100.0 * nWin / nTr, "#") + "٪",
         nTr == 0 ? "" : "متوسط " + f_sg(sumD / nTr, "0.00") + "$" + SEP + "القمة " + f_sg(sumPeakD / nTr, "0.00") + "$", cTxt)
    if not mobile
        f_row(13, "سجلّ العقود", nCon == 0 ? "—" : f_n(nCon, "#") + " عقد",
             nCon == 0 ? "" : "متوسط الخروج " + f_sg(sumCon / nCon, "#") + "٪",
             nCon == 0 ? "" : "متوسط القمة " + f_sg(sumConPeak / nCon, "#") + "٪", cMut)
        nl = array.size(logSym)
        if nl > 0
            for r = 0 to nl - 1
                rc = array.get(logRes, r) >= 0 ? cUp : cDn
                table.cell(cd, 3, 14 + r, LRM + array.get(logSym, r) + LRM, text_color = cTxt, text_size = f_sz(), text_halign = text.align_right, bgcolor = cHd)
                f_c(0, 14 + r, array.get(logTxt, r), rc, cBg)
                table.merge_cells(cd, 0, 14 + r, 2, 14 + r)
    warn = chart.is_heikinashi ? "⚠ شموع هايكن آشي — غيّرها إلى شموع يابانية" :
         not intraday ? "⚠ المؤشر مصمَّم لفريمات الدقائق" : ""
    if warn != ""
        f_wide(21, "تنبيه", warn, cDn)

// ═══════════════════════════════════════════════════════════════ الباحث
var table sc = table.new(f_pos(scanPos), 7, 34, border_width = 1, border_color = color.new(#30363d, 30))
if scanOn and (not mobile or scanOnly) and barstate.islast
    table.clear(sc, 0, 0, 6, 33)
    syms = array.from(sy1, sy2, sy3, sy4, sy5, sy6, sy7, sy8, sy9, sy10, sy11, sy12, sy13, sy14, sy15,
         sy16, sy17, sy18, sy19, sy20, sy21, sy22, sy23, sy24, sy25, sy26, sy27, sy28, sy29, sy30)
    n = math.min(scanCount, scanOnly ? 30 : 16)
    mkTxt = LRM + "S&P" + LRM + " " + f_sg(nz(spyChg), "0.00") + "٪" + SEP + "ناسداك " + f_sg(nz(qqqChg), "0.00") + "٪" +
         SEP + f_n(n, "#") + " رمز" + SEP + f_tf(timeframe.period) + SEP + mode
    table.cell(sc, 0, 0, "الباحث" + SEP + mkTxt, text_color = cGold, text_size = f_sz(), bgcolor = cHd)
    table.merge_cells(sc, 0, 0, 6, 0)
    if n > 0
        scores = array.new_float(n, 0.0)
        sides = array.new_int(n, 0)
        agos = array.new_int(n, 999)
        rsA = array.new_float(n, 0.0)
        rvA = array.new_float(n, 0.0)
        invA = array.new_float(n, na)
        snA = array.new_float(n, na)
        timeOk = barsToday >= 1 and not lateBar
        for j = 0 to n - 1
            s_ = array.get(syms, j)
            [lst, ago, stt, chg, rv, inv, snc] = request.security(s_, timeframe.period, f_scan(), ignore_invalid_symbol = true)
            d = nz(lst) != 0 and nz(ago, 999) <= 20 ? int(nz(lst)) : stt == 1 ? 1 : stt == -1 ? -1 : 0
            rs = nz(chg) - nz(spyChg)
            sc_ = 0.0
            sc_ += nz(rv) >= 1.5 ? 1 : 0
            sc_ += d != 0 and rs * d >= 0.3 ? 1 : 0
            sc_ += nz(ago, 999) <= 2 ? 1 : 0
            sc_ += timeOk ? 1 : 0
            sc_ += d != 0 and stt == d ? 1 : 0
            array.set(scores, j, d == 0 ? sc_ - 0.5 : sc_)
            array.set(sides, j, d)
            array.set(agos, j, int(nz(ago, 999)))
            array.set(rsA, j, rs)
            array.set(rvA, j, nz(rv))
            array.set(invA, j, nz(ago, 999) <= 20 ? inv : na)
            array.set(snA, j, nz(ago, 999) <= 20 ? snc : na)
        order_ = array.sort_indices(scores, order.descending)
        hdrs = array.from("الرمز", "الحالة", "الشروط", "مقابل السوق", "السيولة", "تُلغى عند", "منذ الإشارة")
        for c = 0 to 6
            table.cell(sc, c, 1, array.get(hdrs, c), text_color = cGold, text_size = f_sz(), bgcolor = cHd)
        rows = math.min(n, scanRows)
        for r = 0 to rows - 1
            j = array.get(order_, r)
            d = array.get(sides, j)
            k = int(math.round(math.max(array.get(scores, j), 0.0)))
            fresh = array.get(agos, j) <= 2
            stTxt = fresh ? (d == 1 ? "فرصة CALL" : "فرصة PUT") : d == 1 ? "ميل صعود" : d == -1 ? "ميل هبوط" : "محايد"
            base = d == 1 ? #16c784 : d == -1 ? #ea3943 : #8b949e
            bg = color.new(base, 88 - k * 14)
            me = f_tk(array.get(syms, j)) == syminfo.ticker
            iv = array.get(invA, j)
            sn = array.get(snA, j)
            table.cell(sc, 0, r + 2, (me ? "★ " : "") + LRM + f_tk(array.get(syms, j)) + LRM, text_color = cTxt, text_size = f_sz(), bgcolor = me ? cSel : cBg)
            table.cell(sc, 1, r + 2, stTxt, text_color = cTxt, text_size = f_sz(), bgcolor = bg)
            table.cell(sc, 2, r + 2, str.repeat("●", k) + str.repeat("○", 5 - k), text_color = cTxt, text_size = f_sz(), bgcolor = bg)
            table.cell(sc, 3, r + 2, f_sg(array.get(rsA, j), "0.00") + "٪", text_color = array.get(rsA, j) >= 0 ? cUp : cDn, text_size = f_sz(), bgcolor = cBg)
            table.cell(sc, 4, r + 2, f_x(array.get(rvA, j)), text_color = array.get(rvA, j) >= 1.5 ? cGold : cMut, text_size = f_sz(), bgcolor = cBg)
            table.cell(sc, 5, r + 2, na(iv) ? "—" : (d == 1 ? "تحت " : "فوق ") + f_n(iv, "0.00"), text_color = cMut, text_size = f_sz(), bgcolor = cBg)
            table.cell(sc, 6, r + 2, na(sn) ? "—" : f_sg(sn, "0.00") + "٪", text_color = na(sn) ? cMut : sn >= 0 ? cUp : cDn, text_size = f_sz(), bgcolor = cBg)
        best = array.get(order_, 0)
        bd = array.get(sides, best)
        bk = int(math.round(math.max(array.get(scores, best), 0.0)))
        foot = bd == 0 ? "لا فرصة واضحة الآن" : "أقوى فرصة الآن: " + LRM + f_tk(array.get(syms, best)) + (bd == 1 ? " CALL" : " PUT") + LRM +
             SEP + f_n(bk, "#") + " من ٥" + (bd * nz(spyChg) < 0 ? SEP + "⚠ عكس اتجاه السوق" : "")
        table.cell(sc, 0, rows + 2, foot, text_color = cGold, text_size = f_sz(), bgcolor = cHd)
        table.merge_cells(sc, 0, rows + 2, 6, rows + 2)
