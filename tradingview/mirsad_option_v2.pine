// ══════════════════════════════════════════════════════════════════════════
//@version=6
indicator("مِرصاد أوبشن", "MIRSAD OPTION", overlay = true, max_labels_count = 500,
     max_lines_count = 100, max_boxes_count = 50)

// ═══════════════════════════════════════════════════════════ الإعدادات
gM = "النمط"
mode = input.string("متوازن", "نمط المؤشر", options = ["متشدد", "متوازن", "سريع"], group = gM,
     tooltip = "متشدد: إشارات أقل وشروط أصعب. مفيد في أيام الأخبار والتذبذب حين تريد أن يصمت المؤشر أكثر.\nمتوازن: الوضع المعتاد.\nسريع: إشارات أكثر ومبكّرة، ومعها إشارات متذبذبة أكثر.")
dirIn = input.string("الاتجاهان", "الاتجاه", options = ["الاتجاهان", "كول فقط", "بوت فقط"], group = gM,
     tooltip = "اختر جهة واحدة إن كنت تتاجر جهة واحدة اليوم ولا تريد أن تشغلك الأخرى.")
maxSig = input.int(2, "أقصى إشارات في الجلسة (٠ = بلا حد)", minval = 0, maxval = 10, group = gM,
     tooltip = "بعد هذا العدد يصمت المؤشر حتى الجلسة التالية. قلّله إن كنت تريد صفقة أو اثنتين فقط في اليوم.")
minQual = input.int(60, "أدنى جودة للإشارة (٠ = الكل)", minval = 0, maxval = 100, group = gM,
     tooltip = "الجودة وصفٌ لظروف الإشارة من ١٠٠: قوة الاتجاه · السيولة · القوة مقابل السوق · مجال الحركة الباقي · قوة الشمعة.\nليست احتمال نجاح. ارفعها لترى إشارات أقل في ظروف أوضح.")
mobile = input.bool(false, "وضع الجوال", group = gM,
     tooltip = "بطاقة أصغر بالمعلومات الأساسية فقط، وتخفي الباحث — مناسبة لشاشة الجوال.")

gS = "الاستراتيجيات"
useTrend = input.bool(true, "ارتداد الاتجاه (سوق مندفع)", group = gS,
     tooltip = "في السوق المندفع: السعر يرجع يلمس الغيمة ثم يغلق معها مع الاتجاه. هي أكثر الاستراتيجيات إشارةً.")
useRev = input.bool(true, "الانعكاس (سوق متحوّل)", group = gS,
     tooltip = "شمعة ضخمة تعبر الغيمة كاملة وتغلق خلفها. قليلة وواضحة. أطفئها إن كنت لا تحب الدخول ضد حركة قائمة.")
useRange = input.bool(false, "حدّ الصندوق (سوق عرضي)", group = gS,
     tooltip = "في السوق العرضي: الدخول من طرف الصندوق نحو وسطه. مطفأة لأن العرضي يذيب قيمة العقد بلا حركة. شغّلها إن كنت تتاجر العرضي بقصد.")
revK = input.float(1.5, "حجم شمعة الانعكاس × ATR", minval = 0.8, maxval = 4.0, step = 0.25, group = gS,
     tooltip = "ارفعه فتقلّ إشارات الانعكاس وتصير الشمعة أوضح.")
useBrk = input.bool(true, "تبادل الأدوار (كسر ثم اختبار)", group = gS,
     tooltip = "الكسر لا يُدخلك. شمعة قوية بحجم عالٍ تكسر قمة (أو قاعاً) فيُحفظ المستوى المكسور، ثم ينتظر المؤشر رجوع السعر إليه، ويدخل مع شمعة ترتدّ منه — القمة المكسورة صارت أرضية.\nهكذا لا تدخل على رأس الاختراق.")
brkN = input.int(20, "الكسر: قمة/قاع آخر … شمعة", minval = 5, maxval = 100, group = gS)
brkVol = input.float(1.5, "الكسر: حجم الشمعة ≥ × المعتاد", minval = 1.0, maxval = 5.0, step = 0.25, group = gS)
rrWait = input.int(15, "مهلة الرجوع للمستوى (شموع)", minval = 3, maxval = 60, group = gS,
     tooltip = "إن لم يرجع السعر يختبر المستوى المكسور خلال هذه المدة، يُنسى الكسر.")
rrTol = input.float(0.25, "قرب الاختبار من المستوى × ATR", minval = 0.0, maxval = 1.5, step = 0.05, group = gS)
confirmNext = input.bool(true, "انتظر التأكيد قبل الدخول", group = gS,
     tooltip = "إشارات الغيمة والانعكاس لا تُدخلك فوراً: تنتظر شمعة تغلق فوق قمة شمعة الإشارة (للكول) أو تحت قاعها (للبوت) خلال ٣ شموع. إن لم يأتِ التأكيد تُلغى.")
useZoneB = input.bool(true, "الارتداد من المناطق", group = gS,
     tooltip = "يدخل كول من منطقة طلب (قاع سابق واضح) وبوت من منطقة عرض (قمة سابقة واضحة) حين يلمسها السعر ويغلق راجعاً منها — دخول من الأسفل لا من القمة.")
useCont = input.bool(true, "الكسر مع الاتجاه", group = gS,
     tooltip = "في سوق مندفع نازل: شمعة تكسر قاع آخر ١٠ شموع وهي قريبة من الغيمة تدخلك بوت فوراً — والعكس للكول. لا يدخل والسعر بعيد عن الغيمة، حتى لا يطاردها.")
maxExt = input.float(1.5, "لا دخول والسعر أبعد من الغيمة بـ × ATR", minval = 0.5, maxval = 5.0, step = 0.25, group = gS,
     tooltip = "يمنع الكول على رأس الحركة والبوت في قاعها: إذا ابتعد السعر عن المتوسط السريع أكثر من هذا لا تُقبل الإشارة.")
sideADX = input.int(20, "قوة الاتجاه الأدنى (ADX)", minval = 0, maxval = 40, group = gS,
     tooltip = "تحت هذا الرقم السوق بلا اتجاه — يصمت المؤشر. صفر = بلا شرط.")
avoidSide = input.bool(true, "لا إشارات في السوق العرضي", group = gS,
     tooltip = "يصمت المؤشر حين تكون الحالة «عرضي» — السوق بلا اتجاه والعقد يذوب.")
needTrend = input.bool(false, "مع ميل متوسط الاتجاه فقط", group = gS,
     tooltip = "يمنع الكول والاتجاه العام نازل، والبوت والاتجاه العام طالع. شغّله إن أزعجتك إشارات عكس ما تراه.")

showWhy = input.bool(false, "أظهر اسم الاستراتيجية في الإشارة", group = gS,
