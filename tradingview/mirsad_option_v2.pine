exitMode = input.string("تمديد الأهداف", "طريقة الخروج", options = ["تمديد الأهداف", "قفل الربح", "إغلاق خلف الغيمة", "الوقف والجرس فقط"], group = gX,
     tooltip = "تمديد الأهداف: الوقف يمشي مع الأهداف — عند الهدف ١ ينتقل لسعر الدخول، وعند الهدف ٢ للهدف ١، وهكذا بلا سقف. الصفقة الرابحة تكمّل حركتها.\nقفل الربح: بعد أن يربح العقد النسبة التي تحددها تحت، يتبعه المؤشر ويخرجك إن أرجع جزءاً كبيراً من قمته — حتى لا ينقلب +٧٣٪ إلى +٨٪.\nإغلاق خلف الغيمة: الخروج إذا أغلقت شمعة في الجهة الأخرى من الغيمة (أسلوب رويال).\nالوقف والجرس فقط: لا خروج إلا بالوقف أو قبل إغلاق السوق.")
lockAfter = input.int(20, "قفل الربح يبدأ بعد ربح العقد ٪", minval = 5, maxval = 200, group = gX,
