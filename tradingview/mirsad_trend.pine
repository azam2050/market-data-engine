//@version=5
// ============================================================================
//  مرصاد ترند | Mirsad Trend — أركب الموجة كاملة ولا ألعب في التذبذب
// ----------------------------------------------------------------------------
//  مذهب التداول المكتوب هنا:
//   ١) السوق حالتان: ترند أو تذبذب. أول سؤال دائماً: أي حالة نحن فيها؟
//   ٢) في الترند: ادخل مع اتجاهه من انقلابه، وخلّ الوقف خطاً يلاحق السعر،
//      ولا تنزل إلا عندما ينقلب الخط — فتأكل الموجة كلها لا قضمة منها.
//   ٣) في التذبذب: قف جانباً. الرمادي على الشارت يعني: ممنوع اللعب.
//   ٤) عند الانقلاب داخل ترند قوي: اخرج وادخل العكس فوراً — كول ثم بوت
//      ثم كول، السوق يقودك لا رأيك.
//
//  خط واحد ملون تحت/فوق السعر يقول كل شيء: أخضر = كول واركب،
//  أحمر = بوت واركب، رمادي = تذبذب اجلس. يعمل على كل الفريمات
//  وكل الأسواق لأن كل حساباته من ATR نسبي لفريم الشارت.
//
//  التنبيهات بنفس صيغ مرصاد: 🎯 دخول · 🔺 تأمين · ✅/🔴 خروج
// ============================================================================
indicator("مرصاد ترند | Mirsad Trend", shorttitle="مرصاد ترند", overlay=true,
     max_lines_count=100, max_labels_count=150)

// ---------------------------------------------------------------- المدخلات
grpT = "محرك الترند"
stFactor = input.float(3.0, "حساسية الخط (أصغر = أسرع انقلاباً)", minval=1.0, maxval=6.0, step=0.5, group=grpT)
stAtrLen = input.int(10, "طول ATR للخط", minval=5, maxval=30, group=grpT)
adxMin   = input.int(20, "أدنى قوة ترند للدخول (ADX)", minval=10, maxval=40, group=grpT)
secureX  = input.float(1.0, "تأمين الصفقة بعد (ATR)", minval=0.5, maxval=3.0, step=0.1, group=grpT)
grpD = "العرض"
keepTrail = input.bool(true, "إبقاء آثار الصفقات الماضية (للمراجعة)", group=grpD)
dashPosS  = input.string("أعلى يمين", "مكان اللوحة", options=["أعلى يمين", "أعلى يسار", "أسفل يمين", "أسفل يسار"], group=grpD)

// ------------------------------------------------------------------ الألوان
cUp   = #26A69A
cDn   = #EF5350
cMut  = #787B86
cTxt  = #D5D9E4
cGold = #E3B34D
cPanl = color.new(#1B2130, 8)
cHead = color.new(#232B3D, 0)

// ------------------------------------------------------------------ المحرك
atr = ta.atr(14)
[stLine, stDirRaw] = ta.supertrend(stFactor, stAtrLen)
trendDir = stDirRaw < 0 ? 1 : -1              // 1 = صاعد (السعر فوق الخط)
flipUp   = trendDir == 1 and trendDir[1] == -1
flipDn   = trendDir == -1 and trendDir[1] == 1

[diP, diM, adx] = ta.dmi(14, 14)
trending = adx >= adxMin                       // الرمادي يبدأ تحت هذا الحد
adxCrossUp = trending and not trending[1]

var int trendAge = 0
trendAge := flipUp or flipDn ? 0 : trendAge + 1

// لون الخط: أخضر ترند صاعد، أحمر هابط، رمادي تذبذب (ممنوع اللعب)
lineCol = not trending ? color.new(cMut, 30) : trendDir == 1 ? cUp : cDn
plot(stLine, "خط مرصاد ترند", color=lineCol, linewidth=2, style=plot.style_linebr)

// ------------------------------------------------------------- حالة الصفقة
var bool  inTrade = false
var int   tDir    = 0
var float entryP  = na
var float stop0   = na
var bool  secured = false
var int   entryBar = 0
var line  lnEntry = na
var resArr = array.new_int()
var int   winsAll = 0
var int   lossAll = 0
var float sumR    = 0.0

f_side(d) => d > 0 ? "كول" : "بوت"

// -------------------------------------------------------------- خروج ودخول
// الخروج: انقلاب الخط هو القرار — نغلق على إغلاق شمعة الانقلاب بصدق
// الخروج إما بانقلاب الخط، أو — بعد التأمين — بعودة السعر لسعر الدخول:
// صفقة مؤمّنة لا يُسمح لها أن تتحول لخسارة
exitNow = inTrade and (((tDir > 0 and flipDn) or (tDir < 0 and flipUp)) or (secured and (tDir > 0 ? close < entryP : close > entryP)))
if exitNow and barstate.isconfirmed
    risk  = math.abs(entryP - stop0)
    rMult = risk > 0 ? (tDir > 0 ? close - entryP : entryP - close) / risk : 0.0
    win   = rMult > 0
    array.unshift(resArr, win ? 1 : 0)
    if array.size(resArr) > 20
        array.pop(resArr)
    winsAll += win ? 1 : 0
    lossAll += win ? 0 : 1
    sumR    += rMult
    if keepTrail
        line.set_extend(lnEntry, extend.none)
        line.set_x2(lnEntry, bar_index)
        line.new(entryBar, entryP, bar_index, close, color=win ? color.new(cUp, 35) : color.new(cDn, 30), width=2)
    else
        line.delete(lnEntry)
    label.new(bar_index, tDir > 0 ? low : high,
         win ? "✅ +" + str.tostring(rMult, "#.#") + "R" : "🔴 " + str.tostring(rMult, "#.#") + "R",
         style=tDir > 0 ? label.style_label_up : label.style_label_down,
         color=win ? color.new(cUp, 20) : color.new(cDn, 10),
         textcolor=win ? #04211D : #2B0606, size=size.normal)
    alert((win ? "✅" : "🔴") + " خروج — كسر الوقف المتحرك | " + syminfo.ticker +
         " | النتيجة " + (win ? "+" : "") + str.tostring(rMult, "#.#") + "R", alert.freq_once_per_bar)
    inTrade := false

// الدخول: انقلاب الخط في سوق يتجه — أو ترند قائم اشتدت قوته للتو
enterUp = not inTrade and trending and trendDir == 1 and (flipUp or (adxCrossUp and trendAge < 30))
enterDn = not inTrade and trending and trendDir == -1 and (flipDn or (adxCrossUp and trendAge < 30))
if (enterUp or enterDn) and barstate.isconfirmed
    dir = enterUp ? 1 : -1
    inTrade := true
    tDir    := dir
    entryP  := close
    stop0   := stLine
    secured := false
    entryBar := bar_index
    lnEntry := line.new(bar_index, entryP, bar_index + 1, entryP, extend=extend.right, color=color.new(cTxt, 35), style=line.style_dotted, width=1)
    label.new(bar_index, dir > 0 ? low : high, "🎯 " + f_side(dir) + " " + str.tostring(entryP, format.mintick),
         style=dir > 0 ? label.style_label_up : label.style_label_down,
         color=dir > 0 ? cUp : cDn, textcolor=dir > 0 ? #04211D : #2B0606, size=size.normal)
    alert("🎯 دخول " + f_side(dir) + " | " + syminfo.ticker + " فريم " + timeframe.period +
         " | سعر " + str.tostring(entryP, format.mintick) + " | وقف " + str.tostring(stLine, format.mintick) +
         " | السبب: " + (flipUp or flipDn ? "انقلاب الترند مع قوة اتجاه" : "اشتداد ترند قائم"), alert.freq_once_per_bar)

// التأمين: بعد مسافة معقولة، الصفقة لم تعد تقدر تخسر
if inTrade and not secured and barstate.isconfirmed
    if (tDir > 0 and high >= entryP + secureX * atr) or (tDir < 0 and low <= entryP - secureX * atr)
        secured := true
        alert("🔺 هدف 1 تحقق والصفقة مؤمّنة (الوقف = الدخول) | " + syminfo.ticker, alert.freq_once_per_bar)

// ------------------------------------------------------------------ اللوحة
f_pos(s) => s == "أعلى يمين" ? position.top_right : s == "أعلى يسار" ? position.top_left :
     s == "أسفل يمين" ? position.bottom_right : position.bottom_left
var table dash = table.new(f_pos(dashPosS), 2, 5, bgcolor=cPanl, border_width=1, border_color=color.new(#2A3245, 0))
if barstate.islast
    tot = winsAll + lossAll
    wr  = tot > 0 ? 100.0 * winsAll / tot : 0.0
    avR = tot > 0 ? sumR / tot : 0.0
    regime = not trending ? "تذبذب — لا تدخل ⏸" : trendDir == 1 ? "ترند صاعد — اركب الكول" : "ترند هابط — اركب البوت"
    rCol = not trending ? cMut : trendDir == 1 ? cUp : cDn
    table.cell(dash, 0, 0, "مرصاد ترند", text_color=cTxt, bgcolor=cHead, text_size=size.small)
    table.cell(dash, 1, 0, syminfo.ticker, text_color=cTxt, bgcolor=cHead, text_size=size.small)
    table.cell(dash, 0, 1, "حالة السوق", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 1, regime, text_color=rCol, bgcolor=color.new(rCol, 85), text_size=size.small)
    table.cell(dash, 0, 2, "الصفقة", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 2, inTrade ? "🎯 " + f_side(tDir) + (secured ? " · مؤمّنة ✓" : "") + " · الوقف " + str.tostring(stLine, format.mintick) : "لا صفقة", text_color=inTrade ? (tDir > 0 ? cUp : cDn) : cMut, text_size=size.small)
    table.cell(dash, 0, 3, "قوة الترند ADX", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(adx, "#") + (trending ? " ✓" : " — ضعيف"), text_color=trending ? cGold : cMut, text_size=size.small)
    table.cell(dash, 0, 4, "السجل", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 4, tot > 0 ? str.tostring(tot) + " صفقة · نجاح " + str.tostring(wr, "#") + "% · متوسط " + (avR >= 0 ? "+" : "") + str.tostring(avR, "#.##") + "R" : "لا صفقات بعد", text_color=cMut, text_size=size.small)
