// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// مِرصاد ٨٠ — نسخة الاختبار (Strategy Tester). نفس قواعد المؤشر: مستوى دخول مسبق يُنفَّذ بأمر معلّق لحظة اللمس.
//@version=5
strategy("مِرصاد ٨٠ — اختبار", "MIRSAD 80 TEST", overlay = true, max_labels_count = 500, initial_capital = 100000, default_qty_type = strategy.fixed, default_qty_value = 100, commission_type = strategy.commission.percent, commission_value = 0.02, slippage = 1)

ruleIn  = input.string("٣ شموع", "قاعدة الدخول", options = ["٣ شموع", "RSI 35 مع متوسط ٢٠٠", "شمعة داخلية وكسر"], group = "الدخول")
entryIn = input.string("عند لمس المستوى (مبكر)", "طريقة الدخول", options = ["عند لمس المستوى (مبكر)", "عند إغلاق الكسر ثم الافتتاح"], group = "الدخول")
lifeN   = input.int(3, "صلاحية المستوى (شموع)", minval = 1, maxval = 10, group = "الدخول")
dirIn   = input.string("كول وبوت", "الاتجاه", options = ["كول وبوت", "كول فقط", "بوت فقط"], group = "الدخول")
stopX   = input.float(3.0, "الوقف (× ATR)", minval = 0.5, step = 0.5, group = "الخروج")
tgtX    = input.float(1.0, "الهدف (× ATR)", minval = 0.25, step = 0.25, group = "الخروج")

a      = ta.atr(14)
e200   = ta.ema(close, 200)
r14    = ta.rsi(close, 14)
ready  = bar_index >= 210 and not na(a) and not na(e200)
allowL = dirIn != "بوت فقط"
allowS = dirIn != "كول فقط"
early  = entryIn == "عند لمس المستوى (مبكر)"

setL3 = close[2] < open[2] and close[1] > open[1] and close > open
setS3 = close[2] > open[2] and close[1] < open[1] and close < open
setLr = r14 < 35 and close > e200
setSr = r14 > 65 and close < e200
setLi = high < high[1] and low > low[1]
setL = ready and allowL and (ruleIn == "٣ شموع" ? setL3 : ruleIn == "RSI 35 مع متوسط ٢٠٠" ? setLr : setLi)
setS = ready and allowS and (ruleIn == "٣ شموع" ? setS3 : ruleIn == "RSI 35 مع متوسط ٢٠٠" ? setSr : setLi)
lvlL = ruleIn == "٣ شموع" ? math.max(high, high[1]) : high
lvlS = ruleIn == "٣ شموع" ? math.min(low, low[1]) : low

var int   pSide = 0
var float pLvl  = na
var int   pExp  = 0
var float unit  = na
flat = strategy.position_size == 0

if barstate.isconfirmed
    // انتهاء الصلاحية: ألغِ الأمر المعلّق
    if pSide != 0 and bar_index > pExp
        strategy.cancel("كول")
        strategy.cancel("بوت")
        pSide := 0
    // (طريقة الإغلاق) إغلاق فوق المستوى = دخول على افتتاح التالية
    if not early and flat and pSide != 0 and bar_index <= pExp
        if pSide == 1 and close > pLvl
            strategy.entry("كول", strategy.long)
            pSide := 0
        else if pSide == -1 and close < pLvl
            strategy.entry("بوت", strategy.short)
            pSide := 0
    // تهيئة جديدة
    if flat and pSide == 0 and (setL or setS)
        pSide := setL ? 1 : -1
        pLvl := setL ? lvlL : lvlS
        pExp := bar_index + lifeN
        unit := a
        if early
            if setL
                strategy.entry("كول", strategy.long, stop = pLvl)
            else
                strategy.entry("بوت", strategy.short, stop = pLvl)
        line.new(bar_index, pLvl, bar_index + lifeN, pLvl, color = setL ? color.new(#16A34A, 30) : color.new(#DC2626, 30), style = line.style_dashed)

// بعد التنفيذ يُلغى المستوى، ويوضع الوقف والهدف بمسافة ATR شمعة التهيئة
if strategy.position_size != 0 and pSide != 0
    pSide := 0
if strategy.position_size > 0
    strategy.exit("خروج", from_entry = "كول", stop = strategy.position_avg_price - stopX * unit, limit = strategy.position_avg_price + tgtX * unit)
if strategy.position_size < 0
    strategy.exit("خروج", from_entry = "بوت", stop = strategy.position_avg_price + stopX * unit, limit = strategy.position_avg_price - tgtX * unit)

// ═══════════════════════════ لوحة الصدق ══════════════════════════════════
nT     = strategy.closedtrades
nW     = strategy.wintrades
wr     = nT > 0 ? 100.0 * nW / nT : 0.0
needWr = 100.0 * stopX / (stopX + tgtX)
net    = strategy.netprofit
var table pt = na
f_row(int r, string k, string v, color c) =>
    table.cell(pt, 0, r, k, text_color = color.new(#9CA3AF, 0), bgcolor = color.new(#1F2937, 10), text_size = size.tiny)
    table.cell(pt, 1, r, v, text_color = c, bgcolor = color.new(#1F2937, 10), text_size = size.small)
if barstate.islast
    if na(pt)
        pt := table.new(position.bottom_right, 2, 8, border_width = 1, border_color = color.new(#000000, 80), frame_width = 1, frame_color = color.new(#000000, 70))
    table.cell(pt, 0, 0, "مِرصاد ٨٠ — اختبار", text_color = color.white, bgcolor = color.new(#111827, 0), text_size = size.small)
    table.cell(pt, 1, 0, syminfo.ticker + " · " + timeframe.period, text_color = color.new(#D1D5DB, 0), bgcolor = color.new(#111827, 0), text_size = size.small)
    f_row(1, "القاعدة", ruleIn + " · وقف " + str.tostring(stopX, "#.#") + " هدف " + str.tostring(tgtX, "#.##"), color.new(#D1D5DB, 0))
    f_row(2, "الدخول", early ? "مبكر: أمر معلّق على المستوى" : "متأخر: بعد إغلاق الكسر", color.new(#D1D5DB, 0))
    f_row(3, "الصفقات", str.tostring(nT) + (nT < 30 ? " (عينة صغيرة)" : ""), color.new(#D1D5DB, 0))
    f_row(4, "نسبة النجاح", str.tostring(wr, "#.#") + "%", wr >= needWr ? color.new(#4ADE80, 0) : color.new(#FCA5A5, 0))
    f_row(5, "المطلوب للتعادل", str.tostring(needWr, "#.#") + "% قبل التكلفة", color.new(#FCD34D, 0))
    f_row(6, "صافي الربح", str.tostring(net, "+#,###;-#,###") + " " + syminfo.currency, net > 0 ? color.new(#4ADE80, 0) : color.new(#FCA5A5, 0))
    f_row(7, "الحكم", nT < 30 ? "لم يكتمل" : net > 0 ? "رابح" : "خاسر رغم النسبة ⚠", nT < 30 ? color.new(#D1D5DB, 0) : net > 0 ? color.new(#4ADE80, 0) : color.new(#FCA5A5, 0))
