// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// مِرصاد ٨٠ — نسخة الاختبار (Strategy Tester). نفس قواعد المؤشر بالضبط، لتشاهد النسبة والربح في تستر TradingView.
//@version=5
strategy("مِرصاد ٨٠ — اختبار", "MIRSAD 80 TEST", overlay = true, max_labels_count = 500, initial_capital = 100000, default_qty_type = strategy.fixed, default_qty_value = 100, commission_type = strategy.commission.percent, commission_value = 0.02, slippage = 1)

ruleIn = input.string("٣ شموع", "قاعدة الدخول", options = ["٣ شموع", "RSI 35 مع متوسط ٢٠٠", "شمعة داخلية وكسر"], group = "الدخول")
dirIn  = input.string("كول وبوت", "الاتجاه", options = ["كول وبوت", "كول فقط", "بوت فقط"], group = "الدخول")
stopX  = input.float(3.0, "الوقف (× ATR)", minval = 0.5, step = 0.5, group = "الخروج")
tgtX   = input.float(1.0, "الهدف (× ATR)", minval = 0.25, step = 0.25, group = "الخروج")

a      = ta.atr(14)
e200   = ta.ema(close, 200)
r14    = ta.rsi(close, 14)
ready  = bar_index >= 210 and not na(a) and not na(e200)
allowL = dirIn != "بوت فقط"
allowS = dirIn != "كول فقط"

threeL = close[3] < open[3] and close[2] > open[2] and close[1] > open[1] and close > open and close > math.max(high[1], high[2])
threeS = close[3] > open[3] and close[2] < open[2] and close[1] < open[1] and close < open and close < math.min(low[1], low[2])
rsiL   = r14 < 35 and close > e200
rsiS   = r14 > 65 and close < e200
inside = high[1] < high[2] and low[1] > low[2]
inL    = inside and close > high[1]
inS    = inside and close < low[1]
sigL = ready and allowL and (ruleIn == "٣ شموع" ? threeL : ruleIn == "RSI 35 مع متوسط ٢٠٠" ? rsiL : inL)
sigS = ready and allowS and (ruleIn == "٣ شموع" ? threeS : ruleIn == "RSI 35 مع متوسط ٢٠٠" ? rsiS : inS)

// الدخول على افتتاح الشمعة التالية (الأمر يُرسل عند إغلاق شمعة الإشارة). الوقف والهدف بمسافة ATR شمعة الإشارة.
var float unit = na
if barstate.isconfirmed and strategy.position_size == 0
    if sigL
        unit := a
        strategy.entry("كول", strategy.long)
    else if sigS
        unit := a
        strategy.entry("بوت", strategy.short)
if strategy.position_size > 0
    strategy.exit("خروج", from_entry = "كول", stop = strategy.position_avg_price - stopX * unit, limit = strategy.position_avg_price + tgtX * unit)
if strategy.position_size < 0
    strategy.exit("خروج", from_entry = "بوت", stop = strategy.position_avg_price + stopX * unit, limit = strategy.position_avg_price - tgtX * unit)

// ═══════════════════════════ لوحة الصدق ══════════════════════════════════
nT     = strategy.closedtrades
nW     = strategy.wintrades
wr     = nT > 0 ? 100.0 * nW / nT : 0.0
needWr = 100.0 * stopX / (stopX + tgtX)
net    = strategy.netprofit
var table pt = na
f_row(int r, string k, string v, color c) =>
    table.cell(pt, 0, r, k, text_color = color.new(#9CA3AF, 0), bgcolor = color.new(#1F2937, 10), text_size = size.tiny)
    table.cell(pt, 1, r, v, text_color = c, bgcolor = color.new(#1F2937, 10), text_size = size.small)
if barstate.islast
    if na(pt)
        pt := table.new(position.bottom_right, 2, 7, border_width = 1, border_color = color.new(#000000, 80), frame_width = 1, frame_color = color.new(#000000, 70))
    table.cell(pt, 0, 0, "مِرصاد ٨٠ — اختبار", text_color = color.white, bgcolor = color.new(#111827, 0), text_size = size.small)
    table.cell(pt, 1, 0, syminfo.ticker + " · " + timeframe.period, text_color = color.new(#D1D5DB, 0), bgcolor = color.new(#111827, 0), text_size = size.small)
    f_row(1, "القاعدة", ruleIn + " · وقف " + str.tostring(stopX, "#.#") + " هدف " + str.tostring(tgtX, "#.##"), color.new(#D1D5DB, 0))
    f_row(2, "الصفقات", str.tostring(nT) + (nT < 30 ? " (عينة صغيرة)" : ""), color.new(#D1D5DB, 0))
    f_row(3, "نسبة النجاح", str.tostring(wr, "#.#") + "%", wr >= needWr ? color.new(#4ADE80, 0) : color.new(#FCA5A5, 0))
    f_row(4, "المطلوب للتعادل", str.tostring(needWr, "#.#") + "% قبل التكلفة", color.new(#FCD34D, 0))
    f_row(5, "صافي الربح", str.tostring(net, "+#,###;-#,###") + " " + syminfo.currency, net > 0 ? color.new(#4ADE80, 0) : color.new(#FCA5A5, 0))
    f_row(6, "الحكم", nT < 30 ? "لم يكتمل" : net > 0 ? "رابح" : "خاسر رغم النسبة ⚠", nT < 30 ? color.new(#D1D5DB, 0) : net > 0 ? color.new(#4ADE80, 0) : color.new(#FCA5A5, 0))
