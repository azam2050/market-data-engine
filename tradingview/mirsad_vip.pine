//@version=5
// ============================================================================
//  مرصاد VIP — لوحة العقود المؤسسية
// ----------------------------------------------------------------------------
//  مذهب هذا المؤشر:
//
//  ١) العقد ليس سهماً. من يفتح فريم الدقيقة يريد عقداً حارقاً: دخول، ربح
//     سريع، خروج — لأن الوقت نفسه يأكل قيمة عقده. ومن يفتح الساعة يريد أن
//     يركب موجة يومين. فلكل فريم أهدافه ووقفه وإدارته، لا رقم واحد للجميع.
//
//  ٢) الانتظار سلاح ذو حدين. في سوق هادئ يعود السعر فتدخل بسعر ممتاز؛ وفي
//     سوق مندفع لا يعود أبداً فتفوتك أحلى صفقة. لذلك يُنشر أمران معاً: حد
//     تحت للارتداد، واختراق فوق للاندفاع، وأولهما تنفيذاً يلغي الآخر.
//
//  ٣) عقد اليوم يموت الليلة. قبل الإغلاق بمدة محددة لا نشتريه أصلاً؛ الإشارة
//     حينها تُحوَّل لعقد الغد ويُكتب على اللوحة أنها مخاطرة فجوة.
//
//  ٤) لا يُقال "تحت المراقبة" لسهم هو داخل صفقة. شاشة المراقبة تُشغّل محرك
//     الصفقة كاملاً لكل رمز بفريمه، فتقول الحقيقة: يراقب، أم معلق، أم دخل
//     الآن، أم في صفقة وأهدافه تتحقق.
//
//  ٥) كل نتيجة تُحسب صافية بعد تكلفة العقد. صفقة تخرج عند سعر دخولها خسارة
//     لا تعادل.
// ============================================================================
indicator("مرصاد VIP | لوحة العقود", shorttitle="مرصاد VIP", overlay=true,
     max_lines_count=200, max_labels_count=300, max_boxes_count=80)

// ============================ المدخلات ======================================
gP = "شخصية الفريم"
profSel = input.string("تلقائي", "الشخصية", options=["تلقائي", "حارق", "سريع", "نصف يوم", "يوم", "أسبوع"], group=gP, tooltip="تلقائي يقرأ فريم الشارت ويختار الأهداف والوقف المناسبين له")

gQ = "عقل الجودة"
aggro   = input.string("متوازن", "حدة الدخول", options=["هادئ", "متوازن", "نشط"], group=gQ)
minQ    = input.int(60, "أدنى سكور جودة", minval=0, maxval=100, group=gQ)
// أقوى فلتر منفرد في التداول اليومي: لا تشترِ في ساعة هابطة ولا تبِع في
// ساعة صاعدة. يقتل ثلث الصفقات، وأغلبها كان خاسراً.
h1Veto  = input.bool(true, "لا دخول ضد اتجاه الساعة", group=gQ)
volX    = input.float(1.2, "مضاعف الحجم المؤسسي", minval=1.0, maxval=3.0, step=0.1, group=gQ)
adxMin  = input.int(18, "أدنى قوة اتجاه ADX", minval=10, maxval=40, group=gQ)
qualityMode = input.bool(true, "امنع الدخول في سوق ميت", group=gQ)
// ما يُنهي صبر المشترك ليس المتوسط بل صفّ الخسائر. أطول صف في سجلك اثنتا
// عشرة صفقة — يومٌ كهذا يُقفل ولا يُكمَل.
maxLossDay = input.int(3, "أوقف اليوم بعد خسائر متتالية", minval=0, maxval=10, group=gQ)

gE = "طريقة الدخول"
// أمر الاختراق يُوضع فقط حين يكون الاندفاع حقيقياً. وضعه دائماً يلغي وظيفة
// الحدّ في الرفض، فيدخل كل ما كان يُرفض بحق — وهذا ما أنزل المتوسط إلى الصفر.
useBracket = input.bool(true, "أضف أمر اختراق عند الاندفاع القوي فقط", group=gE)
impMin     = input.float(3.4, "عتبة الاندفاع لفتح باب الاختراق", minval=2.5, maxval=5.0, step=0.1, group=gE)
retrX      = input.float(0.5, "عمق الارتداد (من مدى شمعة الشرارة)", minval=0.1, maxval=0.9, step=0.05, group=gE)
brkX       = input.float(0.10, "مسافة أمر الاختراق (ATR)", minval=0.02, maxval=0.5, step=0.02, group=gE)
pExpire    = input.int(3, "صلاحية الأمرين (شموع)", minval=1, maxval=12, group=gE)
minRiskX   = input.float(0.5, "أدنى مسافة وقف (ATR)", minval=0.2, maxval=2.0, step=0.1, group=gE)

gO = "العقود اليومية"
dteCut  = input.int(90, "امنع عقد اليوم قبل الإغلاق بـ (دقيقة)", minval=0, maxval=240, group=gO, tooltip="بعد هذا الوقت يتحول العقد المقترح إلى عقد الغد وتُوسم الإشارة بمخاطرة الفجوة")
flat0dte = input.bool(true, "أغلق صفقات عقد اليوم قبل الجرس", group=gO)
optLev   = input.float(10.0, "الرافعة التقديرية (٪ العقد لكل ١٪ سهم)", minval=3, maxval=30, step=1, group=gO)

gB = "الاختبار الحي"
btDays = input.int(30, "نافذة الحساب (يوم)", minval=1, maxval=365, group=gB)
costR  = input.float(0.15, "تكلفة العقد ذهاباً وإياباً (R)", minval=0.0, maxval=0.6, step=0.05, group=gB)
btPosS = input.string("أسفل يمين", "مكان الجدول", options=["أعلى يمين", "أعلى يسار", "أسفل يمين", "أسفل يسار"], group=gB)

gW = "شاشة المراقبة"
showWatch = input.bool(true, "إظهار الشاشة", group=gW)
wCount    = input.int(3, "عدد الرموز", minval=1, maxval=5, group=gW, tooltip="كل رمز إضافي يجلب بيانات رمز إضافي ويزيد وقت التحميل — ابدأ بثلاثة")
wPosS = input.string("أسفل يسار", "مكان الشاشة", options=["أعلى يمين", "أعلى يسار", "أسفل يمين", "أسفل يسار"], group=gW)
w1s = input.symbol("NASDAQ:AAPL", "١ الرمز", group=gW)
w1t = input.timeframe("60", "١ الفريم", group=gW)
w2s = input.symbol("NASDAQ:NVDA", "٢ الرمز", group=gW)
w2t = input.timeframe("30", "٢ الفريم", group=gW)
w3s = input.symbol("NASDAQ:QQQ", "٣ الرمز", group=gW)
w3t = input.timeframe("5", "٣ الفريم", group=gW)
w4s = input.symbol("NASDAQ:TSLA", "٤ الرمز", group=gW)
w4t = input.timeframe("15", "٤ الفريم", group=gW)
w5s = input.symbol("AMEX:SPY", "٥ الرمز", group=gW)
w5t = input.timeframe("5", "٥ الفريم", group=gW)

gS = "العرض"
showPlan  = input.bool(true, "صندوق الخطة القادمة", group=gS)
showZones = input.bool(true, "مناطق التجميع", group=gS)
showEarly = input.bool(true, "الإشارة التمهيدية (على الشمعة المتكوّنة)", group=gS, tooltip="تظهر قبل إغلاق الشمعة وقد تختفي — ولا تُحتسب في السجل أبداً")
showCloud = input.bool(true, "السحابة", group=gS)
keepTrail = input.bool(true, "آثار الصفقات الماضية", group=gS)
dashPosS  = input.string("أعلى يمين", "مكان اللوحة", options=["أعلى يمين", "أعلى يسار", "أسفل يمين", "أسفل يسار"], group=gS)

// ============================ الألوان =======================================
cUp   = #26A69A
cDn   = #EF5350
cGold = #E3B34D
cCyan = #38C8E8
cTxt  = #D5D9E4
cMut  = #787B86
cYel  = #E8C547
cPanl = color.new(#151A24, 4)
cHead = color.new(#232B3D, 0)

// ==================== شخصية الفريم: لكل فريم نيّة مختلفة ====================
tfMin = timeframe.in_seconds(timeframe.period) / 60.0
autoProf = not timeframe.isintraday ? "أسبوع" : tfMin <= 1 ? "حارق" : tfMin <= 5 ? "سريع" :
     tfMin <= 30 ? "نصف يوم" : tfMin <= 60 ? "يوم" : "أسبوع"
prof = profSel == "تلقائي" ? autoProf : profSel
// الهدف الأول قريب على الفريم الصغير لأن الوقت يأكل العقد، وبعيد على الكبير
tp1x = prof == "حارق" ? 0.5 : prof == "سريع" ? 0.8 : prof == "نصف يوم" ? 1.2 : prof == "يوم" ? 1.8 : 2.5
tp2x = prof == "حارق" ? 0.9 : prof == "سريع" ? 1.5 : prof == "نصف يوم" ? 2.0 : prof == "يوم" ? 3.0 : 4.0
tp3x = prof == "حارق" ? 1.4 : prof == "سريع" ? 2.5 : prof == "نصف يوم" ? 3.2 : prof == "يوم" ? 4.5 : 6.0
tp4x = prof == "حارق" ? 2.0 : prof == "سريع" ? 3.5 : prof == "نصف يوم" ? 4.5 : prof == "يوم" ? 6.0 : 8.0
stopX  = prof == "حارق" ? 0.5 : prof == "سريع" ? 0.7 : prof == "نصف يوم" ? 1.0 : prof == "يوم" ? 1.3 : 1.8
trailX = prof == "حارق" ? 0.8 : prof == "سريع" ? 1.2 : prof == "نصف يوم" ? 1.6 : prof == "يوم" ? 2.2 : 3.0
// الحارق يخرج كاملاً عند الهدف الثاني: لا وقت لمطاردة أهداف بعيدة
maxT  = prof == "حارق" ? 2 : prof == "سريع" ? 3 : 4
coolN = prof == "حارق" ? 3 : prof == "سريع" ? 6 : prof == "نصف يوم" ? 6 : 8
// العقد يفقد قيمته بمرور الوقت وحده. صفقة لم تصل هدفها الأول خلال هذه المدة
// ليست صفقة بطيئة — هي صفقة ميتة تنزف قيمة زمنية، والخروج منها ربح.
timeStop = prof == "حارق" ? 6 : prof == "سريع" ? 10 : prof == "نصف يوم" ? 12 : prof == "يوم" ? 14 : 20

// ============================ حسابات أساسية =================================
atr   = ta.atr(14)
rngHL = math.max(high - low, syminfo.mintick)
body  = math.abs(close - open)
hasVol = not na(volume) and ta.sma(volume, 20) > 0
volMA  = hasVol ? ta.sma(volume, 20) : na
volSpike = hasVol ? volume > volX * volMA : body > 0.7 * atr
absorption = hasVol and volume > 1.5 * volMA and body < 0.5 * atr
rsi = ta.rsi(close, 14)
[diPlus, diMinus, adx] = ta.dmi(14, 14)

cloudFast = ta.hma(close, 21)
cloudSlow = ta.ema(close, 55)
ema9      = ta.ema(close, 9)
inCloud   = close <= math.max(cloudFast, cloudSlow) and close >= math.min(cloudFast, cloudSlow)
cloudDir  = cloudFast > cloudSlow ? 1 : -1
pF = plot(showCloud ? cloudFast : na, "السحابة السريعة", color=color.new(cloudDir > 0 ? cUp : cDn, 55), linewidth=1)
pS = plot(showCloud ? cloudSlow : na, "السحابة البطيئة", color=color.new(cMut, 65), linewidth=1)
fill(pF, pS, color=color.new(cloudDir > 0 ? cUp : cDn, 90))

// ============================ البنية ========================================
pv3H = ta.pivothigh(high, 3, 3)
pv3L = ta.pivotlow(low, 3, 3)
var float sw3H = na
var float sw3L = na
if not na(pv3H)
    sw3H := pv3H
if not na(pv3L)
    sw3L := pv3L
pv10H = ta.pivothigh(high, 10, 10)
pv10L = ta.pivotlow(low, 10, 10)
var float majH = na
var float majL = na
var int   majHB = na
var int   majLB = na
if not na(pv10H)
    majH := pv10H
    majHB := bar_index - 10
if not na(pv10L)
    majL := pv10L
    majLB := bar_index - 10

var int structDir = 0
bosUp = not na(sw3H) and close > sw3H and close[1] <= sw3H
bosDn = not na(sw3L) and close < sw3L and close[1] >= sw3L
chochUp = bosUp and structDir == -1
chochDn = bosDn and structDir == 1
if bosUp
    structDir := 1
if bosDn
    structDir := -1

[pdH, pdL] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_off)
impUp = not na(majH) and not na(majL) and majHB > majLB and majH > majL
impDn = not na(majH) and not na(majL) and majLB > majHB and majH > majL
fzTop = impUp ? majH - (majH - majL) * 0.618 : impDn ? majL + (majH - majL) * 0.786 : na
fzBot = impUp ? majH - (majH - majL) * 0.786 : impDn ? majL + (majH - majL) * 0.618 : na
inFib = not na(fzTop) and close <= math.max(fzTop, fzBot) and close >= math.min(fzTop, fzBot)
nearSup = (not na(majL) and math.abs(close - majL) < 1.0 * atr) or (not na(pdL) and math.abs(close - pdL) < 1.0 * atr)
nearRes = (not na(majH) and math.abs(close - majH) < 1.0 * atr) or (not na(pdH) and math.abs(close - pdH) < 1.0 * atr)
atZoneUp = (inFib and impUp) or nearSup
atZoneDn = (inFib and impDn) or nearRes

// ==================== مناطق التجميع: أثر المؤسسة الصامت ====================
// مدى ضيق + حجم مرتفع + إغلاقات متداخلة، خمس شموع فأكثر. عندما تُكسر بحجم
// فالكسر حقيقي؛ وبلا حجم فهو فخ يُتجاهل.
tight = rngHL < 0.7 * atr
heavy = hasVol and volume > 1.3 * volMA
accBar = tight and heavy
var int   accRun  = 0
var float accHi   = na
var float accLo   = na
var int   accStart = 0
var box   accBox  = na
var float zoneHi  = na
var float zoneLo  = na
var int   zoneDir = 0
var int   zoneBar = -999
accRun := accBar ? accRun + 1 : 0
if accBar
    if accRun == 1
        accHi := high
        accLo := low
        accStart := bar_index
    else
        accHi := math.max(accHi, high)
        accLo := math.min(accLo, low)
if accRun == 5 and showZones
    accBox := box.new(accStart, accHi, bar_index, accLo, border_color=color.new(cCyan, 40), bgcolor=color.new(cCyan, 90))
if accRun > 5
    if showZones and not na(accBox)
        box.set_right(accBox, bar_index)
        box.set_top(accBox, accHi)
        box.set_bottom(accBox, accLo)
    zoneHi := accHi
    zoneLo := accLo
zoneUp = not na(zoneHi) and close > zoneHi and close[1] <= zoneHi and volSpike
zoneDn = not na(zoneLo) and close < zoneLo and close[1] >= zoneLo and volSpike
if zoneUp or zoneDn
    zoneDir := zoneUp ? 1 : -1
    zoneBar := bar_index
    zoneHi := na
    zoneLo := na
if bar_index - zoneBar > 10
    zoneDir := 0

// ==================== وايكوف والسيولة والشموع ==============================
tol = 0.05 * atr
supLvl = not na(majL) and not na(pdL) ? math.max(majL, pdL) : not na(majL) ? majL : pdL
resLvl = not na(majH) and not na(pdH) ? math.min(majH, pdH) : not na(majH) ? majH : pdH
spring   = not na(supLvl) and low < supLvl - tol and close > supLvl and close > open and (volSpike or absorption)
upthrust = not na(resLvl) and high > resLvl + tol and close < resLvl and close < open and (volSpike or absorption)
sweepUp  = not na(sw3L) and low < sw3L - tol and close > sw3L and close > open
sweepDn  = not na(sw3H) and high > sw3H + tol and close < sw3H and close < open

upWick = high - math.max(close, open)
dnWick = math.min(close, open) - low
bullPin = dnWick > 2.0 * body and upWick < body and close >= open
bearPin = upWick > 2.0 * body and dnWick < body and close <= open
bullEng = close > open and close[1] < open[1] and close >= open[1] and open <= close[1] and body > 0.4 * atr
bearEng = close < open and close[1] > open[1] and close <= open[1] and open >= close[1] and body > 0.4 * atr
thrustUp = close > open and close[1] > open[1] and close[2] > open[2] and body > body[1] and body[1] > body[2]
thrustDn = close < open and close[1] < open[1] and close[2] < open[2] and body > body[1] and body[1] > body[2]
insideBrkUp = high[1] <= high[2] and low[1] >= low[2] and close > high[1]
insideBrkDn = high[1] <= high[2] and low[1] >= low[2] and close < low[1]
paUp = bullPin or bullEng or thrustUp or insideBrkUp
paDn = bearPin or bearEng or thrustDn or insideBrkDn

divBull = not na(pv3L) and rsi < 45 and rsi > rsi[3]
divBear = not na(pv3H) and rsi > 55 and rsi < rsi[3]
momUp = (rsi > 50 and rsi > rsi[1]) or divBull or rsi < 32
momDn = (rsi < 50 and rsi < rsi[1]) or divBear or rsi > 68

// ============================ الفريمات والميل ===============================
f_dir() =>
    eF = ta.ema(close, 9)
    eS = ta.ema(close, 21)
    eF > eS and close > eS ? 1 : eF < eS and close < eS ? -1 : 0
d01 = request.security(syminfo.tickerid, "1",  f_dir(), lookahead=barmerge.lookahead_off)
d03 = request.security(syminfo.tickerid, "3",  f_dir(), lookahead=barmerge.lookahead_off)
d05 = request.security(syminfo.tickerid, "5",  f_dir(), lookahead=barmerge.lookahead_off)
d15 = request.security(syminfo.tickerid, "15", f_dir(), lookahead=barmerge.lookahead_off)
d60 = request.security(syminfo.tickerid, "60", f_dir(), lookahead=barmerge.lookahead_off)
biasSum = (d05 > 0 ? 1 : d05 < 0 ? -1 : 0) + (d15 > 0 ? 1 : d15 < 0 ? -1 : 0) +
     (d60 > 0 ? 1 : d60 < 0 ? -1 : 0) + cloudDir
bias = biasSum >= 2 ? 1 : biasSum <= -2 ? -1 : 0

// محرك الاستمرار: تصحيح إلى السحابة ثم أول شمعة تستأنف
pbUp = math.max(cloudFast, ema9)
pbDn = math.min(cloudFast, ema9)
var bool armUp = false
var bool armDn = false
if bias > 0 and low <= pbUp + 0.20 * atr
    armUp := true
    armDn := false
if bias < 0 and high >= pbDn - 0.20 * atr
    armDn := true
    armUp := false
if bias <= 0
    armUp := false
if bias >= 0
    armDn := false
contUp = armUp and close > open and close > high[1] and close > cloudFast and body > 0.25 * atr
contDn = armDn and close < open and close < low[1] and close < cloudFast and body > 0.25 * atr
if contUp
    armUp := false
if contDn
    armDn := false

// ============================ سكور الجودة ===================================
f_q(sideUp) =>
    q = 0
    q := q + ((sideUp ? bias > 0 : bias < 0) ? 20 : 0)
    q := q + ((volSpike or absorption) ? 20 : 0)
    q := q + ((sideUp ? (paUp or contUp or spring or sweepUp) : (paDn or contDn or upthrust or sweepDn)) ? 20 : 0)
    q := q + ((sideUp ? (atZoneUp or cloudDir > 0) : (atZoneDn or cloudDir < 0)) ? 20 : 0)
    q := q + ((sideUp ? momUp : momDn) ? 20 : 0)
    q := q + ((sideUp ? zoneDir > 0 : zoneDir < 0) ? 10 : 0)
    math.min(100, q)
qUp = f_q(true)
qDn = f_q(false)
lead      = qUp >= qDn ? 1 : -1
leadScore = math.max(qUp, qDn)

f_miss(sideUp) =>
    m = ""
    m := m + ((sideUp ? bias > 0 : bias < 0) ? "" : "فريمات · ")
    m := m + ((volSpike or absorption) ? "" : "حجم · ")
    m := m + ((sideUp ? (paUp or contUp or spring or sweepUp) : (paDn or contDn or upthrust or sweepDn)) ? "" : "نموذج · ")
    m := m + ((sideUp ? (atZoneUp or cloudDir > 0) : (atZoneDn or cloudDir < 0)) ? "" : "منطقة · ")
    m := m + ((sideUp ? momUp : momDn) ? "" : "زخم")
    m

// ==================== العقد اليومي والجرس ==================================
isFund = syminfo.ticker == "QQQ" or syminfo.ticker == "SPY" or syminfo.ticker == "SPX" or syminfo.ticker == "IWM"
sessEnd = timeframe.isintraday ? time_close("D") : na
minsLeft = na(sessEnd) ? na : (sessEnd - time) / 60000.0
lateSession = not na(minsLeft) and minsLeft <= dteCut
atBell = timeframe.isintraday and session.islastbar_regular
// عقد اليوم قبل النافذة، وعقد الغد بعدها — وهي حينها مخاطرة فجوة صريحة
expiryTxt = not isFund ? "جمعة الأسبوع" : lateSession ? "الغد ⚠️" : "اليوم 0DTE"
gapRisk = isFund and lateSession

// ============================ قياس الاندفاع =================================
// الاندفاع يقرر أي البابين نتوقع: العائد يرتد، والمندفع لا يعود
impulse = (body / math.max(atr, syminfo.mintick)) +
     (hasVol ? math.min(2.0, volume / math.max(volMA, 1)) : 1.0) +
     (adx >= 25 and adx > adx[1] ? 1.0 : 0.0)
strongImp = impulse >= impMin

// ============================ حالة الصفقة ==================================
var bool  inTrade = false
var int   tDir    = 0
var float entryP  = na
var float stopP   = na
var float stop0   = na
var float tp1 = na
var float tp2 = na
var float tp3 = na
var float tp4 = na
var int   hits = 0
var bool  was0dte = false
var int   entryBar = 0
var int   lastExit = -99999
var line  lnEntry = na
var line  lnStop  = na
var int   winsAll = 0
var int   lossAll = 0
var float sumR    = 0.0
var float sumRnet = 0.0
var int   lossRun = 0
var int   maxLossRun = 0
var int   btTot = 0
var int   btWin = 0
var int   btCallTot = 0
var int   btCallWin = 0
var int   btPutTot  = 0
var int   btPutWin  = 0
var float btGross = 0.0
var float btLoss  = 0.0
var int   tradesToday = 0
var int   missedToday = 0
var int   lossRunDay  = 0
var int   missedCnt   = 0
if ta.change(time("D")) != 0
    tradesToday := 0
    missedToday := 0
    lossRunDay  := 0
f_side(d) => d > 0 ? "كول" : "بوت"

// ============================ الأمران المعلقان ==============================
var int    pDir   = 0
var float  pLimit = na
var float  pBreak = na
var float  pStop  = na
var int    pBar   = 0
var string pWhy   = ""
var bool   pStrong = false
var line   lnLim  = na
var line   lnBrk  = na

trigUp = contUp or spring or sweepUp or chochUp or zoneUp or (bosUp and (volSpike or bias > 0))
trigDn = contDn or upthrust or sweepDn or chochDn or zoneDn or (bosDn and (volSpike or bias < 0))
minQeff = math.max(0, math.min(100, minQ + (aggro == "هادئ" ? 20 : aggro == "نشط" ? -20 : 0)))
coolEff = aggro == "هادئ" ? coolN * 2 : aggro == "نشط" ? math.max(1, coolN / 2) : coolN
qGateUp = not qualityMode or contUp or atZoneUp or (adx >= adxMin and cloudDir >= 0)
qGateDn = not qualityMode or contDn or atZoneDn or (adx >= adxMin and cloudDir <= 0)
dayOpen = maxLossDay == 0 or lossRunDay < maxLossDay
canEnter = barstate.isconfirmed and not inTrade and pDir == 0 and dayOpen and (bar_index - lastExit) > coolEff and bar_index > 60
longSig  = canEnter and trigUp and qUp >= minQeff and qGateUp and (not h1Veto or d60 >= 0)
shortSig = canEnter and not longSig and trigDn and qDn >= minQeff and qGateDn and (not h1Veto or d60 <= 0)
sigDir = longSig ? 1 : shortSig ? -1 : 0
sigWhy = sigDir == 0 ? "" :
     (sigDir > 0 ? (zoneUp ? "كسر منطقة تجميع بحجم" : contUp ? "استئناف بعد تصحيح مع الاتجاه" : spring ? "سبرينق وايكوف على الدعم" : chochUp ? "انقلاب طابع CHoCH" : sweepUp ? "مسح سيولة تحت قاع" : "كسر بنية BOS")
     : (zoneDn ? "كسر منطقة توزيع بحجم" : contDn ? "استئناف بعد تصحيح مع الاتجاه" : upthrust ? "أبثراست وايكوف على المقاومة" : chochDn ? "انقلاب طابع CHoCH" : sweepDn ? "مسح سيولة فوق قمة" : "كسر بنية BOS"))

if sigDir != 0
    pDir   := sigDir
    pBar   := bar_index
    pWhy   := sigWhy
    pStrong := strongImp
    // المندفع: اختراق قريب ووقف واسع خلف الشمعة كاملة، لأننا ندفع سعراً أعلى
    // الهادئ: حد أعمق ووقف أضيق، لأننا ندخل بسعر أفضل
    dLim = strongImp ? retrX * 0.6 : retrX
    dBrk = strongImp ? brkX * 0.6 : brkX
    pLimit := sigDir > 0 ? high - dLim * rngHL : low + dLim * rngHL
    pBreak := strongImp ? (sigDir > 0 ? high + dBrk * atr : low - dBrk * atr) : na
    base = sigDir > 0 ? math.min(low, pLimit) : math.max(high, pLimit)
    pStop := sigDir > 0 ? base - stopX * atr : base + stopX * atr
    if showPlan
        lnLim := line.new(bar_index, pLimit, bar_index + pExpire, pLimit, color=color.new(cYel, 20), style=line.style_dashed, width=1)
        lnBrk := useBracket and not na(pBreak) ? line.new(bar_index, pBreak, bar_index + pExpire, pBreak, color=color.new(cCyan, 30), style=line.style_dotted, width=1) : na
    label.new(bar_index, sigDir > 0 ? low : high,
         "⏳ " + f_side(sigDir) + "  حد " + str.tostring(pLimit, format.mintick) + (useBracket and not na(pBreak) ? " · اختراق " + str.tostring(pBreak, format.mintick) : ""),
         style=sigDir > 0 ? label.style_label_up : label.style_label_down,
         color=color.new(cYel, 25), textcolor=#20180A, size=size.small)
    alert("⏳ أمر معلق " + f_side(sigDir) + " | " + syminfo.ticker + " فريم " + timeframe.period +
         " | حد " + str.tostring(pLimit, format.mintick) +
         (useBracket and not na(pBreak) ? " | اختراق " + str.tostring(pBreak, format.mintick) : "") +
         " | وقف " + str.tostring(pStop, format.mintick) +
         " | " + (strongImp ? "زخم عالٍ" : "سوق هادئ") + " | السبب: " + pWhy, alert.freq_once_per_bar)

// ============================ التنفيذ ======================================
fillNow = false
float fillP = na
int   fDir  = 0
bool  byBrk = false
if pDir != 0 and not inTrade and barstate.isconfirmed and bar_index > pBar
    hitLim = pDir > 0 ? low <= pLimit : high >= pLimit
    hitBrk = useBracket and (pDir > 0 ? high >= pBreak : low <= pBreak)
    // إن لمس الاثنان في شمعة واحدة نأخذ الأسوأ: لا نمنح أنفسنا أفضل احتمال
    if hitLim or hitBrk
        fillNow := true
        byBrk := hitBrk
        fillP := byBrk ? pBreak : (pDir > 0 ? math.min(open, pLimit) : math.max(open, pLimit))
        fDir := pDir
    else if bar_index - pBar >= pExpire or (pDir > 0 ? close < pStop : close > pStop)
        missedCnt += 1
        missedToday += 1
        pDir := 0
        line.delete(lnLim)
        line.delete(lnBrk)

if fillNow
    inTrade := true
    tradesToday += 1
    entryBar := bar_index
    tDir   := fDir
    entryP := fillP
    stopP  := fDir > 0 ? math.min(pStop, entryP - minRiskX * atr) : math.max(pStop, entryP + minRiskX * atr)
    stop0  := stopP
    tp1 := fDir > 0 ? entryP + tp1x * atr : entryP - tp1x * atr
    tp2 := fDir > 0 ? entryP + tp2x * atr : entryP - tp2x * atr
    tp3 := fDir > 0 ? entryP + tp3x * atr : entryP - tp3x * atr
    tp4 := fDir > 0 ? entryP + tp4x * atr : entryP - tp4x * atr
    hits := 0
    was0dte := isFund and not lateSession
    pDir := 0
    line.delete(lnLim)
    line.delete(lnBrk)
    lnEntry := line.new(bar_index, entryP, bar_index + 1, entryP, extend=extend.right, color=color.new(cTxt, 35), style=line.style_dotted, width=1)
    lnStop  := line.new(bar_index, stopP, bar_index + 1, stopP, extend=extend.right, color=#FF9E45, width=2)
    label.new(bar_index, fDir > 0 ? low : high,
         "🎯 " + f_side(fDir) + " " + str.tostring(entryP, format.mintick) + (byBrk ? " ⚡اختراق" : ""),
         style=fDir > 0 ? label.style_label_up : label.style_label_down,
         color=fDir > 0 ? cUp : cDn, textcolor=fDir > 0 ? #04211D : #2B0606, size=size.normal)
    alert("🎯 دخول " + f_side(fDir) + " | " + syminfo.ticker + " فريم " + timeframe.period +
         " | سعر " + str.tostring(entryP, format.mintick) + " | وقف " + str.tostring(stopP, format.mintick) +
         " | العقد " + expiryTxt + (gapRisk ? " (مخاطرة فجوة)" : "") +
         " | السبب: " + pWhy, alert.freq_once_per_bar)

// ============================ الإدارة ======================================
tpHit1 = false
tpHit2 = false
tpHit3 = false
tpHit4 = false
slHit  = false
// عقد اليوم لا يبيت: يُقفل مع الجرس. أما صفقة أُخذت على عقد الغد فتُترك
mustFlat = inTrade and atBell and flat0dte and was0dte
if inTrade and barstate.isconfirmed and bar_index >= entryBar
    if bar_index > entryBar
        if hits < 1 and (tDir > 0 ? high >= tp1 : low <= tp1)
            hits := 1
            tpHit1 := true
            alert("🔺 هدف 1 | " + syminfo.ticker, alert.freq_once_per_bar)
        if hits < 2 and (tDir > 0 ? high >= tp2 : low <= tp2)
            hits := 2
            tpHit2 := true
            alert("🔺 هدف 2 | " + syminfo.ticker, alert.freq_once_per_bar)
        if hits < 3 and (tDir > 0 ? high >= tp3 : low <= tp3)
            hits := 3
            tpHit3 := true
            alert("🔺 هدف 3 | " + syminfo.ticker, alert.freq_once_per_bar)
        if hits < 4 and (tDir > 0 ? high >= tp4 : low <= tp4)
            hits := 4
            tpHit4 := true
            alert("🔺 الهدف الممتد | " + syminfo.ticker, alert.freq_once_per_bar)
        if hits >= 1
            chand = tDir > 0 ? close - trailX * atr : close + trailX * atr
            stopP := tDir > 0 ? math.max(stopP, chand) : math.min(stopP, chand)
        if hits >= 2
            stopP := tDir > 0 ? math.max(stopP, entryP) : math.min(stopP, entryP)
    line.set_y1(lnStop, stopP)
    line.set_y2(lnStop, stopP)
    hardStop = hits < 1 and (tDir > 0 ? low <= stop0 : high >= stop0)
    softStop = hits >= 1 and (tDir > 0 ? close < stopP : close > stopP)
    doneT    = hits >= maxT
    // لم تبلغ هدفها الأول في وقتها: العقد ينزف قيمة زمنية بلا حركة تعوّضها
    deadTime = hits < 1 and (bar_index - entryBar) >= timeStop
    if hardStop or softStop or doneT or mustFlat or deadTime
        slHit := true
        risk  = math.abs(entryP - stop0)
        gapped = tDir > 0 ? open < stop0 : open > stop0
        exitP = hardStop ? (gapped ? open : stop0) : close
        rGross = risk > 0 ? (tDir > 0 ? exitP - entryP : entryP - exitP) / risk : 0.0
        rMult = rGross - costR
        win   = rMult > 0
        winsAll += win ? 1 : 0
        lossAll += win ? 0 : 1
        sumR    += rGross
        sumRnet += rMult
        lossRun := win ? 0 : lossRun + 1
        maxLossRun := math.max(maxLossRun, lossRun)
        if time >= timenow - btDays * 86400000.0
            btTot += 1
            btWin += win ? 1 : 0
            btCallTot += tDir > 0 ? 1 : 0
            btCallWin += tDir > 0 and win ? 1 : 0
            btPutTot  += tDir < 0 ? 1 : 0
            btPutWin  += tDir < 0 and win ? 1 : 0
            btGross += rMult > 0 ? rMult : 0.0
            btLoss  += rMult < 0 ? -rMult : 0.0
        if keepTrail
            line.set_extend(lnEntry, extend.none)
            line.set_x2(lnEntry, bar_index)
            line.new(entryBar, entryP, bar_index, exitP, color=win ? color.new(cUp, 35) : color.new(cDn, 30), width=2)
        else
            line.delete(lnEntry)
        line.delete(lnStop)
        label.new(bar_index, tDir > 0 ? low : high,
             (win ? "✅ +" : "🔴 ") + str.tostring(rMult, "#.#") + "R",
             style=tDir > 0 ? label.style_label_up : label.style_label_down,
             color=win ? color.new(cUp, 20) : color.new(cDn, 10),
             textcolor=win ? #04211D : #2B0606, size=size.normal)
        lossRunDay := win ? 0 : lossRunDay + 1
        alert((win ? "✅" : "🔴") + " خروج — " + (mustFlat ? "إغلاق عقد اليوم" : doneT ? "الهدف الأخير" : deadTime ? "انتهاء المهلة" : "الوقف") +
             " | " + syminfo.ticker + " | النتيجة " + (win ? "+" : "") + str.tostring(rMult, "#.#") + "R", alert.freq_once_per_bar)
        inTrade := false
        lastExit := bar_index

alertcondition(fDir > 0, "CALL Entry", "CALL entry signal")
alertcondition(fDir < 0, "PUT Entry", "PUT entry signal")
alertcondition(slHit,  "Exit", "Trade closed")
alertcondition(tpHit1, "TP1 Hit", "Target 1 hit")
alertcondition(tpHit2, "TP2 Hit", "Target 2 hit")
alertcondition(tpHit3, "TP3 Hit", "Target 3 hit")
alertcondition(tpHit4, "TP4 Hit", "Target 4 hit")

// ==================== الإشارة التمهيدية على الشمعة المتكوّنة ================
// تُرى مبكراً وقد تختفي قبل الإغلاق. لا تُحتسب في السجل أبداً — وهذا هو
// الفرق بين إظهارها وبين الكذب في الأرقام.
earlyUp = showEarly and barstate.islast and not barstate.isconfirmed and pDir == 0 and not inTrade and trigUp and qUp >= minQeff and qGateUp
earlyDn = showEarly and barstate.islast and not barstate.isconfirmed and pDir == 0 and not inTrade and not earlyUp and trigDn and qDn >= minQeff and qGateDn
secsLeft = timeframe.isintraday and not na(time_close) ? math.max(0, (time_close - timenow) / 1000) : na
earlyTxt = earlyUp ? "🔸 كول يتشكّل" : earlyDn ? "🔹 بوت يتشكّل" : ""

// ============================ العقد المقترح ================================
f_step(p) => p < 50 ? 0.5 : p < 200 ? 1.0 : p < 500 ? 2.5 : 5.0
liveDir = inTrade ? tDir : pDir != 0 ? pDir : lead
optBase = inTrade ? entryP : close
optStep = f_step(optBase)
optStrk = liveDir > 0 ? math.ceil(optBase / optStep) * optStep : math.floor(optBase / optStep) * optStep
f_optPct(tgt) => optBase > 0 and not na(tgt) ? math.abs(tgt - optBase) / optBase * 100.0 * optLev : na
oP1 = f_optPct(inTrade ? tp1 : (liveDir > 0 ? close + tp1x * atr : close - tp1x * atr))
oP2 = f_optPct(inTrade ? tp2 : (liveDir > 0 ? close + tp2x * atr : close - tp2x * atr))
oP3 = f_optPct(inTrade ? tp3 : (liveDir > 0 ? close + tp3x * atr : close - tp3x * atr))
oP4 = f_optPct(inTrade ? tp4 : (liveDir > 0 ? close + tp4x * atr : close - tp4x * atr))
f_pct(p) => na(p) ? "—" : "+" + str.tostring(p, "#") + "%"

// ============================ شاشة المراقبة ================================
// محرك مصغّر يعمل داخل كل رمز بفريمه: يراقب، يعلّق أمراً، يدخل، يدير أهدافه،
// ثم يخرج. هذا هو الفرق بين شاشة تقرأ سعراً وشاشة تعرف صفقة.
f_watch(ck) =>
    a  = ta.atr(14)
    cf = ta.hma(close, 21)
    cs = ta.ema(close, 55)
    e9 = ta.ema(close, 9)
    cd = cf > cs ? 1 : -1
    inC = close <= math.max(cf, cs) and close >= math.min(cf, cs)
    [dp, dm, ax] = ta.dmi(14, 14)
    hv = not na(volume) and ta.sma(volume, 20) > 0
    vs = hv ? volume > 1.2 * ta.sma(volume, 20) : math.abs(close - open) > 0.7 * a
    bd = math.abs(close - open)
    dW = cd > 0 and close > cs ? 1 : cd < 0 and close < cs ? -1 : 0
    sc = 0
    sc := sc + (dW != 0 ? 25 : 0)
    sc := sc + (ax >= 18 ? 25 : 0)
    sc := sc + (vs ? 25 : 0)
    sc := sc + (not inC ? 25 : 0)
    var bool aU = false
    var bool aD = false
    if dW > 0 and low <= math.max(cf, e9) + 0.20 * a
        aU := true
        aD := false
    if dW < 0 and high >= math.min(cf, e9) - 0.20 * a
        aD := true
        aU := false
    if dW <= 0
        aU := false
    if dW >= 0
        aD := false
    cU = aU and close > open and close > high[1] and bd > 0.25 * a
    cD = aD and close < open and close < low[1] and bd > 0.25 * a
    if cU
        aU := false
    if cD
        aD := false
    var int   st = 0
    var int   sd = 0
    var float sEnt = na
    var float sStp = na
    var float sLim = na
    var float sBrk = na
    var int   sBar = 0
    var int   sHit = 0
    var float sR   = na
    var int   sOut = -999
    var int   sIn  = -999
    if st == 0 and (cU or cD) and barstate.isconfirmed and bar_index - sOut > 3
        st  := 1
        sd  := cU ? 1 : -1
        sBar := bar_index
        rg = math.max(high - low, syminfo.mintick)
        sLim := cU ? high - 0.5 * rg : low + 0.5 * rg
        sBrk := cU ? high + 0.10 * a : low - 0.10 * a
        bs = cU ? math.min(low, sLim) : math.max(high, sLim)
        sStp := cU ? bs - 0.7 * a : bs + 0.7 * a
    else if st == 1 and barstate.isconfirmed and bar_index > sBar
        hL = sd > 0 ? low <= sLim : high >= sLim
        hB = sd > 0 ? high >= sBrk : low <= sBrk
        if hL or hB
            st := 2
            sEnt := hB and not hL ? sBrk : (sd > 0 ? math.min(open, sLim) : math.max(open, sLim))
            sStp := sd > 0 ? math.min(sStp, sEnt - 0.5 * a) : math.max(sStp, sEnt + 0.5 * a)
            sHit := 0
            sIn  := bar_index
        else if bar_index - sBar >= 3
            st := 0
    else if st == 2 and barstate.isconfirmed
        rr = math.max(math.abs(sEnt - sStp), syminfo.mintick)
        pg = sd > 0 ? (high - sEnt) / rr : (sEnt - low) / rr
        sHit := math.max(sHit, pg >= 3.0 ? 4 : pg >= 2.0 ? 3 : pg >= 1.2 ? 2 : pg >= 0.7 ? 1 : 0)
        if sHit >= 1
            chd = sd > 0 ? close - 1.4 * a : close + 1.4 * a
            sStp := sd > 0 ? math.max(sStp, chd) : math.min(sStp, chd)
        if sd > 0 ? low <= sStp : high >= sStp
            ex = sd > 0 ? math.min(open, sStp) : math.max(open, sStp)
            sR := (sd > 0 ? ex - sEnt : sEnt - ex) / rr - ck
            st := 0
            sOut := bar_index
    fresh = st == 2 and bar_index - sIn <= 2
    justOut = st == 0 and bar_index - sOut <= 3
    [st, sd, sc, sEnt, sStp, sLim, sHit, sR, fresh, justOut, dW]

on1 = showWatch and wCount >= 1
on2 = showWatch and wCount >= 2
on3 = showWatch and wCount >= 3
on4 = showWatch and wCount >= 4
on5 = showWatch and wCount >= 5
// صف مطفأ يُطلب على رمز الشارت نفسه: لا بيانات إضافية تُجلب، وهذا هو
// الجزء البطيء فعلاً في التحميل
f_sym(on, s) => on ? s : syminfo.tickerid
f_tfq(on, t) => on ? t : timeframe.period
[a1s, a1d, a1q, a1e, a1p, a1l, a1h, a1r, a1f, a1o, a1t] = request.security(f_sym(on1, w1s), f_tfq(on1, w1t), f_watch(costR), lookahead=barmerge.lookahead_off)
[a2s, a2d, a2q, a2e, a2p, a2l, a2h, a2r, a2f, a2o, a2t] = request.security(f_sym(on2, w2s), f_tfq(on2, w2t), f_watch(costR), lookahead=barmerge.lookahead_off)
[a3s, a3d, a3q, a3e, a3p, a3l, a3h, a3r, a3f, a3o, a3t] = request.security(f_sym(on3, w3s), f_tfq(on3, w3t), f_watch(costR), lookahead=barmerge.lookahead_off)
[a4s, a4d, a4q, a4e, a4p, a4l, a4h, a4r, a4f, a4o, a4t] = request.security(f_sym(on4, w4s), f_tfq(on4, w4t), f_watch(costR), lookahead=barmerge.lookahead_off)
[a5s, a5d, a5q, a5e, a5p, a5l, a5h, a5r, a5f, a5o, a5t] = request.security(f_sym(on5, w5s), f_tfq(on5, w5t), f_watch(costR), lookahead=barmerge.lookahead_off)

watchFire = (on1 and a1f and not a1f[1]) or (on2 and a2f and not a2f[1]) or (on3 and a3f and not a3f[1]) or
     (on4 and a4f and not a4f[1]) or (on5 and a5f and not a5f[1])
alertcondition(watchFire, "دخول على شاشة المراقبة", "أحد رموز شاشة المراقبة دخل صفقة الآن")
if watchFire
    alert("🟢 دخول جديد على شاشة المراقبة — افتح اللوحة", alert.freq_once_per_bar)

// ============================ اللوحة =======================================
f_pos(s) => s == "أعلى يمين" ? position.top_right : s == "أعلى يسار" ? position.top_left :
     s == "أسفل يمين" ? position.bottom_right : position.bottom_left
f_tf(d) => d > 0 ? "▲" : d < 0 ? "▼" : "•"
f_tfc(d) => d > 0 ? cUp : d < 0 ? cDn : cMut
f_tfName(t) => t == "D" ? "يومي" : t == "W" ? "أسبوعي" : t == "60" ? "1س" : t == "120" ? "2س" :
     t == "240" ? "4س" : t + "د"
f_bar5(v) =>
    n = math.round(v / 20.0)
    s = ""
    for i = 1 to 5
        s := s + (i <= n ? "▮" : "▯")
    s
f_short(s) => str.contains(s, ":") ? array.get(str.split(s, ":"), 1) : s
f_marks(h) => (h >= 1 ? "✓" : "○") + (h >= 2 ? "✓" : "○") + (h >= 3 ? "✓" : "○") + (h >= 4 ? "✓" : "○")

var table dash = table.new(f_pos(dashPosS), 2, 11, bgcolor=cPanl, border_width=1, border_color=color.new(#2A3245, 0))
if barstate.islast
    q = math.max(qUp, qDn)
    qCol = q >= 80 ? cUp : q >= 60 ? cYel : cDn
    sCol = inTrade ? (tDir > 0 ? cUp : cDn) : pDir != 0 ? cYel : liveDir > 0 ? cUp : cDn
    blocked = qualityMode and (lead > 0 ? not qGateUp : not qGateDn)
    action = not dayOpen and not inTrade ? "🛑 توقف اليوم — " + str.tostring(lossRunDay) + " خسائر متتالية" :
         inTrade ? (hits >= 2 ? "💰 مؤمّنة — احجز جزءاً ودع الباقي" : hits >= 1 ? "🏃 تجري خلف الوقف" : "✊ امسك — خسارتك محدودة بـ 1R") :
         pDir != 0 ? ("⏳ " + (useBracket and not na(pBreak) ? "زخم — اختراق " + str.tostring(pBreak, format.mintick) + " · أو حد " + str.tostring(pLimit, format.mintick) : "ضع أمر " + f_side(pDir) + " حداً عند " + str.tostring(pLimit, format.mintick) + " ولا تطارد")) :
         earlyTxt != "" ? (earlyTxt + " — ينتظر الإغلاق " + (na(secsLeft) ? "" : str.tostring(math.round(secsLeft)) + "ث")) :
         (bar_index - lastExit) <= coolEff ? "😴 راحة بعد الصفقة السابقة" :
         leadScore < minQeff ? "⏸ ينقص: " + f_miss(lead > 0) :
         blocked ? "⏸ سوق بلا قوة اتجاه (ADX " + str.tostring(adx, "#") + ")" :
         (lead > 0 ? not trigUp : not trigDn) ? "👀 جاهز — بانتظار الشرارة" : "⚡ ادخل الآن"
    actCol = inTrade ? cUp : pDir != 0 ? cYel : earlyTxt != "" ? cCyan : cMut
    state = inTrade ? "صفقة " + f_side(tDir) + " قائمة" : pDir != 0 ? "أمر " + f_side(pDir) + " معلق" : "ميل السوق " + f_side(liveDir)
    table.cell(dash, 0, 0, "مرصاد VIP", text_color=cGold, bgcolor=cHead, text_size=size.normal)
    table.cell(dash, 1, 0, syminfo.ticker + " · " + f_tfName(timeframe.period) + " · " + prof, text_color=cTxt, bgcolor=cHead, text_size=size.normal)
    table.cell(dash, 0, 1, "الحالة", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 1, state, text_color=#0B0E13, bgcolor=sCol, text_size=size.normal)
    table.cell(dash, 0, 2, "ماذا أفعل؟", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 2, action, text_color=actCol, text_size=size.normal)
    table.cell(dash, 0, 3, "قوة الفرصة", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 3, f_bar5(q) + "  " + str.tostring(q) + "/100" + (strongImp ? "  ⚡زخم" : ""), text_color=qCol, text_size=size.small)
    table.cell(dash, 0, 4, "العقد", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 4, syminfo.ticker + " " + str.tostring(optStrk, format.mintick) + (liveDir > 0 ? "C" : "P") + " · " + expiryTxt,
         text_color=gapRisk ? cYel : sCol, text_size=size.small)
    table.cell(dash, 0, 5, "الأهداف", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 5, f_marks(hits) + "  " + f_pct(oP1) + " " + f_pct(oP2) + " " + f_pct(oP3) + " " + f_pct(oP4), text_color=cGold, text_size=size.small)
    table.cell(dash, 0, 6, "دخول ← وقف", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 6, inTrade ? str.tostring(entryP, format.mintick) + "  ←  " + str.tostring(stopP, format.mintick) : "—", text_color=inTrade ? #FF9E45 : cMut, text_size=size.small)
    table.cell(dash, 0, 7, "الفريمات", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 7, "1د" + f_tf(d01) + " 3د" + f_tf(d03) + " 5د" + f_tf(d05) + " 15د" + f_tf(d15) + " 1س" + f_tf(d60),
         text_color=bias > 0 ? cUp : bias < 0 ? cDn : cMut, text_size=size.small)
    mktTxt = rsi >= 70 ? "تشبع شرائي ⚠" : rsi <= 30 ? "تشبع بيعي ⚠" : absorption ? "امتصاص مؤسسي" :
         inCloud ? "داخل السحابة — غير واضح" : cloudDir > 0 ? "زخم صاعد" : "زخم هابط"
    zTxt = not na(zoneHi) ? " · منطقة تجميع" : inFib ? " · فيبو ذهبية" : nearSup ? " · على الدعم" : nearRes ? " · على المقاومة" : ""
    table.cell(dash, 0, 8, "السوق", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 8, mktTxt + zTxt, text_color=inCloud ? cYel : cloudDir > 0 ? cUp : cDn, text_size=size.small)
    // الخطة القادمة: الشرط يُكتب قبل حدوثه لا بعده
    upLv = not na(sw3H) ? sw3H : high
    dnLv = not na(sw3L) ? sw3L : low
    table.cell(dash, 0, 9, "لو صار كذا", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 9, showPlan ? "▲ فوق " + str.tostring(upLv, format.mintick) + " → كول " + str.tostring(upLv + tp1x * atr, format.mintick) +
         "   ▼ تحت " + str.tostring(dnLv, format.mintick) + " → بوت " + str.tostring(dnLv - tp1x * atr, format.mintick) : "—",
         text_color=cCyan, text_size=size.small)
    table.cell(dash, 0, 10, "اليوم", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 10, "دخل " + str.tostring(tradesToday) + " · ألغي " + str.tostring(missedToday) +
         (na(minsLeft) ? "" : " · تبقّى " + str.tostring(math.round(minsLeft)) + "د"), text_color=cTxt, text_size=size.small)

// ============================ شاشة المراقبة: الرسم =========================
var table wt = table.new(f_pos(wPosS), 5, 6, bgcolor=cPanl, border_width=1, border_color=color.new(#2A3245, 0))
blink = math.floor(timenow / 700) % 2 == 0
f_wTxt(st, d, sc, hit, r, fresh, jout, dW) =>
    st == 2 and fresh ? "🟢 دخول " + (d > 0 ? "كول" : "بوت") + " الآن" :
     st == 2 ? "🎯 " + (d > 0 ? "كول" : "بوت") + " " + f_marks(hit) :
     st == 1 ? "⏳ أمر معلق" :
     jout ? ((r > 0 ? "✅ +" : "🔴 ") + str.tostring(r, "#.#") + "R") :
     dW == 0 ? "خارج اللعب" :
     sc >= 75 ? (dW > 0 ? "👁 يتجهز كول" : "👁 يتجهز بوت") :
     (dW > 0 ? "▲ صاعد" : "▼ هابط")
f_wCol(st, d, sc, fresh, jout, r, dW) =>
    st == 2 and fresh ? #0B0E13 :
     st == 2 ? (d > 0 ? cUp : cDn) :
     st == 1 ? cYel :
     jout ? (r > 0 ? cUp : cDn) :
     dW == 0 ? cMut : sc >= 75 ? cGold : color.new(dW > 0 ? cUp : cDn, 35)
f_wBg(st, d, fresh) =>
    st == 2 and fresh ? (blink ? (d > 0 ? cUp : cDn) : color.new(d > 0 ? cUp : cDn, 55)) : color.new(cPanl, 100)

f_wRow(r, on, sym, tf, st, d, sc, ent, stp, lim, hit, rr, fresh, jout, dW) =>
    if on
        table.cell(wt, 0, r, f_short(sym), text_color=cTxt, text_size=size.small)
        table.cell(wt, 1, r, f_tfName(tf), text_color=cMut, text_size=size.small)
        table.cell(wt, 2, r, f_wTxt(st, d, sc, hit, rr, fresh, jout, dW),
             text_color=f_wCol(st, d, sc, fresh, jout, rr, dW), bgcolor=f_wBg(st, d, fresh), text_size=size.small)
        table.cell(wt, 3, r, st == 2 ? "وقف " + str.tostring(stp, format.mintick) : st == 1 ? str.tostring(lim, format.mintick) : f_bar5(sc),
             text_color=st == 2 ? #FF9E45 : st == 1 ? cYel : sc >= 75 ? cUp : cMut, text_size=size.small)
        table.cell(wt, 4, r, dW == 0 and st == 0 ? "—" : f_short(sym) + " " +
             str.tostring((st == 2 ? (d > 0 ? math.ceil(ent / f_step(ent)) * f_step(ent) : math.floor(ent / f_step(ent)) * f_step(ent)) : close), format.mintick) +
             ((st == 2 ? d : dW) > 0 ? "C" : "P"),
             text_color=(st == 2 ? d : dW) > 0 ? cUp : cDn, text_size=size.small)

if barstate.islast and showWatch
    table.cell(wt, 0, 0, "الاسم", text_color=cGold, bgcolor=cHead, text_size=size.small)
    table.cell(wt, 1, 0, "الفريم", text_color=cGold, bgcolor=cHead, text_size=size.small)
    table.cell(wt, 2, 0, "الحالة", text_color=cGold, bgcolor=cHead, text_size=size.small)
    table.cell(wt, 3, 0, "الوقف/القوة", text_color=cGold, bgcolor=cHead, text_size=size.small)
    table.cell(wt, 4, 0, "العقد", text_color=cGold, bgcolor=cHead, text_size=size.small)
    f_wRow(1, on1, w1s, w1t, a1s, a1d, a1q, a1e, a1p, a1l, a1h, a1r, a1f, a1o, a1t)
    f_wRow(2, on2, w2s, w2t, a2s, a2d, a2q, a2e, a2p, a2l, a2h, a2r, a2f, a2o, a2t)
    f_wRow(3, on3, w3s, w3t, a3s, a3d, a3q, a3e, a3p, a3l, a3h, a3r, a3f, a3o, a3t)
    f_wRow(4, on4, w4s, w4t, a4s, a4d, a4q, a4e, a4p, a4l, a4h, a4r, a4f, a4o, a4t)
    f_wRow(5, on5, w5s, w5t, a5s, a5d, a5q, a5e, a5p, a5l, a5h, a5r, a5f, a5o, a5t)

// ============================ الاختبار الحي ================================
var table bt = table.new(f_pos(btPosS), 2, 11, bgcolor=cPanl, border_width=1, border_color=color.new(#2A3245, 0))
f_wr(v) => v >= 60 ? cUp : v >= 45 ? cYel : cDn
if barstate.islast
    btWr  = btTot > 0 ? 100.0 * btWin / btTot : 0.0
    btCwr = btCallTot > 0 ? 100.0 * btCallWin / btCallTot : 0.0
    btPwr = btPutTot  > 0 ? 100.0 * btPutWin  / btPutTot  : 0.0
    btPf  = btLoss > 0 ? btGross / btLoss : (btGross > 0 ? 99.0 : 0.0)
    totAll = winsAll + lossAll
    avgG = totAll > 0 ? sumR / totAll : 0.0
    avgN = totAll > 0 ? sumRnet / totAll : 0.0
    fillRate = (totAll + missedCnt) > 0 ? 100.0 * totAll / (totAll + missedCnt) : 0.0
    table.cell(bt, 0, 0, "الاختبار الحي", text_color=cGold, bgcolor=cHead, text_size=size.small)
    table.cell(bt, 1, 0, "آخر " + str.tostring(btDays) + " يوم", text_color=cTxt, bgcolor=cHead, text_size=size.small)
    table.cell(bt, 0, 1, "عدد الصفقات", text_color=cMut, text_size=size.small)
    table.cell(bt, 1, 1, str.tostring(btTot) + (btTot < 30 ? "  عينة صغيرة ⚠" : ""), text_color=btTot < 30 ? cYel : cTxt, text_size=size.small)
    table.cell(bt, 0, 2, "نسبة النجاح", text_color=cMut, text_size=size.small)
    table.cell(bt, 1, 2, btTot > 0 ? str.tostring(btWr, "#.#") + "%" : "—", text_color=f_wr(btWr), text_size=size.small)
    table.cell(bt, 0, 3, "نجاح الكول", text_color=cMut, text_size=size.small)
    table.cell(bt, 1, 3, btCallTot > 0 ? str.tostring(btCwr, "#") + "% (" + str.tostring(btCallTot) + ")" : "—", text_color=f_wr(btCwr), text_size=size.small)
    table.cell(bt, 0, 4, "نجاح البوت", text_color=cMut, text_size=size.small)
    table.cell(bt, 1, 4, btPutTot > 0 ? str.tostring(btPwr, "#") + "% (" + str.tostring(btPutTot) + ")" : "—", text_color=f_wr(btPwr), text_size=size.small)
    table.cell(bt, 0, 5, "عامل الربح", text_color=cMut, text_size=size.small)
    table.cell(bt, 1, 5, btTot == 0 ? "—" : btTot < 30 ? str.tostring(btPf, "#.##") + " (لا يُعتمد)" : str.tostring(btPf, "#.##"),
         text_color=btTot < 30 ? cMut : btPf >= 1.5 ? cUp : btPf >= 1.0 ? cYel : cDn, text_size=size.small)
    table.cell(bt, 0, 6, "متوسط خام", text_color=cMut, text_size=size.small)
    table.cell(bt, 1, 6, totAll > 0 ? (avgG >= 0 ? "+" : "") + str.tostring(avgG, "#.##") + "R" : "—", text_color=cMut, text_size=size.small)
    table.cell(bt, 0, 7, "متوسط بعد التكلفة", text_color=cTxt, text_size=size.small)
    table.cell(bt, 1, 7, totAll > 0 ? (avgN >= 0 ? "+" : "") + str.tostring(avgN, "#.##") + "R" : "—",
         text_color=avgN > 0 ? cUp : cDn, bgcolor=color.new(avgN > 0 ? cUp : cDn, 85), text_size=size.normal)
    table.cell(bt, 0, 8, "المحصلة الكلية", text_color=cMut, text_size=size.small)
    table.cell(bt, 1, 8, totAll > 0 ? (sumRnet >= 0 ? "+" : "") + str.tostring(sumRnet, "#.#") + "R (" + str.tostring(totAll) + ")" : "—",
         text_color=sumRnet > 0 ? cUp : cDn, text_size=size.small)
    table.cell(bt, 0, 9, "أطول سلسلة خسائر", text_color=cMut, text_size=size.small)
    table.cell(bt, 1, 9, totAll > 0 ? str.tostring(maxLossRun) + " متتالية" : "—",
         text_color=maxLossRun >= 8 ? cDn : maxLossRun >= 5 ? cYel : cTxt, text_size=size.small)
    table.cell(bt, 0, 10, "نُفّذ / ألغي", text_color=cMut, text_size=size.small)
    table.cell(bt, 1, 10, str.tostring(totAll) + " / " + str.tostring(missedCnt) + " · " + str.tostring(fillRate, "#") + "%",
         text_color=fillRate >= 40 ? cUp : fillRate >= 20 ? cYel : cDn, text_size=size.small)
