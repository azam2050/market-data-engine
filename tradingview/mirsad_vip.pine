//@version=5
// ============================================================================
//  مرصاد VIP | لوحة العقود المؤسسية — Institutional Option Signal Dashboard
// ----------------------------------------------------------------------------
//  المحرك (كل شرط يُحسم على إغلاق الشمعة فقط — لا إعادة رسم نهائياً):
//
//  الدخول المبكر: لا ننتظر الفريمات العالية تكمل انقلابها — ندخل عندما
//  يصنع الفريم الصغير كسر بنية BOS أو تغيير طابع CHoCH بينما السعر جالس
//  على منطقة قرار كبرى: دعم/مقاومة بنيوية، أو منطقة فيبوناتشي 0.618–0.786
//  لآخر موجة كبرى، أو حافة الأمس.
//
//  وايكوف: سبرينق التجميع (كسر كاذب للدعم بامتصاص حجم = كول) وأبثراست
//  التوزيع (اختراق كاذب للمقاومة بامتصاص = بوت) + منطق الجهد مقابل
//  النتيجة (حجم ضخم بجسم صغير = امتصاص مؤسسي).
//
//  السيولة والبرايس أكشن: مسح السيولة (ذيل يتجاوز قمة/قاع متأرجح حديث
//  ويغلق داخلاً)، دبابيس الرفض، والابتلاع.
//
//  سكور الجودة 0–100: حجم 20 + نمط شموع 20 + التقاء فيبو/مستوى 20 +
//  BOS/CHoCH 20 + زخم RSI وانفراجاته 20. لا دخول تحت العتبة.
//
//  الإدارة: وقف بنيوي (خلف آخر قاع/قمة متأرجحة ± ATR)، وأربعة أهداف
//  TP1–TP4 بنسب عقد تقديرية، تأمين عند TP1، تصعيد عند TP2، تتبع بعدها.
// ============================================================================
indicator("مرصاد VIP | لوحة العقود", shorttitle="مرصاد VIP", overlay=true,
     max_lines_count=100, max_labels_count=150, max_boxes_count=30)

// ---------------------------------------------------------------- المدخلات
grpQ = "عقل الجودة"
aggro   = input.string("متوازن", "شخصية المؤشر", options=["هادئ", "متوازن", "نشط"], group=grpQ)
minQ    = input.int(40, "أدنى سكور جودة للدخول (0-100)", minval=0, maxval=100, group=grpQ)
volX    = input.float(1.2, "مضاعف الحجم المؤسسي", minval=1.0, maxval=3.0, step=0.1, group=grpQ)
qualityMode  = input.bool(true,  "وضع الجودة — منع الدخول في التذبذب وداخل السحابة", group=grpQ)
reversalMode = input.bool(false, "وضع الانعكاس — دخول عكسي عند التشبع الحاد", group=grpQ)
adxMin  = input.int(18, "أدنى قوة اتجاه ADX (لوضع الجودة)", minval=10, maxval=40, group=grpQ)
revLo   = input.int(25, "تشبع بيعي للانعكاس (RSI)",  minval=10, maxval=35, group=grpQ)
revHi   = input.int(75, "تشبع شرائي للانعكاس (RSI)", minval=65, maxval=90, group=grpQ)
grpC = "السحابة التكيفية"
cloudFastLen = input.int(21, "السحابة السريعة (HMA)", minval=5,  maxval=100, group=grpC)
cloudSlowLen = input.int(55, "السحابة البطيئة (EMA)", minval=20, maxval=200, group=grpC)
showCloud    = input.bool(true, "إظهار السحابة", group=grpC)
grpB = "الاختبار الحي"
btDays  = input.int(30, "احسب الأداء على آخر (يوم)", minval=1, maxval=365, group=grpB)
// كل حساب هنا على سعر السهم. لكنك تشتري عقداً، وللعقد فرق بين البيع
// والشراء يُدفع مرتين — عند الدخول وعند الخروج. من لا يطرحه من نتيجته
// يقرأ أرباحاً لم تدخل جيبه. هذا الرقم يُطرح من كل صفقة قبل عدّها.
costR   = input.float(0.15, "تكلفة العقد ذهاباً وإياباً (R)", minval=0.0, maxval=0.6, step=0.05, group=grpB)
btPosS  = input.string("أسفل يمين", "مكان جدول الاختبار", options=["أعلى يمين", "أعلى يسار", "أسفل يمين", "أسفل يسار"], group=grpB)
grpE = "طريقة الدخول"
entryMode = input.string("حد — انتظر ارتداد", "أسلوب التنفيذ", options=["حد — انتظر ارتداد", "سوق — افتتاح الشمعة التالية"], group=grpE)
retrX     = input.float(0.5, "عمق الارتداد المطلوب (من مدى شمعة الشرارة)", minval=0.1, maxval=0.9, step=0.05, group=grpE)
pExpire   = input.int(3, "صلاحية الأمر المعلق (شموع)", minval=1, maxval=12, group=grpE)
maxChase  = input.float(0.5, "أقصى مطاردة مسموحة (ATR)", minval=0.1, maxval=2.0, step=0.1, group=grpE)
// الوقف البنيوي قد يقع أحياناً على بُعد شعرة من سعر التنفيذ. حين تقترب
// المسافة من الصفر تصير قسمة النتيجة عليها بلا معنى: صفقة تافهة تُسجَّل
// بمئة R وتفسد كل متوسط بعدها. لا صفقة بمخاطرة أقل من هذا الحد.
minRiskX  = input.float(0.5, "أدنى مسافة وقف (ATR)", minval=0.2, maxval=2.0, step=0.1, group=grpE)
grpM = "إدارة الصفقة"
tp1x = input.float(0.8, "TP1 (ATR)", minval=0.3, maxval=2.0, step=0.1, group=grpM)
tp2x = input.float(1.5, "TP2 (ATR)", minval=0.8, maxval=3.0, step=0.1, group=grpM)
tp3x = input.float(2.5, "TP3 (ATR)", minval=1.5, maxval=5.0, step=0.1, group=grpM)
tp4x = input.float(3.5, "TP4 (ATR)", minval=2.0, maxval=8.0, step=0.1, group=grpM)
trailX = input.float(1.8, "الوقف المتحرك بعد TP2 (ATR)", minval=1.0, maxval=4.0, step=0.1, group=grpM)
coolN  = input.int(6, "شموع انتظار بعد كل صفقة", minval=0, maxval=100, group=grpM)
grpO = "لوحة العقد"
optLev  = input.float(10.0, "الرافعة التقديرية (٪ العقد لكل ١٪ سهم)", minval=3, maxval=30, step=1, group=grpO)
grpW = "شاشة المراقبة — أسماء أخرى بفريم كل واحد"
showWatch = input.bool(true, "إظهار شاشة المراقبة", group=grpW)
wPosS = input.string("أسفل يسار", "مكان الشاشة", options=["أعلى يمين", "أعلى يسار", "أسفل يمين", "أسفل يسار"], group=grpW)
w1s = input.symbol("NASDAQ:AAPL", "١ الرمز", group=grpW)
w1t = input.timeframe("60", "١ الفريم", group=grpW)
w2s = input.symbol("NASDAQ:NVDA", "٢ الرمز", group=grpW)
w2t = input.timeframe("30", "٢ الفريم", group=grpW)
w3s = input.symbol("NASDAQ:QQQ", "٣ الرمز", group=grpW)
w3t = input.timeframe("5", "٣ الفريم", group=grpW)
w4s = input.symbol("NASDAQ:TSLA", "٤ الرمز", group=grpW)
w4t = input.timeframe("15", "٤ الفريم", group=grpW)
w5s = input.symbol("AMEX:SPY", "٥ الرمز", group=grpW)
w5t = input.timeframe("5", "٥ الفريم", group=grpW)
grpD = "العرض"
keepTrail = input.bool(true, "إبقاء آثار الصفقات الماضية (للمراجعة)", group=grpD)
dashPosS  = input.string("أعلى يمين", "مكان اللوحة", options=["أعلى يمين", "أعلى يسار", "أسفل يمين", "أسفل يسار"], group=grpD)

// ------------------------------------------------------------------ الألوان
cUp   = #26A69A
cDn   = #EF5350
cGold = #E3B34D
cCyan = #38C8E8
cTxt  = #D5D9E4
cMut  = #787B86
cYel  = #E8C547
cPanl = color.new(#151A24, 4)
cHead = color.new(#232B3D, 0)

// ----------------------------------------------------------- حسابات أساسية
atr    = ta.atr(14)
rngHL  = math.max(high - low, syminfo.mintick)
hasVol = not na(volume) and ta.sma(volume, 20) > 0
volMA  = hasVol ? ta.sma(volume, 20) : na
volSpike = hasVol ? volume > volX * volMA : math.abs(close - open) > 0.7 * atr
// الجهد مقابل النتيجة: حجم ضخم بجسم صغير = امتصاص مؤسسي صامت
absorption = hasVol and volume > 1.5 * volMA and math.abs(close - open) < 0.5 * atr
rsi = ta.rsi(close, 14)
[diPlus, diMinus, adx] = ta.dmi(14, 14)

// ------------------------------------------------- السحابة التكيفية
// شريط بين متوسط هال السريع ومتوسط أسي بطيء: السعر خارجه = مشهد واضح،
// وداخله = منطقة ضبابية تُصنع فيها أغلب الإشارات الكاذبة
cloudFast = ta.hma(close, cloudFastLen)
cloudSlow = ta.ema(close, cloudSlowLen)
inCloud   = close <= math.max(cloudFast, cloudSlow) and close >= math.min(cloudFast, cloudSlow)
cloudDir  = cloudFast > cloudSlow ? 1 : -1
pCloudF = plot(showCloud ? cloudFast : na, "السحابة السريعة", color=color.new(cloudDir > 0 ? #26A69A : #EF5350, 55), linewidth=1)
pCloudS = plot(showCloud ? cloudSlow : na, "السحابة البطيئة", color=color.new(#787B86, 65), linewidth=1)
fill(pCloudF, pCloudS, color=color.new(cloudDir > 0 ? #26A69A : #EF5350, 90))

// ------------------------------------ البنية: بايفوتات صغرى (3,3) وكبرى (10,10)
pv3H = ta.pivothigh(high, 3, 3)
pv3L = ta.pivotlow(low, 3, 3)
var float sw3H = na
var float sw3L = na
if not na(pv3H)
    sw3H := pv3H
if not na(pv3L)
    sw3L := pv3L
pv10H = ta.pivothigh(high, 10, 10)
pv10L = ta.pivotlow(low, 10, 10)
var float majH = na
var float majL = na
var int   majHB = na
var int   majLB = na
if not na(pv10H)
    majH := pv10H
    majHB := bar_index - 10
if not na(pv10L)
    majL := pv10L
    majLB := bar_index - 10

// اتجاه البنية الحالي — يميّز BOS (مع البنية) عن CHoCH (انقلاب الطابع)
var int structDir = 0
bosUp = not na(sw3H) and close > sw3H and close[1] <= sw3H
bosDn = not na(sw3L) and close < sw3L and close[1] >= sw3L
chochUp = bosUp and structDir == -1
chochDn = bosDn and structDir == 1
if bosUp
    structDir := 1
if bosDn
    structDir := -1

// ---------------------------- مناطق القرار الكبرى: فيبو 0.618–0.786 + الحواف
[pdH, pdL] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_off)
impUp = not na(majH) and not na(majL) and majHB > majLB and majH > majL
impDn = not na(majH) and not na(majL) and majLB > majHB and majH > majL
fzTop = impUp ? majH - (majH - majL) * 0.618 : impDn ? majL + (majH - majL) * 0.786 : na
fzBot = impUp ? majH - (majH - majL) * 0.786 : impDn ? majL + (majH - majL) * 0.618 : na
inFib = not na(fzTop) and close <= math.max(fzTop, fzBot) and close >= math.min(fzTop, fzBot)
nearSup = (not na(majL) and math.abs(close - majL) < 1.0 * atr) or (not na(pdL) and math.abs(close - pdL) < 1.0 * atr)
nearRes = (not na(majH) and math.abs(close - majH) < 1.0 * atr) or (not na(pdH) and math.abs(close - pdH) < 1.0 * atr)
atZoneUp = (inFib and impUp) or nearSup
atZoneDn = (inFib and impDn) or nearRes

// -------------------------------- وايكوف: السبرينق والأبثراست + مسح السيولة
tol = 0.05 * atr
supLvl = not na(majL) and not na(pdL) ? math.max(majL, pdL) : not na(majL) ? majL : pdL
resLvl = not na(majH) and not na(pdH) ? math.min(majH, pdH) : not na(majH) ? majH : pdH
spring   = not na(supLvl) and low < supLvl - tol and close > supLvl and close > open and (volSpike or absorption)
upthrust = not na(resLvl) and high > resLvl + tol and close < resLvl and close < open and (volSpike or absorption)
sweepUp  = not na(sw3L) and low < sw3L - tol and close > sw3L and close > open
sweepDn  = not na(sw3H) and high > sw3H + tol and close < sw3H and close < open

// ------------------------------------------- البرايس أكشن: الأنماط الشمعية
body   = math.abs(close - open)
upWick = high - math.max(close, open)
dnWick = math.min(close, open) - low
bullPin = dnWick > 2.0 * body and upWick < body and close >= open
bearPin = upWick > 2.0 * body and dnWick < body and close <= open
bullEng = close > open and close[1] < open[1] and close >= open[1] and open <= close[1] and body > 0.4 * atr
bearEng = close < open and close[1] > open[1] and close <= open[1] and open >= close[1] and body > 0.4 * atr
paUp = bullPin or bullEng
paDn = bearPin or bearEng

// ------------------------------------------------- الزخم: RSI وانفراجاته
// زخم مع الاتجاه (للاستمرار) أو انفراج/تشبع (للانعكاس) — كلاهما زخم صالح
divBull = not na(pv3L) and rsi < 45 and rsi > rsi[3]
divBear = not na(pv3H) and rsi > 55 and rsi < rsi[3]
momUp = (rsi > 50 and rsi > rsi[1]) or divBull or rsi < 32
momDn = (rsi < 50 and rsi < rsi[1]) or divBear or rsi > 68

// ------------------------------------- مصفوفة الفريمات الخمسة
f_dir() =>
    eF = ta.ema(close, 9)
    eS = ta.ema(close, 21)
    eF > eS and close > eS ? 1 : eF < eS and close < eS ? -1 : 0
d01 = request.security(syminfo.tickerid, "1",  f_dir(), lookahead=barmerge.lookahead_off)
d03 = request.security(syminfo.tickerid, "3",  f_dir(), lookahead=barmerge.lookahead_off)
d05 = request.security(syminfo.tickerid, "5",  f_dir(), lookahead=barmerge.lookahead_off)
d15 = request.security(syminfo.tickerid, "15", f_dir(), lookahead=barmerge.lookahead_off)
d60 = request.security(syminfo.tickerid, "60", f_dir(), lookahead=barmerge.lookahead_off)

// ------------------------------------------------- ميل السوق القائد (bias)
// إجماع 5د/15د/60د + ميل السحابة. اثنان فأكثر في جهة = هذه جهة اليوم.
biasSum = (d05 > 0 ? 1 : d05 < 0 ? -1 : 0) + (d15 > 0 ? 1 : d15 < 0 ? -1 : 0) +
     (d60 > 0 ? 1 : d60 < 0 ? -1 : 0) + cloudDir
bias = biasSum >= 2 ? 1 : biasSum <= -2 ? -1 : 0

// ----------------------------------------- محرك الاستمرار: ارتداد ثم استئناف
// هذا هو مصدر الدخول اليومي: في اتجاه واضح، السعر يرجع للسحابة/EMA9
// (تصحيح)، ثم أول شمعة تستأنف الاتجاه هي الدخول. يتكرر عدة مرات كل يوم.
ema9 = ta.ema(close, 9)
pbUp = math.max(cloudFast, ema9)
pbDn = math.min(cloudFast, ema9)
var bool armUp = false
var bool armDn = false
if bias > 0 and low <= pbUp + 0.20 * atr
    armUp := true
    armDn := false
if bias < 0 and high >= pbDn - 0.20 * atr
    armDn := true
    armUp := false
if bias <= 0
    armUp := false
if bias >= 0
    armDn := false
contUp = armUp and close > open and close > high[1] and close > cloudFast and body > 0.25 * atr
contDn = armDn and close < open and close < low[1] and close < cloudFast and body > 0.25 * atr
if contUp
    armUp := false
if contDn
    armDn := false

// --------------------------------------------- سكور الجودة 0–100 (خمسة أخماس)
// خمسة أسئلة: هل الفريمات معي؟ هل هناك حجم؟ هل هناك نموذج/شرارة؟
// هل أنا عند منطقة أو مع السحابة؟ هل الزخم معي؟
f_q(sideUp) =>
    q = 0
    q := q + ((sideUp ? bias > 0 : bias < 0) ? 20 : 0)
    q := q + ((volSpike or absorption) ? 20 : 0)
    q := q + ((sideUp ? (paUp or contUp or spring or sweepUp) : (paDn or contDn or upthrust or sweepDn)) ? 20 : 0)
    q := q + ((sideUp ? (atZoneUp or cloudDir > 0) : (atZoneDn or cloudDir < 0)) ? 20 : 0)
    q := q + ((sideUp ? momUp : momDn) ? 20 : 0)
    q
qUp = f_q(true)
qDn = f_q(false)
lead      = qUp >= qDn ? 1 : -1
leadScore = math.max(qUp, qDn)

// ------------------------------- تشخيص السكون: ما الذي ينقص للدخول الآن؟
// أهم سطر في اللوحة — يمنع أن يكون صمت المؤشر لغزاً
f_miss(sideUp) =>
    m = ""
    m := m + ((sideUp ? bias > 0 : bias < 0) ? "" : "فريمات · ")
    m := m + ((volSpike or absorption) ? "" : "حجم · ")
    m := m + ((sideUp ? (paUp or contUp or spring or sweepUp) : (paDn or contDn or upthrust or sweepDn)) ? "" : "نموذج · ")
    m := m + ((sideUp ? (atZoneUp or cloudDir > 0) : (atZoneDn or cloudDir < 0)) ? "" : "منطقة · ")
    m := m + ((sideUp ? momUp : momDn) ? "" : "زخم")
    m

// ------------------------------------------------------------- حالة الصفقة
var bool  inTrade = false
var int   tDir    = 0
var float entryP  = na
var float stopP   = na
var float stop0   = na
var float tp1 = na
var float tp2 = na
var float tp3 = na
var float tp4 = na
var bool  h1 = false
var bool  h2 = false
var bool  h3 = false
var bool  h4 = false
var int   entryBar = 0
var int   lastExit = -99999
var line  lnEntry = na
var line  lnStop  = na
var resArr = array.new_int()
var int   winsAll = 0
var int   lossAll = 0
var float sumR    = 0.0
// عدادات الاختبار الحي — تُحتسب فقط للصفقات المغلقة داخل نافذة الأيام
var int   btTot = 0
var int   btWin = 0
var int   btCallTot = 0
var int   btCallWin = 0
var int   btPutTot  = 0
var int   btPutWin  = 0
var float btGross = 0.0
var float btLoss  = 0.0
// الصدق يكتمل بثلاثة أرقام كان ينقصها: المحصلة الكلية بعد التكلفة،
// وأطول سلسلة خسائر متتالية (هي التي تكسر المتداول لا المتوسط)،
// والمتوسط الخام لمقارنته بالصافي فيظهر حجم ما يأكله فرق السعر
var float sumRnet = 0.0
var int   lossRun = 0
var int   maxLossRun = 0
var int tradesToday = 0
var int missedToday = 0
if ta.change(time("D")) != 0
    tradesToday := 0
    missedToday := 0
f_side(d) => d > 0 ? "كول" : "بوت"

// -------------------------------------------------- الأمر المعلق (لا مطاردة)
// الإشارة تُحسم على إغلاق الشمعة، فلا يمكن أن يكون التنفيذ على ذلك الإغلاق
// نفسه — هذا كذب على النفس. التنفيذ الواقعي إما بسعر افتتاح الشمعة التالية
// (سوق)، أو — وهو الأفضل — أمر حد ينتظر ارتداد السعر داخل شمعة الشرارة.
// إن طار السعر ولم يرتد خلال مدة الصلاحية: تُلغى الفرصة ولا نطاردها.
var int    pDir   = 0
var float  pLimit = na
var float  pPlanStop = na
var float  pRef   = na
var int    pBar   = 0
var string pWhy   = ""
var line   lnPend = na
var int    missedCnt = 0
useLimit = entryMode == "حد — انتظر ارتداد"

// ------------------------------------------------------------------- الدخول
// الشرارة: سبرينق / أبثراست / مسح سيولة / CHoCH مبكر عند منطقة قرار
trigUp = contUp or spring or sweepUp or chochUp or (bosUp and (volSpike or bias > 0))
trigDn = contDn or upthrust or sweepDn or chochDn or (bosDn and (volSpike or bias < 0))
// شخصية المؤشر: هادئ = أقل صفقات وأنقى · نشط = دخول يومي أكثر
minQeff = math.max(0, math.min(100, minQ + (aggro == "هادئ" ? 20 : aggro == "نشط" ? -20 : 0)))
coolEff = aggro == "هادئ" ? coolN * 2 : aggro == "نشط" ? math.max(1, coolN / 2) : coolN
canEnter = barstate.isconfirmed and not inTrade and pDir == 0 and (bar_index - lastExit) > coolEff and bar_index > 60
// وضع الجودة: يمنع الدخول العشوائي في سوق ميت — ولا يمنع الاستمرار مع
// اتجاه واضح ولا الارتداد من منطقة قرار كبرى
qGateUp = not qualityMode or contUp or atZoneUp or (adx >= adxMin and cloudDir >= 0)
qGateDn = not qualityMode or contDn or atZoneDn or (adx >= adxMin and cloudDir <= 0)
// وضع الانعكاس: دخول عكسي عند التشبع الحاد مع دليل امتصاص أو مسح سيولة
revUp = reversalMode and rsi <= revLo and (spring or sweepUp or bullPin) and qUp >= minQeff - 20
revDn = reversalMode and rsi >= revHi and (upthrust or sweepDn or bearPin) and qDn >= minQeff - 20
longSig  = canEnter and ((trigUp and qUp >= minQeff and qGateUp) or revUp)
shortSig = canEnter and not longSig and ((trigDn and qDn >= minQeff and qGateDn) or revDn)
sigDir = longSig ? 1 : shortSig ? -1 : 0
sigWhy = longSig ? (revUp and not trigUp ? "انعكاس من تشبع بيعي حاد" : contUp ? "استئناف بعد تصحيح مع الاتجاه" : spring ? "سبرينق وايكوف على الدعم" : chochUp ? "انقلاب طابع CHoCH" : sweepUp ? "مسح سيولة تحت قاع متأرجح" : "كسر بنية BOS") :
     shortSig ? (revDn and not trigDn ? "انعكاس من تشبع شرائي حاد" : contDn ? "استئناف بعد تصحيح مع الاتجاه" : upthrust ? "أبثراست وايكوف على المقاومة" : chochDn ? "انقلاب طابع CHoCH" : sweepDn ? "مسح سيولة فوق قمة متأرجحة" : "كسر بنية BOS") : ""

// ١) الشرارة تُسلّح أمراً معلقاً — ولا تدخل شيئاً
if sigDir != 0
    pDir   := sigDir
    pBar   := bar_index
    pRef   := close
    pWhy   := sigWhy
    pPlanStop := sigDir > 0 ? (not na(sw3L) and close - sw3L < 3 * atr ? sw3L - 0.25 * atr : low - 0.5 * atr)
         : (not na(sw3H) and sw3H - close < 3 * atr ? sw3H + 0.25 * atr : high + 0.5 * atr)
    pLimit := useLimit ? (sigDir > 0 ? high - retrX * rngHL : low + retrX * rngHL) : na
    // ادفع الوقف بعيداً بما يكفي عن سعر التنفيذ المنتظر
    pRefEntry = useLimit ? pLimit : close
    pPlanStop := sigDir > 0 ? math.min(pPlanStop, pRefEntry - minRiskX * atr)
         : math.max(pPlanStop, pRefEntry + minRiskX * atr)
    if useLimit
        lnPend := line.new(bar_index, pLimit, bar_index + pExpire, pLimit, color=cYel, style=line.style_dashed, width=1)
        label.new(bar_index, sigDir > 0 ? low : high, "⏳ " + f_side(sigDir) + " معلق " + str.tostring(pLimit, format.mintick),
             style=sigDir > 0 ? label.style_label_up : label.style_label_down,
             color=color.new(cYel, 25), textcolor=#20180A, size=size.small)
        alert("⏳ أمر معلق " + f_side(sigDir) + " | " + syminfo.ticker + " فريم " + timeframe.period +
             " | حد " + str.tostring(pLimit, format.mintick) + " | وقف " + str.tostring(pPlanStop, format.mintick) +
             " | صالح " + str.tostring(pExpire) + " شموع | السبب: " + pWhy, alert.freq_once_per_bar)

// ٢) التنفيذ يقع على شمعة لاحقة بسعر يمكن الحصول عليه فعلاً
fillNow = false
float fillP = na
int   fDir  = 0
if pDir != 0 and not inTrade and barstate.isconfirmed and bar_index > pBar
    if useLimit
        if pDir > 0 ? low <= pLimit : high >= pLimit
            fillNow := true
            fillP := pDir > 0 ? math.min(open, pLimit) : math.max(open, pLimit)
    else if bar_index == pBar + 1
        // سوق: ندخل على الافتتاح ما لم يكن السعر قد طار بعيداً عن الشرارة
        if math.abs(open - pRef) <= maxChase * atr and (pDir > 0 ? open > pPlanStop : open < pPlanStop)
            fillNow := true
            fillP := open
    if fillNow
        fDir := pDir
    else if bar_index - pBar >= pExpire or (pDir > 0 ? close < pPlanStop : close > pPlanStop)
        missedCnt += 1
        missedToday += 1
        pDir := 0
        line.delete(lnPend)

if fillNow
    inTrade := true
    tradesToday += 1
    entryBar := bar_index
    tDir   := fDir
    entryP := fillP
    // التنفيذ قد يقع أفضل من الحد المنتظر، فتضيق المسافة من جديد: تُثبَّت هنا
    stopP  := fDir > 0 ? math.min(pPlanStop, entryP - minRiskX * atr)
         : math.max(pPlanStop, entryP + minRiskX * atr)
    stop0  := stopP
    tp1 := fDir > 0 ? entryP + tp1x * atr : entryP - tp1x * atr
    tp2 := fDir > 0 ? entryP + tp2x * atr : entryP - tp2x * atr
    tp3 := fDir > 0 ? entryP + tp3x * atr : entryP - tp3x * atr
    tp4 := fDir > 0 ? entryP + tp4x * atr : entryP - tp4x * atr
    h1 := false
    h2 := false
    h3 := false
    h4 := false
    pDir := 0
    line.delete(lnPend)
    lnEntry := line.new(bar_index, entryP, bar_index + 1, entryP, extend=extend.right, color=color.new(cTxt, 35), style=line.style_dotted, width=1)
    lnStop  := line.new(bar_index, stopP, bar_index + 1, stopP, extend=extend.right, color=#FF9E45, width=2)
    label.new(bar_index, fDir > 0 ? low : high, "🎯 " + f_side(fDir) + " " + str.tostring(entryP, format.mintick),
         style=fDir > 0 ? label.style_label_up : label.style_label_down,
         color=fDir > 0 ? cUp : cDn, textcolor=fDir > 0 ? #04211D : #2B0606, size=size.normal)
    alert("🎯 دخول " + f_side(fDir) + " | " + syminfo.ticker + " فريم " + timeframe.period +
         " | سعر " + str.tostring(entryP, format.mintick) + " | وقف " + str.tostring(stopP, format.mintick) +
         " | السبب: " + pWhy, alert.freq_once_per_bar)

// ------------------------------------------------------------ إدارة الصفقة
tpHit1 = false
tpHit2 = false
tpHit3 = false
tpHit4 = false
slHit  = false
// الأهداف تُحتسب من الشمعة التالية للتنفيذ فقط، أما الوقف فيُحتسب حتى في
// شمعة التنفيذ نفسها — التشدد على النفس في الخسارة والتحفظ في الربح
if inTrade and barstate.isconfirmed and bar_index >= entryBar
    if bar_index > entryBar
        if not h1 and (tDir > 0 ? high >= tp1 : low <= tp1)
            h1 := true
            tpHit1 := true
            alert("🔺 هدف 1 تحقق — الصفقة تجري خلف الوقف المتحرك | " + syminfo.ticker, alert.freq_once_per_bar)
        if h1 and not h2 and (tDir > 0 ? high >= tp2 : low <= tp2)
            h2 := true
            tpHit2 := true
            alert("🔺 هدف 2 تحقق — الوقف صعد إلى الدخول (مؤمّنة) | " + syminfo.ticker, alert.freq_once_per_bar)
        if h2 and not h3 and (tDir > 0 ? high >= tp3 : low <= tp3)
            h3 := true
            tpHit3 := true
            alert("🔺 هدف 3 تحقق | " + syminfo.ticker, alert.freq_once_per_bar)
        if h3 and not h4 and (tDir > 0 ? high >= tp4 : low <= tp4)
            h4 := true
            tpHit4 := true
            alert("🔺 الهدف الممتد تحقق | " + syminfo.ticker, alert.freq_once_per_bar)
        if h1
            chand = tDir > 0 ? close - trailX * atr : close + trailX * atr
            stopP := tDir > 0 ? math.max(stopP, chand) : math.min(stopP, chand)
        if h2
            stopP := tDir > 0 ? math.max(stopP, entryP) : math.min(stopP, entryP)
    line.set_y1(lnStop, stopP)
    line.set_y2(lnStop, stopP)
    hardStop = not h1 and (tDir > 0 ? low <= stop0 : high >= stop0)
    softStop = h1 and (tDir > 0 ? close < stopP : close > stopP)
    if hardStop or softStop
        slHit := true
        risk  = math.abs(entryP - stop0)
        exitP = hardStop ? stop0 : close
        rGross = risk > 0 ? (tDir > 0 ? exitP - entryP : entryP - exitP) / risk : 0.0
        // كل ما يُعدّ بعد هذا السطر صافٍ: تكلفة العقد مطروحة. صفقة تخرج
        // عند سعر دخولها ليست تعادلاً — هي خسارة بمقدار فرق السعر.
        rMult = rGross - costR
        win   = rMult > 0
        array.unshift(resArr, win ? 1 : 0)
        if array.size(resArr) > 20
            array.pop(resArr)
        winsAll += win ? 1 : 0
        lossAll += win ? 0 : 1
        sumR    += rGross
        sumRnet += rMult
        lossRun := win ? 0 : lossRun + 1
        maxLossRun := math.max(maxLossRun, lossRun)
        if time >= timenow - btDays * 86400000.0
            btTot += 1
            btWin += win ? 1 : 0
            btCallTot += tDir > 0 ? 1 : 0
            btCallWin += tDir > 0 and win ? 1 : 0
            btPutTot  += tDir < 0 ? 1 : 0
            btPutWin  += tDir < 0 and win ? 1 : 0
            btGross += rMult > 0 ? rMult : 0.0
            btLoss  += rMult < 0 ? -rMult : 0.0
        if keepTrail
            line.set_extend(lnEntry, extend.none)
            line.set_x2(lnEntry, bar_index)
            line.new(entryBar, entryP, bar_index, exitP, color=win ? color.new(cUp, 35) : color.new(cDn, 30), width=2)
        else
            line.delete(lnEntry)
        line.delete(lnStop)
        label.new(bar_index, tDir > 0 ? low : high,
             win ? "✅ +" + str.tostring(rMult, "#.#") + "R" : "🔴 " + str.tostring(rMult, "#.#") + "R",
             style=tDir > 0 ? label.style_label_up : label.style_label_down,
             color=win ? color.new(cUp, 20) : color.new(cDn, 10),
             textcolor=win ? #04211D : #2B0606, size=size.normal)
        alert((win ? "✅" : "🔴") + " خروج — كسر الوقف المتحرك | " + syminfo.ticker +
             " | النتيجة " + (win ? "+" : "") + str.tostring(rMult, "#.#") + "R", alert.freq_once_per_bar)
        inTrade := false
        lastExit := bar_index

// -------------------------------------------------- alertcondition (كاملة)
acCall = fDir > 0
acPut  = fDir < 0
alertcondition(acCall,  "CALL Entry",  "CALL entry signal")
alertcondition(acPut,   "PUT Entry",   "PUT entry signal")
alertcondition(slHit,   "Stop Loss Hit", "Stop loss hit")
alertcondition(tpHit1,  "TP1 Hit", "Target 1 hit")
alertcondition(tpHit2,  "TP2 Hit", "Target 2 hit")
alertcondition(tpHit3,  "TP3 Hit", "Target 3 hit")
alertcondition(tpHit4,  "TP4 Hit", "Target 4 hit")

// ------------------------------------------------------ العقد المقترح
f_step(p) => p < 50 ? 0.5 : p < 200 ? 1.0 : p < 500 ? 2.5 : 5.0
isFund = syminfo.ticker == "QQQ" or syminfo.ticker == "SPY" or syminfo.ticker == "SPX"
liveDir = inTrade ? tDir : qUp >= qDn ? 1 : -1
optBase = inTrade ? entryP : close
optStep = f_step(optBase)
optStrk = liveDir > 0 ? math.ceil(optBase / optStep) * optStep : math.floor(optBase / optStep) * optStep
f_optPct(tgt) => optBase > 0 and not na(tgt) ? math.abs(tgt - optBase) / optBase * 100.0 * optLev : na
oP1 = f_optPct(inTrade ? tp1 : (liveDir > 0 ? close + tp1x * atr : close - tp1x * atr))
oP2 = f_optPct(inTrade ? tp2 : (liveDir > 0 ? close + tp2x * atr : close - tp2x * atr))
oP3 = f_optPct(inTrade ? tp3 : (liveDir > 0 ? close + tp3x * atr : close - tp3x * atr))
oP4 = f_optPct(inTrade ? tp4 : (liveDir > 0 ? close + tp4x * atr : close - tp4x * atr))
f_pct(p) => na(p) ? "—" : "+" + str.tostring(p, "#") + "%"

// ------------------------------------------------------------------ اللوحة
f_pos(s) => s == "أعلى يمين" ? position.top_right : s == "أعلى يسار" ? position.top_left :
     s == "أسفل يمين" ? position.bottom_right : position.bottom_left
f_tfCell(d) => d > 0 ? "▲" : d < 0 ? "▼" : "•"
f_tfCol(d) => d > 0 ? cUp : d < 0 ? cDn : cMut

// اسم الفريم بالعربي — يُستعمل في اللوحة وفي شاشة المراقبة
f_tfName(t) => t == "D" ? "يومي" : t == "W" ? "أسبوعي" : t == "1" ? "1د" : t == "3" ? "3د" :
     t == "5" ? "5د" : t == "15" ? "15د" : t == "30" ? "30د" : t == "60" ? "1س" :
     t == "120" ? "2س" : t == "240" ? "4س" : t
// شريط جودة مرئي بدل رقم جاف
f_bar(v) =>
    n = math.round(v / 20.0)
    s = ""
    for i = 1 to 5
        s := s + (i <= n ? "▮" : "▯")
    s
// اسم الرمز بلا اسم السوق: NASDAQ:AAPL تصير AAPL
f_short(s) => str.contains(s, ":") ? array.get(str.split(s, ":"), 1) : s

// لوحة واحدة، سطران في كل صف، وكل سطر يجيب على سؤال واحد
var table dash = table.new(f_pos(dashPosS), 2, 10, bgcolor=cPanl, border_width=1, border_color=color.new(#2A3245, 0))
if barstate.islast
    q = math.max(qUp, qDn)
    qCol = q >= 80 ? cUp : q >= 60 ? cYel : cDn
    sCol = inTrade ? (tDir > 0 ? cUp : cDn) : pDir != 0 ? cYel : liveDir > 0 ? cUp : cDn
    // السطر الوحيد الذي يجب أن يقرأه المتداول: ماذا أفعل الآن؟
    blockedByGate = qualityMode and (lead > 0 ? not qGateUp : not qGateDn)
    action = inTrade ? (h2 ? "💰 مؤمّنة — احجز جزءاً ودع الباقي يجري" : h1 ? "🏃 تجري خلف الوقف — لا تستعجل" : "✊ امسك — خسارتك محدودة بـ 1R") :
         pDir != 0 ? "⏳ ضع أمر " + f_side(pDir) + " عند " + str.tostring(pLimit, format.mintick) + " — ولا تطارد" :
         (bar_index - lastExit) <= coolEff ? "😴 راحة بعد الصفقة السابقة" :
         leadScore < minQeff ? "⏸ انتظر — ينقص: " + f_miss(lead > 0) :
         blockedByGate ? "⏸ انتظر — سوق بلا قوة اتجاه (ADX " + str.tostring(adx, "#") + ")" :
         (lead > 0 ? not trigUp : not trigDn) ? "👀 جاهز — بانتظار الشرارة" : "⚡ ادخل الآن"
    actCol = inTrade ? cUp : pDir != 0 ? cYel : action == "⚡ ادخل الآن" ? cUp : cMut
    stateTxt = inTrade ? "صفقة " + f_side(tDir) + " قائمة" : pDir != 0 ? "أمر " + f_side(pDir) + " معلق" : "ميل السوق " + (liveDir > 0 ? "كول" : "بوت")
    // ١ العنوان
    table.cell(dash, 0, 0, "مرصاد VIP", text_color=cGold, bgcolor=cHead, text_size=size.normal)
    table.cell(dash, 1, 0, syminfo.ticker + " · " + f_tfName(timeframe.period), text_color=cTxt, bgcolor=cHead, text_size=size.normal)
    // ٢ الحالة الآن
    table.cell(dash, 0, 1, "الحالة", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 1, stateTxt, text_color=#0B0E13, bgcolor=sCol, text_size=size.normal)
    // ٣ ماذا أفعل
    table.cell(dash, 0, 2, "ماذا أفعل؟", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 2, action, text_color=actCol, text_size=size.normal)
    // ٤ الجودة
    table.cell(dash, 0, 3, "قوة الفرصة", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 3, f_bar(q) + "  " + str.tostring(q) + "/100", text_color=qCol, text_size=size.small)
    // ٥ العقد
    table.cell(dash, 0, 4, "العقد", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 4, syminfo.ticker + " " + str.tostring(optStrk, format.mintick) + (liveDir > 0 ? "C" : "P") + " · " + (isFund ? "اليوم" : "جمعة الأسبوع"), text_color=sCol, text_size=size.small)
    // ٦ الأهداف
    table.cell(dash, 0, 5, "الأهداف", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 5, (h1 ? "✅" : "①") + f_pct(oP1) + "  " + (h2 ? "✅" : "②") + f_pct(oP2) + "  " + (h3 ? "✅" : "③") + f_pct(oP3) + "  " + (h4 ? "✅" : "④") + f_pct(oP4), text_color=cGold, text_size=size.small)
    // ٧ الدخول والوقف
    table.cell(dash, 0, 6, "دخول ← وقف", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 6, inTrade ? str.tostring(entryP, format.mintick) + "  ←  " + str.tostring(stopP, format.mintick) : "—", text_color=inTrade ? #FF9E45 : cMut, text_size=size.small)
    // ٨ الفريمات
    table.cell(dash, 0, 7, "الفريمات", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 7, "1د" + f_tfCell(d01) + " 3د" + f_tfCell(d03) + " 5د" + f_tfCell(d05) + " 15د" + f_tfCell(d15) + " 1س" + f_tfCell(d60), text_color=bias > 0 ? cUp : bias < 0 ? cDn : cMut, text_size=size.small)
    // ٩ السوق
    mktTxt = rsi >= 70 ? "تشبع شرائي ⚠" : rsi <= 30 ? "تشبع بيعي ⚠" : absorption ? "امتصاص مؤسسي" :
         inCloud ? "داخل السحابة — غير واضح" : cloudDir > 0 ? "زخم صاعد" : "زخم هابط"
    mktCol = rsi >= 70 or rsi <= 30 ? cDn : absorption ? cCyan : inCloud ? cYel : cloudDir > 0 ? cUp : cDn
    zoneTxt = inFib ? " · فيبو ذهبية" : nearSup ? " · على الدعم" : nearRes ? " · على المقاومة" : ""
    table.cell(dash, 0, 8, "السوق", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 8, mktTxt + zoneTxt, text_color=mktCol, text_size=size.small)
    // ١٠ عداد اليوم
    table.cell(dash, 0, 9, "اليوم", text_color=cMut, text_size=size.small)
    table.cell(dash, 1, 9, "دخل " + str.tostring(tradesToday) + " · ألغي " + str.tostring(missedToday) + " · " + aggro, text_color=cTxt, text_size=size.small)

// ------------------------------------------------------- شاشة المراقبة
// خمسة أسماء أخرى، كل واحد بالفريم الذي تختاره له، وأنت ثابت على شارتك.
// تُقرأ بنفس منطق المحرك: ميل السحابة + قوة الاتجاه + الحجم + القرب من
// منطقة الارتداد — فتعرف أيها "تحت المراقبة" وأيها صار "كول/بوت جاهز".
f_scan() =>
    a  = ta.atr(14)
    cf = ta.hma(close, cloudFastLen)
    cs = ta.ema(close, cloudSlowLen)
    e9 = ta.ema(close, 9)
    inC = close <= math.max(cf, cs) and close >= math.min(cf, cs)
    cd  = cf > cs ? 1 : -1
    [dp, dm, ax] = ta.dmi(14, 14)
    hv = not na(volume) and ta.sma(volume, 20) > 0
    vs = hv ? volume > volX * ta.sma(volume, 20) : math.abs(close - open) > 0.7 * a
    up = cd > 0 and close > cs
    dn = cd < 0 and close < cs
    d  = up ? 1 : dn ? -1 : 0
    near = math.abs(close - math.max(cf, e9)) < 0.5 * a or math.abs(close - math.min(cf, e9)) < 0.5 * a
    sc = 0
    sc := sc + (d != 0 ? 25 : 0)
    sc := sc + (ax >= adxMin ? 25 : 0)
    sc := sc + (vs ? 25 : 0)
    sc := sc + (not inC ? 25 : 0)
    [d, sc, close, a, near, inC]

[s1d, s1q, s1p, s1a, s1n, s1c] = request.security(w1s, w1t, f_scan(), lookahead=barmerge.lookahead_off)
[s2d, s2q, s2p, s2a, s2n, s2c] = request.security(w2s, w2t, f_scan(), lookahead=barmerge.lookahead_off)
[s3d, s3q, s3p, s3a, s3n, s3c] = request.security(w3s, w3t, f_scan(), lookahead=barmerge.lookahead_off)
[s4d, s4q, s4p, s4a, s4n, s4c] = request.security(w4s, w4t, f_scan(), lookahead=barmerge.lookahead_off)
[s5d, s5q, s5p, s5a, s5n, s5c] = request.security(w5s, w5t, f_scan(), lookahead=barmerge.lookahead_off)

f_wState(d, q, near, inC) => d == 0 ? "خارج اللعب" : inC ? "👁 تحت المراقبة" :
     q >= 75 and near ? (d > 0 ? "⚡ كول جاهز" : "⚡ بوت جاهز") :
     q >= 75 ? (d > 0 ? "▲ صاعد قوي" : "▼ هابط قوي") : (d > 0 ? "▲ صاعد" : "▼ هابط")
f_wCol(d, q, inC) => d == 0 ? cMut : inC ? cYel : q >= 75 ? (d > 0 ? cUp : cDn) : color.new(d > 0 ? cUp : cDn, 35)

var table wt = table.new(f_pos(wPosS), 5, 6, bgcolor=cPanl, border_width=1, border_color=color.new(#2A3245, 0))
f_wRow(r, sym, tf, d, q, p, a, near, inC) =>
    table.cell(wt, 0, r, f_short(sym), text_color=cTxt, text_size=size.small)
    table.cell(wt, 1, r, f_tfName(tf), text_color=cMut, text_size=size.small)
    table.cell(wt, 2, r, f_wState(d, q, near, inC), text_color=f_wCol(d, q, inC), text_size=size.small)
    table.cell(wt, 3, r, f_bar(q), text_color=q >= 75 ? cUp : q >= 50 ? cYel : cMut, text_size=size.small)
    table.cell(wt, 4, r, d == 0 ? "—" : f_short(sym) + " " + str.tostring(d > 0 ? math.ceil(p / f_step(p)) * f_step(p) : math.floor(p / f_step(p)) * f_step(p), format.mintick) + (d > 0 ? "C" : "P"), text_color=d == 0 ? cMut : d > 0 ? cUp : cDn, text_size=size.small)

if barstate.islast and showWatch
    table.cell(wt, 0, 0, "الاسم", text_color=cGold, bgcolor=cHead, text_size=size.small)
    table.cell(wt, 1, 0, "الفريم", text_color=cGold, bgcolor=cHead, text_size=size.small)
    table.cell(wt, 2, 0, "الحالة", text_color=cGold, bgcolor=cHead, text_size=size.small)
    table.cell(wt, 3, 0, "القوة", text_color=cGold, bgcolor=cHead, text_size=size.small)
    table.cell(wt, 4, 0, "العقد", text_color=cGold, bgcolor=cHead, text_size=size.small)
    f_wRow(1, w1s, w1t, s1d, s1q, s1p, s1a, s1n, s1c)
    f_wRow(2, w2s, w2t, s2d, s2q, s2p, s2a, s2n, s2c)
    f_wRow(3, w3s, w3t, s3d, s3q, s3p, s3a, s3n, s3c)
    f_wRow(4, w4s, w4t, s4d, s4q, s4p, s4a, s4n, s4c)
    f_wRow(5, w5s, w5t, s5d, s5q, s5p, s5a, s5n, s5c)

// -------------------------------------------------- جدول الاختبار الحي
// أداء المحرك على هذا الشارت. الأرقام كلها صافية بعد تكلفة العقد.
// ثلاثة أسطر تُقال هنا ولا تُقال في لوحات غيرنا: المحصلة الكلية بالـ R،
// وأطول سلسلة خسائر متتالية، وحجم ما أكلته تكلفة العقد من المتوسط الخام.
// وحين تكون العينة أصغر من ثلاثين صفقة يُقال ذلك صراحة بدل تركها تُقرأ
// كأنها حقيقة مستقرة.
var table bt = table.new(f_pos(btPosS), 2, 11, bgcolor=cPanl, border_width=1, border_color=color.new(#2A3245, 0))
f_wrCol(v) => v >= 60 ? cUp : v >= 45 ? cYel : cDn
if barstate.islast
    btWr  = btTot > 0 ? 100.0 * btWin / btTot : 0.0
    btCwr = btCallTot > 0 ? 100.0 * btCallWin / btCallTot : 0.0
    btPwr = btPutTot  > 0 ? 100.0 * btPutWin  / btPutTot  : 0.0
    btPf  = btLoss > 0 ? btGross / btLoss : (btGross > 0 ? 99.0 : 0.0)
    totAll = winsAll + lossAll
    table.cell(bt, 0, 0, "الاختبار الحي", text_color=cGold, bgcolor=cHead, text_size=size.small)
    table.cell(bt, 1, 0, "آخر " + str.tostring(btDays) + " يوم", text_color=cTxt, bgcolor=cHead, text_size=size.small)
    table.cell(bt, 0, 1, "عدد الصفقات", text_color=cMut, text_size=size.small)
    table.cell(bt, 1, 1, str.tostring(btTot) + (btTot < 30 ? "  عينة صغيرة ⚠" : ""),
         text_color=btTot < 30 ? cYel : cTxt, text_size=size.small)
    table.cell(bt, 0, 2, "نسبة النجاح", text_color=cMut, text_size=size.small)
    table.cell(bt, 1, 2, btTot > 0 ? str.tostring(btWr, "#.#") + "%" : "—", text_color=f_wrCol(btWr), text_size=size.small)
    table.cell(bt, 0, 3, "نجاح الكول", text_color=cMut, text_size=size.small)
    table.cell(bt, 1, 3, btCallTot > 0 ? str.tostring(btCwr, "#") + "% (" + str.tostring(btCallTot) + ")" : "—", text_color=f_wrCol(btCwr), text_size=size.small)
    table.cell(bt, 0, 4, "نجاح البوت", text_color=cMut, text_size=size.small)
    table.cell(bt, 1, 4, btPutTot > 0 ? str.tostring(btPwr, "#") + "% (" + str.tostring(btPutTot) + ")" : "—", text_color=f_wrCol(btPwr), text_size=size.small)
    // عامل ربح مبني على أقل من ثلاثين صفقة رقم لا يُبنى عليه قرار
    table.cell(bt, 0, 5, "عامل الربح", text_color=cMut, text_size=size.small)
    table.cell(bt, 1, 5, btTot == 0 ? "—" : btTot < 30 ? str.tostring(btPf, "#.##") + " (لا يُعتمد)" : str.tostring(btPf, "#.##"),
         text_color=btTot < 30 ? cMut : btPf >= 1.5 ? cUp : btPf >= 1.0 ? cYel : cDn, text_size=size.small)
    avgGross = totAll > 0 ? sumR / totAll : 0.0
    avgNet   = totAll > 0 ? sumRnet / totAll : 0.0
    table.cell(bt, 0, 6, "متوسط خام", text_color=cMut, text_size=size.small)
    table.cell(bt, 1, 6, totAll > 0 ? (avgGross >= 0 ? "+" : "") + str.tostring(avgGross, "#.##") + "R" : "—", text_color=cMut, text_size=size.small)
    // الرقم الذي يقرر: المتوسط بعد أن يأخذ فرق سعر العقد نصيبه
    table.cell(bt, 0, 7, "متوسط بعد التكلفة", text_color=cTxt, text_size=size.small)
    table.cell(bt, 1, 7, totAll > 0 ? (avgNet >= 0 ? "+" : "") + str.tostring(avgNet, "#.##") + "R" : "—",
         text_color=avgNet > 0 ? cUp : cDn, bgcolor=color.new(avgNet > 0 ? cUp : cDn, 85), text_size=size.normal)
    table.cell(bt, 0, 8, "المحصلة الكلية", text_color=cMut, text_size=size.small)
    table.cell(bt, 1, 8, totAll > 0 ? (sumRnet >= 0 ? "+" : "") + str.tostring(sumRnet, "#.#") + "R (" + str.tostring(totAll) + " صفقة)" : "—",
         text_color=sumRnet > 0 ? cUp : cDn, text_size=size.small)
    // ما يكسر المتداول ليس المتوسط بل أطول صف خسائر يمر به وهو صابر
    table.cell(bt, 0, 9, "أطول سلسلة خسائر", text_color=cMut, text_size=size.small)
    table.cell(bt, 1, 9, totAll > 0 ? str.tostring(maxLossRun) + " متتالية" : "—",
         text_color=maxLossRun >= 8 ? cDn : maxLossRun >= 5 ? cYel : cTxt, text_size=size.small)
    // كم أمراً معلقاً نُفّذ فعلاً مقابل ما أُلغي — يضبط عمق الارتداد المطلوب
    fillRate = (totAll + missedCnt) > 0 ? 100.0 * totAll / (totAll + missedCnt) : 0.0
    table.cell(bt, 0, 10, "نُفّذ / ألغي", text_color=cMut, text_size=size.small)
    table.cell(bt, 1, 10, str.tostring(totAll) + " / " + str.tostring(missedCnt) + " · " + str.tostring(fillRate, "#") + "%", text_color=fillRate >= 40 ? cUp : fillRate >= 20 ? cYel : cDn, text_size=size.small)
