// ══════════════════════════════════════════════════════════════════════════
//  مِرصاد ٧ — نسخة الاختبار  ·  MIRSAD 7 TEST
//  نفس المؤشر حرفياً، وأوامره تُمرَّر إلى Strategy Tester ليحسب النتائج.
//
//  ثلاث حالات، بُنيت من شرح صاحبها على الشارت لا من كتاب:
//
//    الشمع الخضر/الحمر  "شمعتان حمراوان ثم كسر — ثلاث شموع سلبية = بوت".
//                       والعكس كول. الشمعة الكاسرة إشارة، والتي بعدها دخول.
//                       لا شرط قوة ولا متوسطات — ذاك كان يحجب البوت في وجه نزول
//                       أربع نقاط.
//    كسر التجميع        بعد كل حركة تجميع: مستطيل أو مثلث أو فوضى. يُرسم،
//                       ولا يُكسر قبل أن ينضج. كسره بشمعة واحدة إن كانت قوية
//                       ومع ميل الصندوق، وبشمعتين إن كانت ضعيفة أو ضد الميل.
//                       ولا دخول داخله أبداً.
//    قصور العزم         قمة لم تبلغ سابقتها ثم أول إغلاق تحت قاع الشمعة
//                       السابقة — بوت من أول شمعة. والعكس كول.
//
//  الوقف: تحت قاع الشمعة التي قبل الدخول، وأبعد قليلاً منه — لأن القاع
//  الظاهر هو حيث تقف الناس والسوق يصيدها. ثم يتبع الهيكل ولا يُنقل إلى الدخول.
//  الأهداف: من قوة الموجة، والوقف يمشي معها.
//
//  على الشارت للعميل: كول / بوت، الأهداف، الأحمر وقف، والصندوق. لا أدوات.
//  لا إعادة رسم: الإشارة تُختم على الإغلاق، والدخول على افتتاح التالية.
// ══════════════════════════════════════════════════════════════════════════
//@version=5
strategy("مِرصاد ٧ — اختبار", "MIRSAD 7 TEST", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 200, initial_capital = 100000, default_qty_type = strategy.fixed, default_qty_value = 100, commission_type = strategy.commission.percent, commission_value = 0.02, slippage = 1)

// ─────────────────────────────────────────────────────────── الإعدادات
gM = "الوضع"
dirIn   = input.string("الاتجاهان", "الاتجاه", options = ["الاتجاهان", "كول فقط", "بوت فقط"], group = gM)
withBig = input.bool(false, "مع الاتجاه الأكبر فقط (متوسط ٥٠)", group = gM)
nRun    = input.int(2, "شموع بلون واحد قبل شمعة الكسر (٢ = ثلاث شموع سلبية)", minval = 1, maxval = 4, group = gM)
kStrong = input.float(1.2, "كسر الصندوق بشمعة واحدة إن كان مداها ≥ × المتوسط", minval = 0.8, maxval = 2.5, step = 0.1, group = gM)
kClimax = input.float(2.5, "شمعة ضخمة (× المتوسط): لا دخول في طرفها", minval = 1.5, maxval = 5.0, step = 0.25, group = gM)

gC = "الحالات"
useGrn  = input.bool(true, "الشمع الخضر / الحمر", group = gC)
useBox  = input.bool(true, "كسر التجميع", group = gC)
useFail = input.bool(true, "قصور العزم", group = gC)
retest  = input.bool(false, "كسر التجميع: انتظر إعادة الاختبار", group = gC)
boxMin  = input.int(10, "الصندوق ينضج بعد N شمعة — لا كسر قبلها", minval = 5, maxval = 30, group = gC)

gS = "الوقف والأهداف"
trapX = input.float(0.25, "المصيدة: هامش تحت القاع (ATR)", minval = 0.0, maxval = 0.6, step = 0.05, group = gS)
minX  = input.float(1.00, "أدنى مسافة وقف (ATR) — الظل لا يضربك", minval = 0.2, maxval = 2.0, step = 0.1, group = gS)
coolN = input.int(6, "بعد وقف: شموع راحة قبل إشارة بنفس الاتجاه", minval = 0, maxval = 20, group = gS)
maxX  = input.float(3.00, "أقصى مسافة وقف (ATR)", minval = 1.0, maxval = 6.0, step = 0.25, group = gS)
w1 = input.float(0.5, "هدف ١ = × قوة الموجة", minval = 0.2, step = 0.1, group = gS)
w2 = input.float(1.0, "هدف ٢ = × قوة الموجة", minval = 0.5, step = 0.1, group = gS)
w3 = input.float(1.6, "هدف ٣ = × قوة الموجة", minval = 1.0, step = 0.1, group = gS)
trailN = input.int(3, "الوقف يتبع قاع/قمة آخر N شمعة", minval = 2, maxval = 15, group = gS)
adxGate = input.bool(true, "حجب إشارات الشموع في العرضي (ADX)", group = gS)
adxLvl  = input.float(18, "تحته عرضي", minval = 10, maxval = 30, group = gS)

gV = "العرض"
showLv = input.bool(true, "الوقف والأهداف", group = gV)
showBox = input.bool(true, "صندوق التجميع", group = gV)
showPnl = input.bool(true, "لوحة الصفقة", group = gV)

allowL = dirIn != "بوت فقط"
allowS = dirIn != "كول فقط"

// ═══════════════════════════ المطبخ — يُحسب هنا ولا يُذكر للعميل ═══════════
// كل شيء في دالة واحدة كي تعمل على الشارت وعلى رموز المراقبة بالمنطق نفسه.
f_core() =>
    a = ta.atr(14)
    rng = high - low
    rngAvg = ta.sma(rng, 20)
    e50 = ta.ema(close, 50)
    // الشمعة القوية — تُستخدم فقط لتقرير كسر الصندوق بشمعة أم بشمعتين
    strongUp = rng >= kStrong * rngAvg and close > open and (close - low) >= 0.75 * rng
    strongDn = rng >= kStrong * rngAvg and close < open and (high - close) >= 0.75 * rng
    // الشمعة الضخمة: الدخول بعدها = الدخول في طرف الحركة. لا.
    climax = rng >= kClimax * rngAvg
    // القمم والقيعان — للميل وقصور العزم، تبقى في المطبخ
    phv = ta.pivothigh(high, 3, 3)
    plv = ta.pivotlow(low, 3, 3)
    var float ph1 = na
    var float ph2 = na
    var float pl1 = na
    var float pl2 = na
    var int ph1b = 0
    var int pl1b = 0
    if not na(phv)
        ph2 := ph1
        ph1 := phv
        ph1b := bar_index - 3
    if not na(plv)
        pl2 := pl1
        pl1 := plv
        pl1b := bar_index - 3
    // التجميع: عشر شموع ضيّقة فعلاً — مداها كله لا يتجاوز ATR مضاعفة — مع انضغاط
    // البولنجر. يُعلن الصندوق ناضجاً بحوافه من أول لحظة، فلا يتوسّع على نزول
    // ويبتلعه كما فعل. وبعد انتهائه فترة راحة كي لا يولد صندوق فوق صندوق.
    bbB = ta.sma(close, 20)
    bbD = 2.0 * ta.stdev(close, 20)
    bbW = bbB > 0 ? 2.0 * bbD / bbB : 0.0
    bbAvg = ta.sma(bbW, 100)
    // يُقاس على الإغلاقات: ظل واحد كان يكسر الشرط عشر شموع ويمنع الصندوق.
    // الحواف = الإغلاقات مع هامش صغير؛ ما يطلع من الظلال خارجها هو الزنبرك والدفعة.
    spanHi = ta.highest(close, boxMin) + 0.25 * a
    spanLo = ta.lowest(close, boxMin) - 0.25 * a
    tight = (ta.highest(close, boxMin) - ta.lowest(close, boxMin)) <= 2.0 * a
    [dip, dim, adx] = ta.dmi(14, 14)
    sideways = adxGate and adx < adxLvl
    var bool inBox = false
    var float bxHi = na
    var float bxLo = na
    var int bxAge = 0
    var int bxStart = 0
    var int cool = 0
    var int upCnt = 0
    var int dnCnt = 0
    var bool brokeUp = false
    var bool brokeDn = false
    var int inside = 0
    cool := math.max(cool - 1, 0)
    if not inBox and cool == 0 and tight
        inBox := true
        bxHi := spanHi
        bxLo := spanLo
        bxAge := boxMin
        bxStart := bar_index - boxMin + 1
        upCnt := 0
        dnCnt := 0
        inside := 0
        brokeUp := false
        brokeDn := false
    else if inBox
        bxAge += 1
        margin = 0.30 * a
        outUp = close > bxHi + margin
        outDn = close < bxLo - margin
        if not outUp and not outDn
            bxHi := math.max(bxHi, close + 0.25 * a)
            bxLo := math.min(bxLo, close - 0.25 * a)
            inside += 1
        else
            inside := 0
        upCnt := outUp ? upCnt + 1 : 0
        dnCnt := outDn ? dnCnt + 1 : 0
        // كسر فشل ورجع داخل ثلاث شموع: الصندوق مستمر، والقفل يُفتح لكسر قادم
        if inside >= 3
            brokeUp := false
            brokeDn := false
    // الميل داخل الصندوق: قيعان ترتفع = ضغط للأعلى، قمم تنخفض = ضغط للأسفل
    leanUp = inBox and not na(pl1) and not na(pl2) and pl1b >= bxStart and pl1 > pl2
    leanDn = inBox and not na(ph1) and not na(ph2) and ph1b >= bxStart and ph1 < ph2
    boxOk = inBox and bxAge >= boxMin
    // الكسر: شمعة واحدة إن كانت قوية ومع الميل، وإلا شمعتان
    needUp = (strongUp and not leanDn) ? 1 : 2
    needDn = (strongDn and not leanUp) ? 1 : 2
    var bool waitUp = false
    var bool waitDn = false
    boxL = useBox and boxOk and not retest and not climax and upCnt >= needUp and not brokeUp
    boxS = useBox and boxOk and not retest and not climax and dnCnt >= needDn and not brokeDn
    // إعادة الاختبار: بعد الكسر يعود يلمس الحافة ويثبت فوقها.
    // تُفرض تلقائياً حين تكون شمعة الكسر ضخمة — فلا ندخل في قمتها.
    rtL = useBox and boxOk and (retest or waitUp) and brokeUp and low <= bxHi and close > bxHi and close > open
    rtS = useBox and boxOk and (retest or waitDn) and brokeDn and high >= bxLo and close < bxLo and close < open
    if inBox and upCnt >= needUp and not brokeUp
        brokeUp := true
        waitUp := climax
    if inBox and dnCnt >= needDn and not brokeDn
        brokeDn := true
        waitDn := climax
    if rtL
        waitUp := false
    if rtS
        waitDn := false
    // الشمع الخضر / الحمر — "شمعة صاعدة والتي بعدها دخول". بأي حجم.
    // الشرط الوحيد: أن تكون أول شمعة صاعدة بعد هبوط — تُغلق فوق قمة التي قبلها
    // وقد سبقها تراجع — لا شمعة في وسط صعود قائم، ولا شمعة ضخمة ندخل في قمتها.
    dirL = not withBig or close > e50
    dirS = not withBig or close < e50
    // "شمعتان حمراوان ثم كسر — ثلاث شموع سلبية = بوت". وعكسها كول.
    // والشمعة التي قبل الحمراوين خضراء: أي أن الثلاث انعكاسٌ من قمة، لا الشموع
    // الرابعة والخامسة والسادسة من نزول ممتد — ذاك يُدخلك في القاع.
    runUp = close[nRun + 1] < open[nRun + 1]
    runDn = close[nRun + 1] > open[nRun + 1]
    for k = 1 to nRun
        runUp := runUp and close[k] > open[k]
        runDn := runDn and close[k] < open[k]
    // كاشف ثانٍ مستقل للعرضي: لو قال "عرضي" تُحجب الشموع حتى بلا صندوق مرسوم
    grnL = useGrn and not inBox and not sideways and dirL and not climax and runUp and close > open and close > ta.highest(high, nRun)[1]
    redS = useGrn and not inBox and not sideways and dirS and not climax and runDn and close < open and close < ta.lowest(low, nRun)[1]
    // قصور العزم: قمة أدنى ثم أول إغلاق تحت قاع الشمعة السابقة
    // فشل حقيقي (ربع ATR على الأقل)، ومع الاتجاه الأكبر — لا بيع داخل صعود قائم
    failS = useFail and not inBox and dirS and not na(ph1) and not na(ph2) and ph1 < ph2 - 0.25 * a and bar_index - ph1b <= 6 and close < low[1] and close < open
    failL = useFail and not inBox and dirL and not na(pl1) and not na(pl2) and pl1 > pl2 + 0.25 * a and bar_index - pl1b <= 6 and close > high[1] and close > open
    // شمعة افتتاح الجلسة فجوة لا حركة — إشارتها تدخلك في قمتها بوقف بعيد
    firstBar = session.isfirstbar_regular
    // لا إشارة قبل أن تكتمل الحسابات — وإلا دخلنا من أول شمعة في التاريخ بوقف
    // غير محسوب (NaN) لا يُضرب أبداً، وبقيت الصفقة مفتوحة شهراً تحجب كل ما بعدها
    ready = bar_index >= 120 and not na(a) and not na(rngAvg) and not na(bbAvg) and not na(e50)
    sigL = ready and allowL and not firstBar and (grnL or boxL or rtL or failL)
    sigS = ready and allowS and not firstBar and (redS or boxS or rtS or failS)
    why = grnL ? "شمعة صاعدة" : boxL or rtL ? "كسر التجميع" : failL ? "قصور العزم" : redS ? "شمعة هابطة" : boxS or rtS ? "كسر التجميع" : failS ? "قصور العزم" : ""
    // قوة الموجة: مدى آخر ٢٠ شمعة — الأهداف تُقاس عليها
    // قوة الموجة = الاندفاعة التي صنعت الإشارة (من قاع آخر ١٠ شموع إلى الإغلاق)،
    // لا مدى عشرين شمعة — ذاك أعطى أهدافاً لا تُبلغ فلا يُؤمَّن شيء
    legUp = close - ta.lowest(low, 10)
    legDn = ta.highest(high, 10) - close
    wave = math.max(sigL ? legUp : sigS ? legDn : math.max(legUp, legDn), 1.5 * a)
    lean = leanUp ? 1 : leanDn ? -1 : sideways ? 9 : 0
    // الصندوق ينتهي لحظة كسره، أو حين يهجره السعر بعيداً، أو حين يشيخ —
    // فلا يبقى شبحاً يحجب الدخول ويُرسم ساعات بعد أن مات
    ibRet = inBox
    // لا ينتهي على الإشارة — كثير من الكسور ترجع، فيصير الصندوق نفسه صندوقاً جديداً
    // وتُؤخذ صفقة "داخل الصندوق". ينتهي حين يبتعد السعر عنه ATR كاملة.
    abandoned = inBox and (close > bxHi + 1.0 * a or close < bxLo - 1.0 * a) and (close[1] > bxHi + 0.5 * a or close[1] < bxLo - 0.5 * a)
    if boxL or boxS or rtL or rtS or abandoned or bxAge > 80
        inBox := false
        cool := boxMin
    [sigL, sigS, why, ibRet, bxHi, bxLo, bxStart, lean, wave, a]

// ═══════════════════════════ إدارة الصفقة ═════════════════════════════
// الدخول على افتتاح الشمعة التالية للإشارة. الوقف تحت قاع شمعة الإشارة
// (وهي الشمعة التي قبل الدخول) ناقص المصيدة. التأمين عند أول إغلاق فوق
// قمتها. ثم الوقف يتبع قاع آخر شموع ولا ينزل.
f_trade(bool sigL, bool sigS, string why, float wave, float a) =>
    var int pos = 0
    var int pend = 0
    var string pwhy = ""
    var float eP = na
    var float sP = na
    var float sigHi = na
    var float sigLo = na
    var float t1 = na
    var float t2 = na
    var float t3 = na
    var int hit = 0
    var bool secured = false
    var int barsIn = 0
    var string exitTxt = ""
    var float lastR = na
    var float unit = na
    var int coolL = 0
    var int coolS = 0
    closed = false
    if pend != 0 and pos == 0 and not na(a[1]) and not na(wave[1])
        pos := pend
        eP := open
        sigHi := high[1]
        sigLo := low[1]
        rawS = pos == 1 ? sigLo - trapX * a[1] : sigHi + trapX * a[1]
        d = math.abs(eP - rawS)
        d := math.min(math.max(d, minX * a[1]), maxX * a[1])
        unit := d
        sP := pos == 1 ? eP - d : eP + d
        wv = wave[1]
        // هدف ١ لا يقل عن +1R، وإلا كان الوقف أبعد من الهدف
        t1 := pos == 1 ? eP + math.max(w1 * wv, d) : eP - math.max(w1 * wv, d)
        t2 := pos == 1 ? eP + math.max(w2 * wv, 2.0 * d) : eP - math.max(w2 * wv, 2.0 * d)
        t3 := pos == 1 ? eP + math.max(w3 * wv, 3.0 * d) : eP - math.max(w3 * wv, 3.0 * d)
        hit := 0
        secured := false
        barsIn := 0
        exitTxt := ""
        pend := 0
    else if pend != 0 and pos == 0
        pend := 0
    if pos != 0
        barsIn += 1
        hitStop = pos == 1 ? low <= sP : high >= sP
        if hitStop
            lastR := (sP - eP) / unit * pos
            exitTxt := (sP - eP) * pos > 0 ? "خروج بربح" : (sP - eP) * pos == 0 ? "خروج على التعادل" : "وقف"
            // بعد وقف خاسر: راحة قبل إشارة بنفس الاتجاه — لا خمس بوتات في نطاق واحد
            if not secured
                if pos == 1
                    coolL := bar_index + coolN
                else
                    coolS := bar_index + coolN
            pos := 0
            closed := true
        else
            if pos == 1
                hit := high >= t3 ? 3 : high >= t2 ? 2 : high >= t1 ? 1 : hit
            else
                hit := low <= t3 ? 3 : low <= t2 ? 2 : low <= t1 ? 1 : hit
            if hit >= 3
                lastR := (t3 - eP) / unit * pos
                exitTxt := "هدف ٣"
                pos := 0
                closed := true
            else
                // الوقف يتبع الهيكل فقط: أدنى قاع (أعلى قمة) لآخر شموع. لا يُنقل إلى
                // سعر الدخول أبداً — سعر الدخول ليس مستوى في الشارت، والنقل إليه كان
                // يُخرج صفقة عند +1.5R بصفر على ظل واحد ثم تمضي بدوننا.
                if barsIn >= 2
                    tl = ta.lowest(low, trailN) - trapX * a
                    th = ta.highest(high, trailN) + trapX * a
                    sP := pos == 1 ? math.max(sP, tl) : math.min(sP, th)
                    // تأمين الأهداف: كل هدف يُلمس يصير الوقف عند الذي قبله
                    if hit >= 2
                        sP := pos == 1 ? math.max(sP, t1) : math.min(sP, t1)
                // "مؤمَّنة" = الوقف صار عند الدخول أو أفضل — بالهيكل، لا بالقرار
                secured := pos == 1 ? sP >= eP : sP <= eP
    if barstate.isconfirmed and pos == 0 and pend == 0 and not closed
        if sigL and bar_index >= coolL
            pend := 1
            pwhy := why
        else if sigS and bar_index >= coolS
            pend := -1
            pwhy := why
    [pos, pend, pwhy, eP, sP, t1, t2, t3, hit, secured, barsIn, closed, exitTxt, lastR]

// ═══════════════════════════ الشارت والأوامر ══════════════════════════
[sigL, sigS, why, inBox, bxHi, bxLo, bxStart, lean, wave, atrv] = f_core()
[pos, pend, pwhy, eP, sP, t1, t2, t3, hit, secured, barsIn, closed, exitTxt, lastR] = f_trade(sigL, sigS, why, wave, atrv)

cUp = #0E9F6E
cDn = #E02424

// الأوامر — تطابق إدارة المؤشر تماماً:
//   الإشارة تُختم على الإغلاق، فيدخل الاختبار على افتتاح الشمعة التالية
//   الوقف والهدف الثالث يُحدَّثان كل شمعة كما يتحرّكان في المؤشر
if barstate.isconfirmed and pend == 1
    strategy.entry("كول", strategy.long)
if barstate.isconfirmed and pend == -1
    strategy.entry("بوت", strategy.short)
if pos != 0 and strategy.position_size != 0
    strategy.exit("خروج", from_entry = pos == 1 ? "كول" : "بوت", stop = sP, limit = t3)
if pos == 0 and strategy.position_size != 0 and closed
    strategy.close_all()

if barstate.isconfirmed and pend == 1
    label.new(bar_index, low, "كول", style = label.style_label_up, color = color.new(cUp, 0), textcolor = color.white, size = size.small)
if barstate.isconfirmed and pend == -1
    label.new(bar_index, high, "بوت", style = label.style_label_down, color = color.new(cDn, 0), textcolor = color.white, size = size.small)

var box bx = na
if showBox
    if inBox and not inBox[1]
        bx := box.new(bxStart, bxHi, bar_index, bxLo, border_color = color.new(#B7791F, 40), bgcolor = color.new(#B7791F, 90))
    if inBox and not na(bx)
        box.set_right(bx, bar_index)
        box.set_top(bx, bxHi)
        box.set_bottom(bx, bxLo)

var line lnS = na
var line ln3 = na
inTr = pos != 0
if showLv and inTr and not inTr[1]
    lnS := line.new(bar_index, sP, bar_index + 1, sP, color = color.new(cDn, 10), width = 2)
    ln3 := line.new(bar_index, t3, bar_index + 1, t3, color = color.new(cUp, 10), width = 2)
if showLv and inTr and not na(lnS)
    line.set_y1(lnS, sP)
    line.set_xy2(lnS, bar_index + 1, sP)
    line.set_xy2(ln3, bar_index + 1, t3)

if closed
    label.new(bar_index, close, exitTxt + "  " + str.tostring(lastR, "#.##") + "R", style = label.style_label_left, size = size.small, color = color.new(lastR >= 0 ? cUp : cDn, 15), textcolor = color.white)

// ═══════════════════════════ لوحة الصدق — بالـR لا بالدولار ═══════════════
// الدولار يكذب لأنه يتبع حجم الصفقة. R وحدة الوقف: +2R يعني ربحت ضِعف ما خاطرت به.
var int nT = 0
var int nW = 0
var float sumR = 0.0
var float sumWin = 0.0
var float sumLoss = 0.0
if closed and not na(lastR)
    nT += 1
    sumR += lastR
    if lastR > 0
        nW += 1
        sumWin += lastR
    else
        sumLoss += -lastR
pf = sumLoss > 0 ? sumWin / sumLoss : (sumWin > 0 ? 99.0 : 0.0)
avgR = nT > 0 ? sumR / nT : 0.0
wr = nT > 0 ? 100.0 * nW / nT : 0.0
payoff = (nW > 0 and nT - nW > 0) ? (sumWin / nW) / (sumLoss / (nT - nW)) : 0.0
needWr = payoff > 0 ? 100.0 / (1 + payoff) : 100.0

var table pt = na
f_kv(int r, string k, string v, color c) =>
    table.cell(pt, 0, r, k, text_color = color.new(#9CA3AF, 0), bgcolor = color.new(#1F2937, 10), text_size = size.tiny)
    table.cell(pt, 1, r, v, text_color = c, bgcolor = color.new(#1F2937, 10), text_size = size.small)

if showPnl and barstate.islast
    if na(pt)
        pt := table.new(position.bottom_right, 2, 8, border_width = 1, border_color = color.new(#000000, 80), frame_width = 1, frame_color = color.new(#000000, 70))
    table.cell(pt, 0, 0, "مِرصاد ٧ — اختبار", text_color = color.white, bgcolor = color.new(#111827, 0), text_size = size.small)
    table.cell(pt, 1, 0, syminfo.ticker + " · " + timeframe.period, text_color = color.new(#D1D5DB, 0), bgcolor = color.new(#111827, 0), text_size = size.small)
    f_kv(1, "الصفقات", str.tostring(nT), color.new(#D1D5DB, 0))
    f_kv(2, "عامل الربح", str.tostring(pf, "#.##") + (nT < 30 ? "  (عينة صغيرة)" : ""), pf >= 1.2 ? color.new(#86EFAC, 0) : pf >= 1.0 ? color.new(#FCD34D, 0) : color.new(#FCA5A5, 0))
    f_kv(3, "متوسط الصفقة", (avgR >= 0 ? "+" : "") + str.tostring(avgR, "#.##") + "R", avgR >= 0 ? color.new(#86EFAC, 0) : color.new(#FCA5A5, 0))
    f_kv(4, "الصافي", (sumR >= 0 ? "+" : "") + str.tostring(sumR, "#.#") + "R", sumR >= 0 ? color.new(#86EFAC, 0) : color.new(#FCA5A5, 0))
    f_kv(5, "نسبة النجاح", str.tostring(wr, "#") + "%  مقابل  " + str.tostring(needWr, "#") + "% المطلوبة", wr >= needWr ? color.new(#86EFAC, 0) : color.new(#FCA5A5, 0))
    f_kv(6, "الرابحة ÷ الخاسرة", str.tostring(payoff, "#.##"), color.new(#D1D5DB, 0))
    f_kv(7, "الحالة الآن", pos == 1 ? "كول قائمة" : pos == -1 ? "بوت قائمة" : inBox ? "تجميع" : lean == 9 ? "عرضي" : "مراقبة", color.new(#D1D5DB, 0))
